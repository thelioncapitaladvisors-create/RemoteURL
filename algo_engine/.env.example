# ==============================================================================
# TLCS Black Box Signal Engine Daemon - Environment Variables
# ==============================================================================

# ── 1. SUPABASE DATABASE CONFIGURATION ─────────────────────────────────────────
# Service role key required for inserting/updating shadow_signals
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_KEY=your_supabase_service_role_or_anon_key

# ── 2. DHANHQ LIVE MARKET WEBSOCKET FEED (NSE / MCX) ──────────────────────────
# Required for live Indian equities & MCX Commodities tick streams
DHAN_CLIENT_ID=your_dhan_client_id
DHAN_ACCESS_TOKEN=your_dhan_24h_jwt_access_token

# ── 3. TELEGRAM CHANNEL DISPATCHER (MARKET-WISE ROUTING) ─────────────────────
# Telegram bot token used to send notifications
TELEGRAM_BOT_TOKEN=your_telegram_bot_token

# Dedicated Market Channels (per AGENTS.md market-wise routing mandate)
TELEGRAM_CHAT_ID_NIFTY=-100xxxxxxxxxx
TELEGRAM_CHAT_ID_MCX=-100xxxxxxxxxx
TELEGRAM_CHAT_ID_NYMEX=-100xxxxxxxxxx
TELEGRAM_CHAT_ID_CRYPTO=-100xxxxxxxxxx
TELEGRAM_CHAT_ID_FOREX=-100xxxxxxxxxx
TELEGRAM_CHAT_ID_WORLD=-100xxxxxxxxxx
# Fallback channel if specific market channel is not defined
TELEGRAM_CHAT_ID=-100xxxxxxxxxx

# ── 4. ENGINE OPERATIONAL CONTROLS ───────────────────────────────────────────
# PAPER_TRADING: True to log simulated fills, False to dispatch live broker orders
PAPER_TRADING=True

# MOCK_MODE: True for offline mock ticks, False for live real-time WebSocket feeds
MOCK_MODE=False

# ACTIVE_MARKETS: Comma-separated list or ALL (NIFTY,MCX,CRYPTO,NYMEX,FOREX,WORLD)
ACTIVE_MARKETS=ALL
