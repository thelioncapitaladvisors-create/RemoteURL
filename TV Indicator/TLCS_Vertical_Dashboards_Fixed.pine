f_daysinmonth(_year, _month) =>
    _m = _month < 1 ? 1 : _month > 12 ? 12 : _month
    28 + (_m == 2 and _year % 4 == 0 ? 1 : 0) + (_m + math.floor(_m / 8)) % 2 + 2 % _m + 2 * math.floor(1 / _m)
