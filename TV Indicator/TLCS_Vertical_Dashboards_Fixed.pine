for i = 1 to 15
    res = array.get(array.from(res01,res02,res03,res04,res05,res06,res07,res08,res09,res10,res11,res12,res13,res14,res15), i-1)
    sup = array.get(array.from(sup01,sup02,sup03,sup04,sup05,sup06,sup07,sup08,sup09,sup10,sup11,sup12,sup13,sup14,sup15), i-1)
    br_res = array.get(array.from(br_res01,br_res02,br_res03,br_res04,br_res05,br_res06,br_res07,br_res08,br_res09,br_res10,br_res11,br_res12,br_res13,br_res14,br_res15), i-1)
    br_sup = array.get(array.from(br_sup01,br_sup02,br_sup03,br_sup04,br_sup05,br_sup06,br_sup07,br_sup08,br_sup09,br_sup10,br_sup11,br_sup12,br_sup13,br_sup14,br_sup15), i-1)
    if open < res and close > res or open > res and close < res
        br_res := br_res + 1
        if br_res >= mb or math.abs(res - close) / close * 100 >= md
            res := na
    if open < sup and close > sup or open > sup and close < sup
        br_sup := br_sup + 1
        if br_sup >= mb or math.abs(sup - close) / close * 100 >= md
            sup := na

luc =  (emaStep3w < emaStep4w) or  (emaStep3 < emaStep4)
