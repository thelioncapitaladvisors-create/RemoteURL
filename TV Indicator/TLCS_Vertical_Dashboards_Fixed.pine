IsWeekend(_date) => dayofweek(_date) == 7 or dayofweek(_date) == 1
SkipWeekend(_date) =>
    _d = dayofweek(_date)
    _mul = _d == 6 ? 3 : _d == 7 ? 2 : 1
    _date + _mul * 86400000
GetNextWorkingDay(_date) =>
    _dt = SkipWeekend(_date)
    _dt
