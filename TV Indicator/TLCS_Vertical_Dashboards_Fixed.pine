ext_bullishDiv       = input.source(close, title="[OSC] Bullish Divergence")
ext_bullishHiddenDiv = input.source(close, title="[OSC] Bullish Hidden Div")
ext_bearishDiv       = input.source(close, title="[OSC] Bearish Divergence")
