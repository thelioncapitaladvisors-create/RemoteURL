float   countryTaxInput             = input.float(title = 'Country tax %', step = 5, defval = 15, group = 'TRADES')
bool    breakEvenEnabledInput       = input.bool(title = 'Break Even', defval = true, group = 'STOP_LOSS')
float   tp1ProfitRatioInput         = input.float(title = 'Profit %', step = 5, defval = 0, group = 'TAKE_PROFITS', inline = 'TP1')
float   tp2ProfitRatioInput         = input.float(title = 'Profit %', step = 5, defval = 0, group = 'TAKE_PROFITS', inline = 'TP2')
float   tp3ProfitRatioInput         = input.float(title = 'Profit %', step = 5, defval = 0, group = 'TAKE_PROFITS', inline = 'TP3')
float   tp4ProfitRatioInput         = input.float(title = 'Profit %', step = 5, defval = 0, group = 'TAKE_PROFITS', inline = 'TP4')
float _totalTPAlloc = tp1ProfitRatioInput + tp2ProfitRatioInput + tp3ProfitRatioInput + tp4ProfitRatioInput
float _tpScale      = _totalTPAlloc >= 100.0 ? 99.0 / _totalTPAlloc : 1.0
float tp1Ratio      = tp1ProfitRatioInput * _tpScale
float tp2Ratio      = tp2ProfitRatioInput * _tpScale
float tp3Ratio      = tp3ProfitRatioInput * _tpScale
float tp4Ratio      = tp4ProfitRatioInput * _tpScale
int     TrendLineEMA                = input.int(title = 'EMA Length', defval = 8, group = 'EMA')
int     Short_EMA                   = input.int(title = 'EMA Length', defval = 13, group = 'EMA')
int     Med_EMA                     = input.int(title = 'EMA Length', defval = 32, group = 'EMA')
int     Long_EMA                    = input.int(title = 'EMA Length', defval = 5, group = 'EMA')
bool    showPanelInput              = input.bool(defval = false, title = 'Show Panel', group = 'PANELS')
FPivot = (high + low + close) / 3
bool w = time('1') == time(timeframe.period)
float fShort_EMA = ta.ema(FPivot, Short_EMA)
float fMed_EMA = ta.ema(FPivot, Med_EMA)
float fLong_EMA = ta.ema(FPivot, Long_EMA)
float highestHigh = ta.highest(high, ta.barssince(w) + 1)
float lowestLow = ta.lowest(low, ta.barssince(w) + 1)
float trendLine = (highestHigh - lowestLow ) / 2 + lowestLow

var Settings settings = Settings.new(
firstTrade        = firstTradeInput,
analysisWindow    = analysisWindowInput,
highTrendLimit    = highTrendLimitInput,
lowTrendLimit     = lowTrendLimitInput,
initialCapital    = initialCapitalInput,
leverage          = leverageInput,
breakEvenEnabled  = breakEvenEnabledInput,
tp1ProfitRatio    = tp1Ratio,
tp2ProfitRatio    = tp2Ratio,
tp3ProfitRatio    = tp3Ratio,
tp4ProfitRatio    = tp4Ratio,
showTPSL          = showTPSLInput,
showForecast      = showForecastInput,
showPanel         = showPanelInput,
countryTax        = countryTaxInput,
exchangeMakerFees = exchangeMakerFeeInput,
exchangeTakerFees = exchangeTakerFeeInput
)

roundUp(number, decimals) =>
    factor = math.pow(10, decimals)
    math.ceil(number * factor) / factor
riskToReward(float entryLevel, float slLevel, float tpLevel, string tradeDirection) =>
    bool isLong = str.contains(str.upper(tradeDirection), 'LONG')
    float risk = math.abs(entryLevel - slLevel)
    float reward = isLong ? (tpLevel - entryLevel) : (entryLevel - tpLevel)
    risk > 0 ? (reward / risk) : 0.0
updateLine(line id, int startBar, float level) => 0
calculateProfit(Settings settings, TradeLogic trade, float entry, float exit, float leverage, bool isLong, float positionRatio, bool isMaker = false) =>
    profit = isLong ? ((exit - entry) / entry) * leverage * positionRatio : ((entry - exit) / entry) * leverage * positionRatio
    exchangeFeesRatio = isMaker ? settings.exchangeMakerFees : settings.exchangeTakerFees
    exitFeesRatio = exchangeFeesRatio * settings.leverage * (positionRatio / 100)
    profit -= exitFeesRatio
    settings.totalExchangeFees += exitFeesRatio * settings.initialCapital / 100
    profit

sendAlert(Settings settings, TradeLogic trade, string z1_zone, string dX, string mX, string d1_message) => 0
sendTrailingSLAlert(Settings settings, TradeLogic trade, string z1_zone, string dX, string mX, string d1_message) => 0

evaluateTradeProgress(Settings settings, TradeLogic trade, bool triggerTrail, float trailRange) =>
    float profit    = 0.0
    bool  justHitTP = false
    bool  isLong_   = str.contains(str.upper(trade.tradeDirection), 'LONG')
    if not trade.hasHitEntry and bar_index > trade.startBarIndex
        bool entryHit = isLong_ ? low <= trade.entryLevel : high >= trade.entryLevel
        if entryHit
            trade.startBarIndex := bar_index
            trade.hasHitEntry   := true
            trade.entryTime     := time
    if not trade.hasHitEntry and not trade.isClosed
        bool isInvalidated = isLong_ ? low <= trade.slLevel : high >= trade.slLevel
        if isInvalidated
            trade.isClosed    := true
            trade.forceClosed := true
    float tpLevel = trade.tp1Level
    if not trade.tp1Triggered and (isLong_ ? high >= tpLevel : low <= tpLevel) and trade.hasHitEntry
        trade.tp1Triggered        := true
        justHitTP                 := true
        trade.positionRemaining   -= settings.tp1ProfitRatio
        profit += calculateProfit(settings, trade, trade.entryLevel, trade.tp1Level, settings.leverage, isLong_, settings.tp1ProfitRatio)
        if settings.breakEvenEnabled
            trade.breakEvenAllowed := true
            trade.breakEvenLevel   := trade.entryLevel
            if isLong_ ? trade.slLevel < trade.breakEvenLevel : trade.slLevel > trade.breakEvenLevel
                trade.slLevel := trade.breakEvenLevel
    tpLevel := trade.tp2Level
    if not trade.tp2Triggered and (isLong_ ? high >= tpLevel : low <= tpLevel) and trade.hasHitEntry
        trade.tp2Triggered      := true
        justHitTP               := true
        trade.positionRemaining -= settings.tp2ProfitRatio
        profit += calculateProfit(settings, trade, trade.entryLevel, trade.tp2Level, settings.leverage, isLong_, settings.tp2ProfitRatio)
        if settings.breakEvenEnabled
            trade.breakEvenAllowed := true
            trade.breakEvenLevel   := trade.tp1Level
            if isLong_ ? trade.slLevel < trade.breakEvenLevel : trade.slLevel > trade.breakEvenLevel
                trade.slLevel := trade.breakEvenLevel
    tpLevel := trade.tp3Level
    if not trade.tp3Triggered and (isLong_ ? high >= tpLevel : low <= tpLevel) and trade.hasHitEntry
        trade.tp3Triggered      := true
        justHitTP               := true
        trade.positionRemaining -= settings.tp3ProfitRatio
        profit += calculateProfit(settings, trade, trade.entryLevel, trade.tp3Level, settings.leverage, isLong_, settings.tp3ProfitRatio)
        if settings.breakEvenEnabled
            trade.breakEvenAllowed := true
            trade.breakEvenLevel   := trade.tp2Level
            if isLong_ ? trade.slLevel < trade.breakEvenLevel : trade.slLevel > trade.breakEvenLevel
                trade.slLevel := trade.breakEvenLevel
    tpLevel := trade.tp4Level
    if not trade.tp4Triggered and (isLong_ ? high >= tpLevel : low <= tpLevel) and trade.hasHitEntry
        trade.tp4Triggered      := true
        justHitTP               := true
        trade.positionRemaining -= settings.tp4ProfitRatio
        profit += calculateProfit(settings, trade, trade.entryLevel, trade.tp4Level, settings.leverage, isLong_, settings.tp4ProfitRatio)
        if settings.breakEvenEnabled
            trade.breakEvenAllowed := true
            trade.breakEvenLevel   := trade.tp3Level
            if isLong_ ? trade.slLevel < trade.breakEvenLevel : trade.slLevel > trade.breakEvenLevel
                trade.slLevel := trade.breakEvenLevel
    float trailLevel = 0.0
    if (triggerTrail or trade.trailingSLActivated) and trade.hasHitEntry and not trade.isClosed and not justHitTP
        trailLevel := isLong_ ? high - trailRange : low + trailRange
        if isLong_ and trailLevel > trade.slLevel
            trade.slLevel             := math.round_to_mintick(trailLevel)
            trade.trailingSLLevel     := math.round_to_mintick(trailLevel)
            trade.trailingSLActivated := true
        if not isLong_ and trailLevel < trade.slLevel
            trade.slLevel             := math.round_to_mintick(trailLevel)
            trade.trailingSLLevel     := math.round_to_mintick(trailLevel)
            trade.trailingSLActivated := true
    if not trade.slTriggered and not trade.isClosed and trade.hasHitEntry
        bool isSLHit = justHitTP ? (isLong_ ? close <= trade.slLevel : close >= trade.slLevel) : (isLong_ ? low <= trade.slLevel : high >= trade.slLevel)
        if isSLHit
            trade.slTriggered := true
            trade.isClosed    := true
            trade.closeLevel  := trade.slLevel
            profit += calculateProfit(settings, trade, trade.entryLevel, trade.slLevel, settings.leverage, isLong_, trade.positionRemaining, false)
    if trade.tp4Triggered and not trade.isClosed
        if not na(fMed_EMA)
            trade.slLevel         := isLong_ ? math.max(trade.tp3Level, fMed_EMA) : math.min(trade.tp3Level, fMed_EMA)
            trade.trailingSLLevel := trade.slLevel
            trade.trailingSLActivated := false
            bool isEmaCross = isLong_ ? close < trade.slLevel : close > trade.slLevel
            if isEmaCross
                trade.isClosed         := true
                trade.emaExitTriggered := true
                trade.closeLevel       := close
                profit += calculateProfit(settings, trade, trade.entryLevel, trade.closeLevel, settings.leverage, isLong_, trade.positionRemaining, false)
                trade.positionRemaining := 0
    if divExitActiveInput and not trade.isClosed and trade.hasHitEntry
        bool regularBearishDivNow = (ext_bearishDiv == 1)
        bool regularBullishDivNow = (ext_bullishDiv == 1)
        bool isRegularDivExit = (isLong_ and regularBearishDivNow) or (not isLong_ and regularBullishDivNow)
        bool anyBearishDiv1Ago = (ext_bearishDiv[1] == 1) or (ext_bearishHiddenDiv[1] == 1)
        bool anyBullishDiv1Ago = (ext_bullishDiv[1] == 1) or (ext_bullishHiddenDiv[1] == 1)
        bool bearishPriceConfirm = anyBearishDiv1Ago and (close < open) and (close < close[1])
        bool bullishPriceConfirm = anyBullishDiv1Ago and (close > open) and (close > close[1])
        bool isConfirmedDivExit = (isLong_ and bearishPriceConfirm) or (not isLong_ and bullishPriceConfirm)
        if isRegularDivExit or isConfirmedDivExit
            trade.isClosed          := true
            trade.divExitTriggered  := true
            trade.closeLevel        := close
            profit += calculateProfit(settings, trade, trade.entryLevel, trade.closeLevel, settings.leverage, isLong_, trade.positionRemaining, false)
            trade.positionRemaining := 0
    if trade.positionRemaining <= 0
        trade.isClosed := true
    trade.profit += profit

terminateTrade(Settings settings, TradeLogic trade) =>
    trade.forceClosed := true
    if not trade.slTriggered
        trade.closeLevel := close
        trade.isClosed := true
        trade.profit += calculateProfit(settings, trade, trade.entryLevel, trade.closeLevel, settings.leverage, str.contains(str.upper(trade.tradeDirection), 'LONG'), trade.positionRemaining)
deleteTradeVisuals(TradeVisuals visuals) => 0
generateTradeVisuals(Settings settings, TradeLogic trade, TradeVisuals visuals) => 0
updateTradeVisuals(Settings settings, TradeLogic trade, TradeVisuals visuals) => 0
signalLabelUpdate(Settings settings, TradeLogic trade, TradeVisuals visuals) => 0
finalizeTrade(Settings settings, TradeLogic trade, string z1_zone, string dX, string mX, string d1_message) => ""

initializeTradeSession(Settings settings, string tradeDirection) =>
    TradeLogic trade = TradeLogic.new()
    trade.entryTime         := timenow
    entryFeesRatio = settings.exchangeTakerFees * 100 * settings.leverage
    trade.profit -= entryFeesRatio
    settings.totalExchangeFees += entryFeesRatio * settings.initialCapital / 100
    trade.tradeDirection    := tradeDirection
    trade.entryLevel        := trendLine
    trade.hasHitEntry       := false
    bool isLong = str.contains(str.upper(tradeDirection), 'LONG')
    trade.slLevel  := isLong ? math.round_to_mintick(trade.entryLevel - slAtrMultInput  * atrValue) : math.round_to_mintick(trade.entryLevel + slAtrMultInput  * atrValue)
    trade.tp1Level := isLong ? math.round_to_mintick(trade.entryLevel + tp1AtrMultInput * atrValue) : math.round_to_mintick(trade.entryLevel - tp1AtrMultInput * atrValue)
    trade.tp2Level := isLong ? math.round_to_mintick(trade.entryLevel + tp2AtrMultInput * atrValue) : math.round_to_mintick(trade.entryLevel - tp2AtrMultInput * atrValue)
    trade.tp3Level := isLong ? math.round_to_mintick(trade.entryLevel + tp3AtrMultInput * atrValue) : math.round_to_mintick(trade.entryLevel - tp3AtrMultInput * atrValue)
    trade.tp4Level := isLong ? math.round_to_mintick(trade.entryLevel + tp4AtrMultInput * atrValue) : math.round_to_mintick(trade.entryLevel - tp4AtrMultInput * atrValue)
    trade.breakEvenLevel    := trade.entryLevel
    trade.startBarIndex     := bar_index
    trade.positionRemaining := 100.0
    trade.capital           := settings.initialCapital
    trade
isValidBounceDown(float srLevel) => (not na(srLevel)) and high >= srLevel and open <= srLevel and low < srLevel and close < srLevel and close < open
isValidBounceUp(float srLevel) => (not na(srLevel)) and low <= srLevel and open >= srLevel and high > srLevel and close > srLevel and close > open
checkAnyBounceUp(s01, s02, s03, s04, s05, s06, s07, s08, s09, s10, s11, s12, s13, s14, s15) => isValidBounceUp(s01) or isValidBounceUp(s02) or isValidBounceUp(s03) or isValidBounceUp(s04) or isValidBounceUp(s05) or isValidBounceUp(s06) or isValidBounceUp(s07) or isValidBounceUp(s08) or isValidBounceUp(s09) or isValidBounceUp(s10) or isValidBounceUp(s11) or isValidBounceUp(s12) or isValidBounceUp(s13) or isValidBounceUp(s14) or isValidBounceUp(s15)
checkAnyBounceDown(r01, r02, r03, r04, r05, r06, r07, r08, r09, r10, r11, r12, r13, r14, r15) => isValidBounceDown(r01) or isValidBounceDown(r02) or isValidBounceDown(r03) or isValidBounceDown(r04) or isValidBounceDown(r05) or isValidBounceDown(r06) or isValidBounceDown(r07) or isValidBounceDown(r08) or isValidBounceDown(r09) or isValidBounceDown(r10) or isValidBounceDown(r11) or isValidBounceDown(r12) or isValidBounceDown(r13) or isValidBounceDown(r14) or isValidBounceDown(r15)

initializeAndPushTrade(Settings settings, bool buyCond, bool sellCond, string longName, string shortName, array<TradeLogic> sessionsArr, array<TradeVisuals> visualsArr, string z1, string dX, string mX, string d1_message) =>
    bool isSideways = (mX == 'INRANGEINVALUE') or (mX == 'TYPICAL DAY,\nTRADING RANGE,\nSIDEWAYS') or str.contains(mX, "TRADING RANGE") or str.contains(mX, "SIDEWAYS") or str.contains(mX, "TYPICAL DAY") or (dX == 'IN RANGE\nIN VALUE')
    bool _buy  = buyCond  and close < H4
    bool _sell = sellCond and close > L4
    bool alreadyOpenedThisBar = false
    if array.size(sessionsArr) > 0
        TradeLogic lastTrade = array.get(sessionsArr, array.size(sessionsArr) - 1)
        if lastTrade.startBarIndex == bar_index
            alreadyOpenedThisBar := true
    if (_buy or _sell) and not alreadyOpenedThisBar and (not isSideways or NCPR)
        TradeLogic newTrade = initializeTradeSession(settings, _buy ? longName : shortName)
        TradeVisuals newVis = TradeVisuals.new()
        sendAlert(settings, newTrade, dX, mX, z1, d1_message)
        array.push(sessionsArr, newTrade)
        array.push(visualsArr, newVis)

Faster      = fShort_EMA
Slower      = fMed_EMA
CPR_Today   = CPR
var float grsMid      = na
var float resMid      = na
bool bouncedOffSR_Up   = checkAnyBounceUp(sup01, sup02, sup03, sup04, sup05, sup06, sup07, sup08, sup09, sup10, sup11, sup12, sup13, sup14, sup15)
bool bouncedOffSR_Down = checkAnyBounceDown(res01, res02, res03, res04, res05, res06, res07, res08, res09, res10, res11, res12, res13, res14, res15)
bool bouncedOffActualGrsMid = isValidBounceUp(grsMid)
bool bouncedOffActualResMid = isValidBounceDown(resMid)
if bouncedOffActualGrsMid
    grsMid      := na
if bouncedOffActualResMid
    resMid      := na
bool GrS = GREEN1 and bouncedOffSR_Up
bool ReS = RED1 and bouncedOffSR_Down
if GrS and not GrS[1]
    grsMid := (high + low) / 2
if ReS and not ReS[1]
    resMid := (high + low) / 2

bool bullConds = (mX == 'BIG MOVE') or (mX == 'TREND DAY,\nDOUBLE DISTRIBUTION TREND,\nEXPANDED TYPICAL') or (dX == 'OUT OF RANGE\nOUT OF VALUE') or (c1 == 'CONFIRMED BULLISH') or (c1 == 'REJECTED BEARISH') or (c1 == 'WATCH')
bool bearConds = (mX == 'BIG MOVE') or (mX == 'TREND DAY,\nDOUBLE DISTRIBUTION TREND,\nEXPANDED TYPICAL') or (dX == 'OUT OF RANGE\nOUT OF VALUE') or (c1 == 'CONFIRMED BEARISH') or (c1 == 'REJECTED BULLISH') or (c1 == 'WATCH')
bool RisingUP    = bullConds
bool FallingDOWN = bearConds
bool RisingUp    = (plus >= minus) and (fPivotPDEMAF >= fPivotPDEMAS) and bullConds
bool FallingDown = (minus >= plus) and (fPivotPDEMAF <= fPivotPDEMAS) and bearConds
bool R_up = RisingUp and close > open
bool R_dn = FallingDown and close < open
bool MissUP = (RisingUp or RisingUP) and close > open and (low < VAH and open > VAH and high > VAH and close > VAH)
bool MissDOWN = (FallingDown or FallingDOWN) and close < open and (high > VAL and open < VAL and low < VAL and close < VAL)
bool MissU = MissUP or (R_up and ((low < VAH and open > VAH and high > VAH and close > VAH) or (low < Slower and open > Slower and high > Slower and close > Slower) or (low < CPR_Today and open > CPR_Today and high > CPR_Today and close > CPR_Today)))
bool MissD = MissDOWN or (R_dn and ((high > VAL and open < VAL and low < VAL and close < VAL) or (high > Slower and open < Slower and low < Slower and close < Slower) or (high > CPR_Today and open < CPR_Today and low < CPR_Today and close < CPR_Today)))
bool RangingUp   = (plus >= minus) and (fPivotPDEMAF >= fPivotPDEMAS) and (m0 >= m10) and ((mX == 'INRANGEINVALUE') or (mX == 'TYPICAL DAY,\nTRADING RANGE,\nSIDEWAYS') or (dX == 'IN RANGE\nIN VALUE'))
bool RangingDown = (minus >= plus) and (fPivotPDEMAF <= fPivotPDEMAS) and (m0 <= m10) and ((mX == 'INRANGEINVALUE') or (mX == 'TYPICAL DAY,\nTRADING RANGE,\nSIDEWAYS') or (dX == 'IN RANGE\nIN VALUE'))
bool BounceUp   = (RangingUp and close > open) and ((low < VAL and open > VAL and high > VAL and close > VAL) or (low < CPR_Today and open > CPR_Today and high > CPR_Today and close > CPR_Today))
bool BounceDown = (RangingDown and close < open) and ((high > VAH and open < VAH and low < VAH and close < VAH) or (high > CPR_Today and open < CPR_Today and low < CPR_Today and close < CPR_Today))
bool CanBuy  = (emaCanBuy  and MissU) or (emaCanBuy and BounceUp)
bool CanSell = (emaCanSell and MissD) or (emaCanSell and BounceDown)
cleanTrendBullish := CanBuy ? true : CanSell ? false : RisingUp ? true : false
cleanTrendBearish := CanSell ? true : CanBuy ? false : FallingDown ? true : false
bool bouncedOffGrsMid = bouncedOffSR_Up or bouncedOffActualGrsMid
bool bouncedOffResMid = bouncedOffSR_Down or bouncedOffActualResMid
StepUp = (cleanTrendBullish or GREEN1) and bouncedOffGrsMid
StepDn = (cleanTrendBearish or RED1) and bouncedOffResMid
bool ScalpBuy  = (emaCanBuy  and StepUp)
bool ScalpSell = (emaCanSell and StepDn)
bool isSidewaysDay = (mX == 'INRANGEINVALUE') or (mX == 'TYPICAL DAY,\nTRADING RANGE,\nSIDEWAYS') or str.contains(mX, "TRADING RANGE") or str.contains(mX, "SIDEWAYS") or str.contains(mX, "TYPICAL DAY") or (dX == 'IN RANGE\nIN VALUE')
bool dayAllowed = not isSidewaysDay or NCPR
bool longAllowed  = close < H4
bool shortAllowed = close > L4
string z1 = (BULLISH or MODERATELYBULLISH or REJECTEDBEARISH) and close > h3 or (BEARISH or MODERATELYBEARISH or REJECTEDBULLISH) and close > h3 or ANYDAY and close > DBc and close > DTc ? 'LONG ZONE' : (BULLISH or MODERATELYBULLISH or REJECTEDBEARISH) and close < l3 or (BEARISH or MODERATELYBEARISH or REJECTEDBULLISH) and close < l3 or ANYDAY and close < DTc and close < DBc ? 'SHORT ZONE' : ANYDAY and close > DBc and close < DTc ? 'WAIT FOR SIGNAL' : 'WAITING'
bool hasBullishDiv = (ext_bullishDiv == 1) or (ext_bullishHiddenDiv == 1)
bool hasBearishDiv = (ext_bearishDiv == 1) or (ext_bearishHiddenDiv == 1)
bool LightningBuy  = ((CanBuy and ScalpBuy)   or (hasBullishDiv[1] and GrS)) and longAllowed and dayAllowed
bool LightningSell = ((CanSell and ScalpSell) or (hasBearishDiv[1] and ReS)) and shortAllowed and dayAllowed
bool JustMissileBuy  = CanBuy and not LightningBuy and longAllowed and dayAllowed
bool JustMissileSell = CanSell and not LightningSell and shortAllowed and dayAllowed
bool JustScalpBuy  = ScalpBuy and not LightningBuy and longAllowed and dayAllowed
bool JustScalpSell = ScalpSell and not LightningSell and shortAllowed and dayAllowed

var array<TradeLogic>   missileSessions   = array.new<TradeLogic>()
var array<TradeVisuals> missileVisualsArr = array.new<TradeVisuals>()
var array<TradeLogic>   scalpSessions     = array.new<TradeLogic>()
var array<TradeVisuals> scalpVisualsArr   = array.new<TradeVisuals>()
var array<TradeLogic>   currentSessions   = array.new<TradeLogic>()
var array<TradeVisuals> currentVisualsArr = array.new<TradeVisuals>()
initializeAndPushTrade(settings, JustMissileBuy, JustMissileSell, 'LONG MISSILE', 'SHORT MISSILE', missileSessions, missileVisualsArr, z1, dX, mX, d1_message)
initializeAndPushTrade(settings, JustScalpBuy, JustScalpSell, 'LONG SCALP', 'SHORT SCALP', scalpSessions, scalpVisualsArr, z1, dX, mX, d1_message)
initializeAndPushTrade(settings, LightningBuy, LightningSell, 'LONG LIGHTNING', 'SHORT LIGHTNING', currentSessions, currentVisualsArr, z1, dX, mX, d1_message)

// ──── DAY TYPE BLUEPRINTS & SEQUENCES ENGINE ────────────────────────────────
adrLen = input.int(10, "ATR Lookback (bars)", minval=2, group="Blueprints Settings")
accLen = input.int(20, "Accumulation Lookback", minval=5, group="Blueprints Settings")
accMaxRangeMult = input.float(3.0, "Max Range vs ATR (x)", step=0.1, group="Blueprints Settings")
adrMultMin = input.float(1.25, "Min Range vs ATR (x)", step=0.05, group="Blueprints Settings")
tailBodyMult = input.float(2.5, "Min Tail / Body Ratio", step=0.1, group="Blueprints Settings")
closeZonePct = input.float(35, "Close within top/bottom X% of range", minval=1, maxval=50, group="Blueprints Settings") / 100
useStructure = input.bool(true, "Require near prior swing extreme", group="Blueprints Settings")
structLen    = input.int(20, "Lookback for prior swing high/low", minval=2, group="Blueprints Settings")
structTolPct = input.float(1.0, "Tolerance around prior extreme (%)", step=0.1, group="Blueprints Settings") / 100
odAdrMultMin = input.float(1.05, "Min Range vs ATR (x)", step=0.05, group="Blueprints Settings")
adrMinPct = input.float(75, "Min Range vs ATR (%)", step=5, group="Blueprints Settings") / 100
sweepLookback = input.int(1, "Sweep Lookback (bars)", minval=1, maxval=20, group="Blueprints Settings")
requireAboveYMid = input.bool(true, "Require close above yMID (FNL) / below yMID (FNH)", group="Blueprints Settings")
absAdrMaxMult = input.float(0.75, "Max Range vs ATR (x)", step=0.05, group="Blueprints Settings")
absMidTolPct = input.float(1.0, "Tolerance: Low/High near yMID (%)", step=0.1, group="Blueprints Settings") / 100
requireBodyConfirm = input.bool(true, "Require body confirmation (Close vs Open)", group="Blueprints Settings")
srdAdrMultMin = input.float(2.0, "Min Range vs ATR (x)", step=0.1, group="Blueprints Settings")
srdCloseZonePct = input.float(15, "Close within top/bottom X% of range", minval=1, maxval=50, group="Blueprints Settings") / 100
srdStructLen = input.int(5, "Lookback for prior swing high/low for MID check (bars)", minval=1, group="Blueprints Settings")

f_calc() =>
    rng    = high - low
    body   = math.abs(close - open)
    upWick = high - math.max(open, close)
    dnWick = math.min(open, close) - low
    mid    = (high + low) / 2
    avgRange = ta.sma(ta.tr(true), adrLen)[1]
    closePos = rng != 0 ? (close - low) / rng : 0.5
    accHigh = ta.highest(high, accLen)
    accLow  = ta.lowest(low, accLen)
    accRange = accHigh - accLow
    isCompressing = avgRange > 0 and accRange <= accMaxRangeMult * avgRange
    bullAcc = isCompressing and close >= (accHigh + accLow) / 2
    bearDist = isCompressing and close < (accHigh + accLow) / 2
    rejRangeOK  = avgRange > 0 and rng > adrMultMin * avgRange
    bullTailOK  = body > 0 ? dnWick > tailBodyMult * body : dnWick > 0
    bearTailOK  = body > 0 ? upWick > tailBodyMult * body : upWick > 0
    bullCloseOK = closePos >= (1 - closeZonePct)
    bearCloseOK = closePos <= closeZonePct
    priorLowStruct  = ta.lowest(low, structLen)[1]
    priorHighStruct = ta.highest(high, structLen)[1]
    nearPriorLow  = low  <= priorLowStruct  * (1 + structTolPct)
    nearPriorHigh = high >= priorHighStruct * (1 - structTolPct)
    structBullOK = not useStructure or nearPriorLow
    structBearOK = not useStructure or nearPriorHigh
    bullRej = rejRangeOK and bullTailOK and bullCloseOK and structBullOK
    bearRej = rejRangeOK and bearTailOK and bearCloseOK and structBearOK
    srdRangeOK = avgRange > 0 and rng > srdAdrMultMin * avgRange
    bullSrdClosePosOK = closePos >= (1 - srdCloseZonePct)
    bullSrdCloseExt   = close > high[1]
    bullSrdMidExt     = mid >= ta.highest(high, srdStructLen)[1]
    bullSrdSignal     = srdRangeOK and bullSrdClosePosOK and bullSrdCloseExt and bullSrdMidExt
    bearSrdClosePosOK = closePos <= srdCloseZonePct
    bearSrdCloseExt   = close < low[1]
    bearSrdMidExt     = mid <= ta.lowest(low, srdStructLen)[1]
    bearSrdSignal     = srdRangeOK and bearSrdClosePosOK and bearSrdCloseExt and bearSrdMidExt

    var float rejActiveMid   = na
    var float rejActiveHigh  = na
    var float rejActiveLow   = na
    var bool  bullRejActive  = false
    var bool  bearRejActive  = false
    var bool  bullFailedAbsActive = false
    var bool  bearFailedAbsActive = false
    int barsSinceRej = ta.barssince(bullRej or bearRej)
    if bullRej
        rejActiveMid  := mid
        rejActiveHigh := high
        rejActiveLow  := low
        bullRejActive := true
        bearRejActive := false
        bullFailedAbsActive := false
        bearFailedAbsActive := false
    else if bearRej
        rejActiveMid  := mid
        rejActiveHigh := high
        rejActiveLow  := low
        bearRejActive := true
        bullRejActive := false
        bullFailedAbsActive := false
        bearFailedAbsActive := false
    if bullRejActive and close < rejActiveMid
        bullRejActive := false
        bearFailedAbsActive := true
    if bearRejActive and close > rejActiveMid
        bearRejActive := false
        bullFailedAbsActive := true
    if bearFailedAbsActive and close > rejActiveHigh
        bearFailedAbsActive := false
    if bullFailedAbsActive and close < rejActiveLow
        bullFailedAbsActive := false

    var float srdActiveMid   = na
    var float srdActiveExt   = na
    var bool  bullSrdActive  = false
    var bool  bearSrdActive  = false
    int barsSinceSrd = ta.barssince(bullSrdSignal or bearSrdSignal)
    if bullSrdSignal
        srdActiveMid  := mid
        srdActiveExt  := high
        bullSrdActive := true
        bearSrdActive := false
    else if bearSrdSignal
        srdActiveMid  := mid
        srdActiveExt  := low
        bearSrdActive := true
        bullSrdActive := false
    if bullSrdActive and close < srdActiveMid
        bullSrdActive := false
    if bearSrdActive and close > srdActiveMid
        bearSrdActive := false

    bullFade = bullSrdActive and not na(barsSinceSrd) and barsSinceSrd > 0 and high >= srdActiveExt * 0.995 and close < open
    bearFade = bearSrdActive and not na(barsSinceSrd) and barsSinceSrd > 0 and low <= srdActiveExt * 1.005 and close > open
    absRangeOK = avgRange > 0 and rng < absAdrMaxMult * avgRange
    bullAbs_Rej = bullRejActive and not na(barsSinceRej) and barsSinceRej > 0 and absRangeOK and close > rejActiveMid and (not requireBodyConfirm or close > open) and math.abs(low - rejActiveMid) <= rejActiveMid * absMidTolPct
    bearAbs_Rej = bearRejActive and not na(barsSinceRej) and barsSinceRej > 0 and absRangeOK and close < rejActiveMid and (not requireBodyConfirm or close < open) and math.abs(high - rejActiveMid) <= rejActiveMid * absMidTolPct
    bullAbs_Srd = bullSrdActive and not na(barsSinceSrd) and barsSinceSrd > 0 and absRangeOK and close > srdActiveMid and (not requireBodyConfirm or close > open) and math.abs(low - srdActiveMid) <= srdActiveMid * absMidTolPct
    bearAbs_Srd = bearSrdActive and not na(barsSinceSrd) and barsSinceSrd > 0 and absRangeOK and close < srdActiveMid and (not requireBodyConfirm or close < open) and math.abs(high - srdActiveMid) <= srdActiveMid * absMidTolPct
    odRangeOK = avgRange > 0 and rng > odAdrMultMin * avgRange
    odBull = odRangeOK and low < low[1] and close > high[1]
    odBear = odRangeOK and high > high[1] and close < low[1]
    fnlRangeOK = avgRange > 0 and rng >= adrMinPct * avgRange
    priorLowSweep  = ta.lowest(low, sweepLookback)[1]
    priorHighSweep = ta.highest(high, sweepLookback)[1]
    yMidFnl = (high[1] + low[1]) / 2.0
    fnlSweep  = low < priorLowSweep
    fnlClose  = requireAboveYMid ? close > yMidFnl : close > mid
    fnlSignal = fnlRangeOK and fnlSweep and fnlClose
    fnhSweep  = high > priorHighSweep
    fnhClose  = requireAboveYMid ? close < yMidFnl : close < mid
    fnhSignal = fnlRangeOK and fnhSweep and fnhClose
    bullFnl_Rej = bullRejActive and not na(barsSinceRej) and barsSinceRej > 0 and fnlSignal
    bearFnh_Rej = bearRejActive and not na(barsSinceRej) and barsSinceRej > 0 and fnhSignal
    bullFnl_Srd = bullSrdActive and not na(barsSinceSrd) and barsSinceSrd > 0 and fnlSignal
    bearFnh_Srd = bearSrdActive and not na(barsSinceSrd) and barsSinceSrd > 0 and fnhSignal
    int barsSinceFa = ta.barssince(bullFailedAbsActive or bearFailedAbsActive)
    bullFailedBreakout = bullFailedAbsActive and not na(barsSinceFa) and barsSinceFa > 0 and low <= low[1] and close > open
    bearFailedBreakout = bearFailedAbsActive and not na(barsSinceFa) and barsSinceFa > 0 and high >= high[1] and close < open
    bullRetestAfterSrd = bullFailedAbsActive and (bullFade or bullAbs_Srd)
    bearRetestAfterSrd = bearFailedAbsActive and (bearFade or bearAbs_Srd)
    bullFade_final = bullFade and not bullRetestAfterSrd
    bearFade_final = bearFade and not bearRetestAfterSrd
    unifiedBullAbs = bullAbs_Rej or (bullAbs_Srd and not bullRetestAfterSrd)
    unifiedBearAbs = bearAbs_Rej or (bearAbs_Srd and not bearRetestAfterSrd)
    var bool prevActiveDayBull = false
    var bool prevActiveDayBear = false
    bullCont = prevActiveDayBull and close > close[1]
    bearCont = prevActiveDayBear and close < close[1]
    prevActiveDayBull := bullRej or bullSrdSignal or unifiedBullAbs or fnlSignal or bullFailedBreakout or bullRetestAfterSrd
    prevActiveDayBear := bearRej or bearSrdSignal or unifiedBearAbs or fnhSignal or bearFailedBreakout or bearRetestAfterSrd

    [bullAcc, bearDist, bullRej, bearRej, bullSrdSignal, bearSrdSignal, odBull, odBear, bullFade_final, bearFade_final, unifiedBullAbs, unifiedBearAbs, fnlSignal, fnhSignal, bullFailedBreakout, bearFailedBreakout, bullRetestAfterSrd, bearRetestAfterSrd, bullCont, bearCont]

f_calc_packed() =>
    [acB, acS, rB, rS, sB, sS, odB, odS, fdB, fdS, aB, aS, fB, fS, fbB, fbS, rtB, rtS, cContB, cContS] = f_calc()
    packSignals20(acB, acS, rB, rS, sB, sS, odB, odS, fdB, fdS, aB, aS, fB, fS, fbB, fbS, rtB, rtS, cContB, cContS)

f_calc_sigs() =>
    fPivot_ = (high + low + close) / 3
    fFastEMA1_ = 5
    fSlowEMA1_ = 13
    fPivotEMAF1_ = ta.ema(fPivot_, fFastEMA1_)
    fPivotEMAF2_ = ta.ema(fPivotEMAF1_, fFastEMA1_)
    fPivotEMAS1_ = ta.ema(fPivot_, fSlowEMA1_)
    fPivotEMAS2_ = ta.ema(fPivotEMAS1_, fSlowEMA1_)
    PDEMAF_ = fPivotEMAF1_ * 2 - fPivotEMAF2_
    PDEMAS_ = fPivotEMAS1_ * 2 - fPivotEMAS2_
    fPivotPDEMAF_ = ta.ema(PDEMAF_, fFastEMA1_)
    fPivotPDEMAS_ = ta.ema(PDEMAS_, fSlowEMA1_)
    fShortEMA_ = ta.ema(fPivot_, 13)
    fMedEMA_ = ta.ema(fPivot_, 32)
    upper_ = ta.highest(92)
    lower_ = ta.lowest(92)
    out_ = 100 * (close - upper_) / (upper_ - lower_)
    m0_ = ta.ema(out_, 21)
    m10_ = ta.sma(out_, 96)
    len14_ = 14
    up14_ = ta.change(high)
    down14_ = -ta.change(low)
    plusDM_ = na(up14_) ? na : (up14_ > down14_ and up14_ > 0 ? up14_ : 0)
    minusDM_ = na(down14_) ? na : (down14_ > up14_ and down14_ > 0 ? down14_ : 0)
    trur_ = ta.rma(ta.tr, len14_)
    plus_ = fixnan(100 * ta.rma(plusDM_, len14_) / trur_)
    minus_ = fixnan(100 * ta.rma(minusDM_, len14_) / trur_)
    GREENZONE_ = (plus_ > minus_) and (m0_ > m10_)
    REDZONE_ = (minus_ > plus_) and (m0_ < m10_)
    pivotlbar_ = 10
    highleftempty_ = ta.pivothigh(pivotlbar_, 0)
    lowleftempty_ = ta.pivotlow(pivotlbar_, 0)
    Wmybodysize_ = math.abs(close - open)
    WAverageBody_ = ta.sma(Wmybodysize_, 50)
    Wmycandlesize_ = high - low
    WAverageCandle_ = ta.sma(Wmycandlesize_, 50)
    Wlong_ = close > open and open - low >= (close - open) * 3.25 and high - close <= (high - low) * 0.35 or close < open and close - low >= (open - close) * 3.25 and high - close <= (high - low) * 0.35 or close == open and close != high and high - low >= (high - close) * 3.25 and high - close <= (high - low) * 0.35 or open == high and close == high and high - low >= ta.sma(high - low, 50)
    Wshort_ = close < open and high - open >= (open - close) * 3.25 and close - low <= (high - low) * 0.35 or close > open and high - close >= (close - open) * 3.25 and close - low <= (high - low) * 0.35 or close == open and close != low and high - low >= (close - low) * 3.25 and close - low <= (high - low) * 0.35 or open == low and close == low and high - low >= ta.sma(high - low, 50)
    _wls = GREENZONE_ and not na(lowleftempty_) and Wlong_ and high - low >= WAverageCandle_ * 1.1
    _wss = REDZONE_ and not na(highleftempty_) and Wshort_ and high - low >= WAverageCandle_ * 1.1
    _els = GREENZONE_ and open[1] - close[1] >= 0.75 * (high[1] - low[1]) and high[1] - low[1] > WAverageCandle_ * 2.0 and open[1] - close[1] > WAverageBody_ and close > open
    _ess = REDZONE_ and close[1] - open[1] >= 0.75 * (high[1] - low[1]) and high[1] - low[1] > WAverageCandle_ * 2.0 and close[1] - open[1] > WAverageBody_ and open > close
    _ols = GREENZONE_ and low < low[1] and close > high[1] and high - low >= WAverageCandle_ * 1.25
    _oss = REDZONE_ and high > high[1] and close < low[1] and high - low >= WAverageCandle_ * 1.25
    frangehl_ = high[1] - low[1]
    frangeco_ = math.abs(close[1] - open[1])
    sma10_ = ta.sma(close, 10)
    Dshort_ = frangeco_ <= frangehl_ * 0.10 and close < low[1] and low[1] > sma10_ and close < open or close < low[2] and close[1] >= low[2] and frangeco_ <= frangeco_ * 0.10 and close < open and low[2] > sma10_
    Dlong_ = frangeco_ <= frangehl_ * 0.10 and close > high[1] and high[1] < sma10_ and close > open or close > high[2] and close[1] <= high[2] and frangeco_ <= frangeco_ * 0.10 and close > open and high[2] < sma10_
    _dls = GREENZONE_ and not na(lowleftempty_) and Dlong_ and high - low >= WAverageCandle_ * 0.65
    _dss = REDZONE_ and not na(highleftempty_) and Dshort_ and high - low >= WAverageCandle_ * 0.65
    RisingUp_ = (plus_ >= minus_) and (fPivotPDEMAF_ >= fPivotPDEMAS_) and (m0_ >= m10_)
    FallingDown_ = (minus_ >= plus_) and (fPivotPDEMAF_ <= fPivotPDEMAS_) and (m0_ <= m10_)
    _mb = RisingUp_ and close > open and fShortEMA_ > fMedEMA_ and close > fMedEMA_
    _ms = FallingDown_ and close < open and fShortEMA_ < fMedEMA_ and close < fMedEMA_
    _sb = RisingUp_ and close > open and ta.crossover(fShortEMA_, fMedEMA_)
    _ss = FallingDown_ and close < open and ta.crossunder(fShortEMA_, fMedEMA_)
    _lb = RisingUp_ and ta.crossover(m0_, m10_)
    _ls = FallingDown_ and ta.crossunder(m0_, m10_)
    rsi14_ = ta.rsi(close, 14)
    _bDiv = not na(ta.pivotlow(rsi14_, 5, 5)) and low <= ta.lowest(low, 20)[1] and rsi14_ > ta.lowest(rsi14_, 20)[1]
    _brDiv = not na(ta.pivothigh(rsi14_, 5, 5)) and high >= ta.highest(high, 20)[1] and rsi14_ < ta.highest(rsi14_, 20)[1]
    _bhDiv = not na(ta.pivotlow(rsi14_, 5, 5)) and low > ta.lowest(low, 20)[1] and rsi14_ <= ta.lowest(rsi14_, 20)[1]
    _brhDiv = not na(ta.pivothigh(rsi14_, 5, 5)) and high < ta.highest(high, 20)[1] and rsi14_ >= ta.highest(rsi14_, 20)[1]
    packSignals18(_mb, _ms, _sb, _ss, _lb, _ls, _wls, _wss, _els, _ess, _ols, _oss, _dls, _dss, _bDiv, _brDiv, _bhDiv, _brhDiv)

// ──── 4 COMMODITIES DASHBOARD CALLS ─────────────────────────────────────────

f_cell(arr) => array.size(arr) > 0 ? "▲ " + str.tostring(array.size(arr)) + "\n" + array.join(arr, "\n") : "-"
f_cell_b(arr) => array.size(arr) > 0 ? "▼ " + str.tostring(array.size(arr)) + "\n" + array.join(arr, "\n") : "-"

f_add_row(t, r, labelText, bullArr, bearArr, tSize) =>
    hasBull = array.size(bullArr) > 0
    hasBear = array.size(bearArr) > 0
    if hasBull or hasBear
        table.cell(t, 0, r, labelText, bgcolor=color.rgb(249, 226, 23, 87), text_color=color.rgb(10, 65, 230), text_size=tSize, text_halign=text.align_right)
        table.cell(t, 1, r, f_cell(bullArr), bgcolor=hasBull ? color.new(color.lime, 80) : color.new(color.gray, 85), text_color=hasBull ? color.green : color.gray, text_size=tSize, text_halign=text.align_right)
        table.cell(t, 2, r, f_cell_b(bearArr), bgcolor=hasBear ? color.new(color.red, 80) : color.new(color.gray, 85), text_color=hasBear ? color.red : color.gray, text_size=tSize, text_halign=text.align_right)
        true
    else
        false

f_add_seq_row(t, r, labelText, bullFb, bullRt, bearFb, bearRt, tSize) =>
    hasBull = (array.size(bullFb) + array.size(bullRt)) > 0
    hasBear = (array.size(bearFb) + array.size(bearRt)) > 0
    if hasBull or hasBear
        bullTxt = hasBull ? "▲ " + str.tostring(array.size(bullFb) + array.size(bullRt)) + "\n" + (array.size(bullFb)>0 ? array.join(bullFb, "\n") : array.join(bullRt, "\n")) : "-"
        bearTxt = hasBear ? "▼ " + str.tostring(array.size(bearFb) + array.size(bearRt)) + "\n" + (array.size(bearFb)>0 ? array.join(bearFb, "\n") : array.join(bearRt, "\n")) : "-"
        table.cell(t, 0, r, labelText, bgcolor=color.rgb(249, 226, 23, 87), text_color=color.rgb(10, 65, 230), text_size=tSize, text_halign=text.align_right)
        table.cell(t, 1, r, bullTxt, bgcolor=hasBull ? color.new(color.lime, 78) : color.new(color.gray, 85), text_color=hasBull ? color.rgb(19, 65, 43) : color.gray, text_size=tSize, text_halign=text.align_right)
        table.cell(t, 2, r, bearTxt, bgcolor=hasBear ? color.new(color.red, 78) : color.new(color.gray, 85), text_color=hasBear ? color.red : color.gray, text_size=tSize, text_halign=text.align_right)
        true
    else
        false

