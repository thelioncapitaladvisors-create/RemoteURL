issfp(level) =>
    open[ln] < level and high[ln] > level and close[ln] < level or open[ln] > level and low[ln] < level and close[ln] > level or open[ln + 1] < level and high[ln + 1] > level and close[ln + 1] < level or open[ln + 1] > level and low[ln + 1] < level and close[ln + 1] > level
isfros(level) =>
    open[ln] < level and math.abs(level - high[ln]) / level * 100 < fo and close[ln] < level or open[ln] > level and math.abs(low[ln] - level) / level * 100 < fo and close[ln] > level or open[ln - 1] < level and math.abs(level - high[ln - 1]) / level * 100 < fo and close[ln - 1] < level or open[ln - 1] > level and math.abs(low[ln - 1] - level) / level * 100 < fo and close[ln - 1] > level
isbreakfailure() =>
    issfp(sup01) or issfp(sup02) or issfp(sup03) or issfp(sup04) or issfp(sup05) or issfp(sup06) or issfp(sup07) or issfp(sup08) or issfp(sup09) or issfp(sup10) or issfp(sup11) or issfp(sup12) or issfp(sup13) or issfp(sup14) or issfp(sup15) or issfp(res01) or issfp(res02) or issfp(res03) or issfp(res04) or issfp(res05) or issfp(res06) or issfp(res07) or issfp(res08) or issfp(res09) or issfp(res10) or issfp(res11) or issfp(res12) or issfp(res13) or issfp(res14) or issfp(res15) or isfros(sup01) or isfros(sup02) or isfros(sup03) or isfros(sup04) or isfros(sup05) or isfros(sup06) or isfros(sup07) or isfros(sup08) or isfros(sup09) or isfros(sup10) or isfros(sup11) or isfros(sup12) or isfros(sup13) or isfros(sup14) or isfros(sup15) or isfros(res01) or isfros(res02) or isfros(res03) or isfros(res04) or isfros(res05) or isfros(res06) or isfros(res07) or isfros(res08) or isfros(res09) or isfros(res10) or isfros(res11) or isfros(res12) or isfros(res13) or isfros(res14) or isfros(res15)

p = Top
lt = ln
s = intraMid
q = Bottom
lb = ln
if not na(p)
