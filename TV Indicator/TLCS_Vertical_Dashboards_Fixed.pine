var array<string> bearSrdSyms = array.new_string()
var array<string> bullOdSyms = array.new_string()
var array<string> bearOdSyms = array.new_string()
var array<string> bullFadeSyms = array.new_string()
var array<string> bearFadeSyms = array.new_string()
var array<string> bullAbsSyms = array.new_string()
var array<string> bearAbsSyms = array.new_string()
var array<string> bullFnlSyms = array.new_string()
var array<string> bearFnhSyms = array.new_string()
var array<string> bullFbSyms = array.new_string()
var array<string> bearFbSyms = array.new_string()
var array<string> bullRtSyms = array.new_string()
var array<string> bearRtSyms = array.new_string()
var array<string> bullContSyms = array.new_string()
var array<string> bearContSyms = array.new_string()

f_add(sym, sigPack, dtPack) =>
    if sym != ""
        array.push(symArr, sym)
        if unpackBit(sigPack, 1)
            array.push(bullMissileSyms, sym)
        if unpackBit(sigPack, 2)
            array.push(bearMissileSyms, sym)
        if unpackBit(sigPack, 4)
            array.push(bullScalpSyms, sym)
        if unpackBit(sigPack, 8)
            array.push(bearScalpSyms, sym)
        if unpackBit(sigPack, 16)
            array.push(bullLightningSyms, sym)
        if unpackBit(sigPack, 32)
            array.push(bearLightningSyms, sym)
        if unpackBit(sigPack, 64)
            array.push(bullWickSyms, sym)
        if unpackBit(sigPack, 128)
            array.push(bearWickSyms, sym)
        if unpackBit(sigPack, 256)
            array.push(bullExtremeSyms, sym)
        if unpackBit(sigPack, 512)
            array.push(bearExtremeSyms, sym)
        if unpackBit(sigPack, 1024)
            array.push(bullOutsideSyms, sym)
        if unpackBit(sigPack, 2048)
            array.push(bearOutsideSyms, sym)
        if unpackBit(sigPack, 4096)
            array.push(bullDojiSyms, sym)
        if unpackBit(sigPack, 8192)
            array.push(bearDojiSyms, sym)
        if unpackBit(sigPack, 16384)
            array.push(bullDivSyms, sym)
        if unpackBit(sigPack, 32768)
            array.push(bearDivSyms, sym)
        if unpackBit(sigPack, 65536)
            array.push(bullHDivSyms, sym)
        if unpackBit(sigPack, 131072)
            array.push(bearHDivSyms, sym)

        if unpackBit(dtPack, 1)
            array.push(bullAccSyms, sym)
        if unpackBit(dtPack, 2)
            array.push(bearAccSyms, sym)
        if unpackBit(dtPack, 4)
            array.push(bullRejSyms, sym)
        if unpackBit(dtPack, 8)
            array.push(bearRejSyms, sym)
        if unpackBit(dtPack, 16)
            array.push(bullSrdSyms, sym)
        if unpackBit(dtPack, 32)
            array.push(bearSrdSyms, sym)
        if unpackBit(dtPack, 64)
            array.push(bullOdSyms, sym)
        if unpackBit(dtPack, 128)
            array.push(bearOdSyms, sym)
        if unpackBit(dtPack, 256)
            array.push(bullFadeSyms, sym)
        if unpackBit(dtPack, 512)
            array.push(bearFadeSyms, sym)
        if unpackBit(dtPack, 1024)
            array.push(bullAbsSyms, sym)
        if unpackBit(dtPack, 2048)
            array.push(bearAbsSyms, sym)
        if unpackBit(dtPack, 4096)
            array.push(bullFnlSyms, sym)
        if unpackBit(dtPack, 8192)
            array.push(bearFnhSyms, sym)
        if unpackBit(dtPack, 16384)
            array.push(bullFbSyms, sym)
        if unpackBit(dtPack, 32768)
            array.push(bearFbSyms, sym)
        if unpackBit(dtPack, 65536)
            array.push(bullRtSyms, sym)
        if unpackBit(dtPack, 131072)
            array.push(bearRtSyms, sym)
        if unpackBit(dtPack, 262144)
            array.push(bullContSyms, sym)
        if unpackBit(dtPack, 524288)
            array.push(bearContSyms, sym)

f_get_pos(posStr) =>
    switch posStr
        "Bottom Right"  => position.bottom_right
        "Bottom Center" => position.bottom_center
        "Bottom Left"   => position.bottom_left
        "Top Right"     => position.top_right
        "Top Center"    => position.top_center
        "Top Left"      => position.top_left
        "Middle Left"   => position.middle_left
        => position.middle_right

tablePos = f_get_pos(tablePosStr)

var table dash1 = na
if barstate.islast
    array.clear(symArr)
    array.clear(bullMissileSyms)
    array.clear(bearMissileSyms)
    array.clear(bullScalpSyms)
    array.clear(bearScalpSyms)
    array.clear(bullLightningSyms)
    array.clear(bearLightningSyms)
    array.clear(bullWickSyms)
    array.clear(bearWickSyms)
    array.clear(bullExtremeSyms)
    array.clear(bearExtremeSyms)
    array.clear(bullOutsideSyms)
    array.clear(bearOutsideSyms)
    array.clear(bullDojiSyms)
    array.clear(bearDojiSyms)
    array.clear(bullDivSyms)
    array.clear(bearDivSyms)
    array.clear(bullHDivSyms)
    array.clear(bearHDivSyms)
    array.clear(bullAccSyms)
    array.clear(bearAccSyms)
    array.clear(bullRejSyms)
    array.clear(bearRejSyms)
    array.clear(bullSrdSyms)
    array.clear(bearSrdSyms)
    array.clear(bullOdSyms)
    array.clear(bearOdSyms)
    array.clear(bullFadeSyms)
    array.clear(bearFadeSyms)
    array.clear(bullAbsSyms)
    array.clear(bearAbsSyms)
    array.clear(bullFnlSyms)
    array.clear(bearFnhSyms)
    array.clear(bullFbSyms)
    array.clear(bearFbSyms)
    array.clear(bullRtSyms)
    array.clear(bearRtSyms)
    array.clear(bullContSyms)
    array.clear(bearContSyms)

    f_add(u1, u1_s0, u1_s1, u1_s2, u1_s3, u1_s4, u1_s5, u1_s6, u1_d0, u1_d1, u1_d2, u1_d3, u1_d4, u1_d5, u1_d6)
    f_add(u2, u2_s0, u2_s1, u2_s2, u2_s3, u2_s4, u2_s5, u2_s6, u2_d0, u2_d1, u2_d2, u2_d3, u2_d4, u2_d5, u2_d6)
    f_add(u3, u3_s0, u3_s1, u3_s2, u3_s3, u3_s4, u3_s5, u3_s6, u3_d0, u3_d1, u3_d2, u3_d3, u3_d4, u3_d5, u3_d6)
    f_add(u4, u4_s0, u4_s1, u4_s2, u4_s3, u4_s4, u4_s5, u4_s6, u4_d0, u4_d1, u4_d2, u4_d3, u4_d4, u4_d5, u4_d6)
    f_add(u5, u5_s0, u5_s1, u5_s2, u5_s3, u5_s4, u5_s5, u5_s6, u5_d0, u5_d1, u5_d2, u5_d3, u5_d4, u5_d5, u5_d6)
    f_add(u6, u6_s0, u6_s1, u6_s2, u6_s3, u6_s4, u6_s5, u6_s6, u6_d0, u6_d1, u6_d2, u6_d3, u6_d4, u6_d5, u6_d6)
    f_add(u7, u7_s0, u7_s1, u7_s2, u7_s3, u7_s4, u7_s5, u7_s6, u7_d0, u7_d1, u7_d2, u7_d3, u7_d4, u7_d5, u7_d6)
    f_add(u8, u8_s0, u8_s1, u8_s2, u8_s3, u8_s4, u8_s5, u8_s6, u8_d0, u8_d1, u8_d2, u8_d3, u8_d4, u8_d5, u8_d6)
    f_add(u9, u9_s0, u9_s1, u9_s2, u9_s3, u9_s4, u9_s5, u9_s6, u9_d0, u9_d1, u9_d2, u9_d3, u9_d4, u9_d5, u9_d6)

    txtSize  = tableTextSz == "Tiny" ? size.tiny : tableTextSz == "Normal" ? size.normal : size.small

    dash1 := table.new(tablePos, 3, 21, border_width=1, frame_width=1, frame_color=color.rgb(12, 246, 250))
    
    int currentRow = 0

    // Section 1: SIGNALS
    int activeSignals = 0
    if array.size(bullMissileSyms) > 0 or array.size(bearMissileSyms) > 0
        activeSignals += 1
    if array.size(bullScalpSyms) > 0 or array.size(bearScalpSyms) > 0
        activeSignals += 1
    if array.size(bullLightningSyms) > 0 or array.size(bearLightningSyms) > 0
        activeSignals += 1
    if array.size(bullWickSyms) > 0 or array.size(bearWickSyms) > 0
        activeSignals += 1
    if array.size(bullExtremeSyms) > 0 or array.size(bearExtremeSyms) > 0
        activeSignals += 1
    if array.size(bullOutsideSyms) > 0 or array.size(bearOutsideSyms) > 0
        activeSignals += 1
    if array.size(bullDojiSyms) > 0 or array.size(bearDojiSyms) > 0
        activeSignals += 1
    if array.size(bullDivSyms) > 0 or array.size(bearDivSyms) > 0
        activeSignals += 1
    if array.size(bullHDivSyms) > 0 or array.size(bearHDivSyms) > 0
        activeSignals += 1

    if activeSignals > 0
        table.merge_cells(dash1, 0, currentRow, 2, currentRow)
        table.cell(dash1, 0, currentRow, "TLCS SIGNALS", bgcolor=color.new(#116ac2, 0), text_color=color.rgb(12, 246, 250), text_size=txtSize, text_halign=text.align_right)
        currentRow += 1

        if f_add_row(dash1, currentRow, "Missile", bullMissileSyms, bearMissileSyms, txtSize)
            currentRow += 1
        if f_add_row(dash1, currentRow, "Scalp", bullScalpSyms, bearScalpSyms, txtSize)
            currentRow += 1
        if f_add_row(dash1, currentRow, "Lightning", bullLightningSyms, bearLightningSyms, txtSize)
            currentRow += 1
        if f_add_row(dash1, currentRow, "Wick Reversal", bullWickSyms, bearWickSyms, txtSize)
            currentRow += 1
        if f_add_row(dash1, currentRow, "Extreme Reversal", bullExtremeSyms, bearExtremeSyms, txtSize)
            currentRow += 1
        if f_add_row(dash1, currentRow, "Outside Reversal", bullOutsideSyms, bearOutsideSyms, txtSize)
            currentRow += 1
        if f_add_row(dash1, currentRow, "Doji Reversal", bullDojiSyms, bearDojiSyms, txtSize)
            currentRow += 1
        if f_add_row(dash1, currentRow, "Price Divergences", bullDivSyms, bearDivSyms, txtSize)
            currentRow += 1
        if f_add_row(dash1, currentRow, "Hidden Divergences", bullHDivSyms, bearHDivSyms, txtSize)
            currentRow += 1

    // Section 2: BLUEPRINTS
    int activeBlueprints = 0
    if array.size(bullRejSyms) > 0 or array.size(bearRejSyms) > 0
        activeBlueprints += 1
    if array.size(bullAbsSyms) > 0 or array.size(bearAbsSyms) > 0
        activeBlueprints += 1
    if array.size(bullFnlSyms) > 0 or array.size(bearFnhSyms) > 0
        activeBlueprints += 1
    if array.size(bullOdSyms) > 0 or array.size(bearOdSyms) > 0
        activeBlueprints += 1
    if array.size(bullSrdSyms) > 0 or array.size(bearSrdSyms) > 0
        activeBlueprints += 1

    if activeBlueprints > 0
        table.merge_cells(dash1, 0, currentRow, 2, currentRow)
        table.cell(dash1, 0, currentRow, "DAY TYPE BLUEPRINTS", bgcolor=color.new(#116ac2, 0), text_color=color.rgb(12, 246, 250), text_size=txtSize, text_halign=text.align_right)
        currentRow += 1

        if f_add_row(dash1, currentRow, "Rejection Blueprint", bullRejSyms, bearRejSyms, txtSize)
            currentRow += 1
        if f_add_row(dash1, currentRow, "Absorption Blueprint", bullAbsSyms, bearAbsSyms, txtSize)
            currentRow += 1
        if f_add_row(dash1, currentRow, "Failed New Low/High", bullFnlSyms, bearFnhSyms, txtSize)
            currentRow += 1
        if f_add_row(dash1, currentRow, "Outside Day", bullOdSyms, bearOdSyms, txtSize)
            currentRow += 1
        if f_add_row(dash1, currentRow, "Stop Run Day", bullSrdSyms, bearSrdSyms, txtSize)
            currentRow += 1

    // Section 3: SEQUENCES
    int activeSequences = 0
    if array.size(bullRejSyms) > 0 or array.size(bearRejSyms) > 0
        activeSequences += 1
    if array.size(bullSrdSyms) > 0 or array.size(bearSrdSyms) > 0
        activeSequences += 1
    if (array.size(bullFbSyms) + array.size(bullRtSyms) + array.size(bearFbSyms) + array.size(bearRtSyms)) > 0
        activeSequences += 1
    if array.size(bullAccSyms) > 0 or array.size(bearAccSyms) > 0
        activeSequences += 1

    if activeSequences > 0
        table.merge_cells(dash1, 0, currentRow, 2, currentRow)
        table.cell(dash1, 0, currentRow, "TRADE SEQUENCES", bgcolor=color.rgb(17, 106, 194), text_color=color.rgb(12, 246, 250), text_size=txtSize, text_halign=text.align_right)
        currentRow += 1

        if f_add_row(dash1, currentRow, "Rejection Sequence", bullRejSyms, bearRejSyms, txtSize)
            currentRow += 1
        if f_add_row(dash1, currentRow, "Stop Run Sequence", bullSrdSyms, bearSrdSyms, txtSize)
            currentRow += 1
        if f_add_seq_row(dash1, currentRow, "Failed Absorption Sequence", bullFbSyms, bullRtSyms, bearFbSyms, bearRtSyms, txtSize)
            currentRow += 1
        if f_add_row(dash1, currentRow, "Accumulation Sequence", bullAccSyms, bearAccSyms, txtSize)
            currentRow += 1
