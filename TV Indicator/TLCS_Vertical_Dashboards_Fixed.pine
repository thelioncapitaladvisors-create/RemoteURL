// Lookback Input (Look back up to 7 daily bars)
lookback_days = input.int(7, "Lookback Period (Days)", minval=1, maxval=7, group=gDisplay)

f_get_7d_sigs() =>
    s = f_calc_sigs()
    [s[0], s[1], s[2], s[3], s[4], s[5], s[6]]

f_get_7d_dt() =>
    d = f_calc_packed()
    [d[0], d[1], d[2], d[3], d[4], d[5], d[6]]

[u1_s0, u1_s1, u1_s2, u1_s3, u1_s4, u1_s5, u1_s6] = request.security(u1, "D", f_get_7d_sigs())
[u2_s0, u2_s1, u2_s2, u2_s3, u2_s4, u2_s5, u2_s6] = request.security(u2, "D", f_get_7d_sigs())
