//@version=6
indicator("TLCS Intraday Dashboards", overlay=true, max_labels_count=500)

// =====================================================================================
// PIVOTBOSS UNIFIED SEQUENCE DASHBOARD 
// Tracks the progression of both Rejection Day and Stop Run Day Sequences:
// 1. Rejection Blueprint
// 2. Stop Run Blueprint
// 3. Fade After Stop Run
// 4. Absorption Blueprint
// 5. Failed New Low/High Blueprint
// 6. Failed Breakout (Failed Absorption Sequence)
// 7. Retest After Stop Run (Failed Absorption Sequence)
// 8. Continuation 
// 9. Accumulation / Distribution Sequence
// =====================================================================================

// ---------------------------- SHARED SETTINGS ----------------------------
gShared = "Shared: ATR Lookback"
adrLen = input.int(10, "ATR Lookback (bars)", minval=2, group=gShared)

// ---------------------------- ACCUMULATION / DISTRIBUTION ----------------------------
gAcc = "Accumulation / Distribution"
accLen = input.int(20, "Accumulation Lookback", minval=5, group=gAcc)
accMaxRangeMult = input.float(3.0, "Max Range vs ATR (x)", step=0.1, group=gAcc, tooltip="The total range over the lookback period must be <= this multiple of the ATR")

// ---------------------------- REJECTION FILTER RULES ----------------------------
gRej1 = "Rejection — Range"
adrMultMin = input.float(1.25, "Min Range vs ATR (x)", step=0.05, group=gRej1)

gRej2 = "Rejection — Tail / Body"
tailBodyMult = input.float(2.5, "Min Tail / Body Ratio", step=0.1, group=gRej2)

gRej3 = "Rejection — Close Location"
closeZonePct = input.float(35, "Close within top/bottom X% of range", minval=1, maxval=50, group=gRej3) / 100

gRej4 = "Rejection — Location / Structure"
useStructure = input.bool(true, "Require near prior swing extreme", group=gRej4)
structLen    = input.int(20, "Lookback for prior swing high/low", minval=2, group=gRej4)
structTolPct = input.float(1.0, "Tolerance around prior extreme (%)", step=0.1, group=gRej4) / 100

// ---------------------------- OUTSIDE FILTER RULES ----------------------------
gOd1 = "Outside — Range"
odAdrMultMin = input.float(1.05, "Min Range vs ATR (x)", step=0.05, group=gOd1)

// ---------------------------- FNL / FNH FILTER RULES ----------------------------
gFnl1 = "FNL/FNH — Range"
adrMinPct = input.float(75, "Min Range vs ATR (%)", step=5, group=gFnl1) / 100

gFnl2 = "FNL/FNH — Sweep"
sweepLookback = input.int(1, "Sweep Lookback (bars)", minval=1, maxval=20, group=gFnl2)

gFnl3 = "FNL/FNH — Close Location"
requireAboveYMid = input.bool(true, "Require close above prior MID (FNL) / below prior MID (FNH)", group=gFnl3)

// ---------------------------- ABSORPTION FILTER RULES ----------------------------
gAbs1 = "Absorption — Range"
absAdrMaxMult = input.float(0.75, "Max Range vs ATR (x)", step=0.05, group=gAbs1)

gAbs2 = "Absorption — Location"
absMidTolPct = input.float(1.0, "Tolerance: Low/High near prior MID (%)", step=0.1, group=gAbs2) / 100

gAbs3 = "Absorption — Close Confirmation"
requireBodyConfirm = input.bool(true, "Require body confirmation (Close vs Open)", group=gAbs3)

// ---------------------------- STOP RUN FILTER RULES ----------------------------
gSrd1 = "Stop Run — Range"
srdAdrMultMin = input.float(2.0, "Min Range vs ATR (x)", step=0.1, group=gSrd1)

gSrd2 = "Stop Run — Close Location"
srdCloseZonePct = input.float(15, "Close within top/bottom X% of range", minval=1, maxval=50, group=gSrd2) / 100

gSrd3 = "Stop Run — Structure"
srdStructLen = input.int(5, "Lookback for prior swing high/low for MID check (bars)", minval=1, group=gSrd3)

// ---------------------------- DASHBOARD DISPLAY ----------------------------
gDisplay = "Dashboard Display"
tablePosStr  = input.string("Top Right", "Table Position", options=["Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=gDisplay)
tableTextSz  = input.string("Small", "Table Text Size", options=["Tiny", "Small", "Normal"], group=gDisplay)

// ---------------------------- SYMBOL UNIVERSE: 40 slots across 5 market types ----------------------------
gCrypto = "Crypto (8)"
c1 = input.symbol("BINANCE:BTCUSDT",  "Crypto 1", group=gCrypto)
c2 = input.symbol("BINANCE:ETHUSDT",  "Crypto 2", group=gCrypto)
c3 = input.symbol("BINANCE:SOLUSDT",  "Crypto 3", group=gCrypto)
c4 = input.symbol("BINANCE:BNBUSDT",  "Crypto 4", group=gCrypto)
c5 = input.symbol("BINANCE:XRPUSDT",  "Crypto 5", group=gCrypto)
c6 = input.symbol("BINANCE:ADAUSDT",  "Crypto 6", group=gCrypto)
c7 = input.symbol("BINANCE:DOGEUSDT", "Crypto 7", group=gCrypto)
c8 = input.symbol("BINANCE:AVAXUSDT", "Crypto 8", group=gCrypto)

gStock = "Stocks — NSE (13)"
s1  = input.symbol("NSE:RELIANCE",   "Stock 1",  group=gStock)
s2  = input.symbol("NSE:TCS",        "Stock 2",  group=gStock)
s3  = input.symbol("NSE:HDFCBANK",   "Stock 3",  group=gStock)
s4  = input.symbol("NSE:INFY",       "Stock 4",  group=gStock)
s5  = input.symbol("NSE:ICICIBANK",  "Stock 5",  group=gStock)
s6  = input.symbol("NSE:HINDUNILVR", "Stock 6",  group=gStock)
s7  = input.symbol("NSE:SBIN",       "Stock 7",  group=gStock)
s8  = input.symbol("NSE:BHARTIARTL", "Stock 8",  group=gStock)
s9  = input.symbol("NSE:ITC",        "Stock 9",  group=gStock)
s10 = input.symbol("NSE:KOTAKBANK",  "Stock 10", group=gStock)
s11 = input.symbol("NSE:LT",         "Stock 11", group=gStock)
s12 = input.symbol("NSE:AXISBANK",   "Stock 12", group=gStock)
s13 = input.symbol("NSE:MARUTI",     "Stock 13", group=gStock)

gForex = "Forex (7)"
f1 = input.symbol("FX:EURUSD", "Forex 1", group=gForex)
f2 = input.symbol("FX:GBPUSD", "Forex 2", group=gForex)
f3 = input.symbol("FX:USDJPY", "Forex 3", group=gForex)
f4 = input.symbol("FX:USDCHF", "Forex 4", group=gForex)
f5 = input.symbol("FX:AUDUSD", "Forex 5", group=gForex)
f6 = input.symbol("FX:USDCAD", "Forex 6", group=gForex)
f7 = input.symbol("FX:NZDUSD", "Forex 7", group=gForex)

gIndex = "Indices (6)"
i1 = input.symbol("SP:SPX",     "Index 1", group=gIndex)
i2 = input.symbol("NASDAQ:NDX", "Index 2", group=gIndex)
i3 = input.symbol("DJ:DJI",     "Index 3", group=gIndex)
i4 = input.symbol("TVC:UKX",    "Index 4", group=gIndex)
i5 = input.symbol("TVC:NI225",  "Index 5", group=gIndex)
i6 = input.symbol("TVC:HSI",    "Index 6", group=gIndex)

gFutures = "Futures — NYMEX (6)"
u1 = input.symbol("NYMEX:CL1!", "Futures 1", group=gFutures)
u2 = input.symbol("NYMEX:NG1!", "Futures 2", group=gFutures)
u3 = input.symbol("NYMEX:HO1!", "Futures 3", group=gFutures)
u4 = input.symbol("NYMEX:RB1!", "Futures 4", group=gFutures)
u5 = input.symbol("NYMEX:PL1!", "Futures 5", group=gFutures)
u6 = input.symbol("NYMEX:PA1!", "Futures 6", group=gFutures)

// ---------------------------- SEQUENCE CALC ----------------------------
f_calc() =>
    var int cached_encoded = 0
    var bool initial_calc = true
    if barstate.isrealtime and not barstate.isconfirmed and not initial_calc
        cached_encoded
    else
        initial_calc := false
        rng    = high - low
        body   = math.abs(close - open)
        upWick = high - math.max(open, close)
        dnWick = math.min(open, close) - low
        mid    = (high + low) / 2

        avgRange = ta.sma(ta.tr(true), adrLen)[1]
        closePos = rng != 0 ? (close - low) / rng : 0.5

        // ---- 0. Accumulation / Distribution Phase ----
        accHigh = ta.highest(high, accLen)
        accLow  = ta.lowest(low, accLen)
        accRange = accHigh - accLow
        isCompressing = avgRange > 0 and accRange <= accMaxRangeMult * avgRange
    
        bullAcc = isCompressing and close >= (accHigh + accLow) / 2
        bearDist = isCompressing and close < (accHigh + accLow) / 2

        // ---- 1. Rejection Trigger ----
        rejRangeOK  = avgRange > 0 and rng > adrMultMin * avgRange
        bullTailOK  = body > 0 ? dnWick > tailBodyMult * body : dnWick > 0
        bearTailOK  = body > 0 ? upWick > tailBodyMult * body : upWick > 0
        bullCloseOK = closePos >= (1 - closeZonePct)
        bearCloseOK = closePos <= closeZonePct

        priorLowStruct  = ta.lowest(low, structLen)[1]
        priorHighStruct = ta.highest(high, structLen)[1]
        nearPriorLow  = low  <= priorLowStruct  * (1 + structTolPct)
        nearPriorHigh = high >= priorHighStruct * (1 - structTolPct)
        structBullOK = not useStructure or nearPriorLow
        structBearOK = not useStructure or nearPriorHigh

        bullRej = rejRangeOK and bullTailOK and bullCloseOK and structBullOK
        bearRej = rejRangeOK and bearTailOK and bearCloseOK and structBearOK

        // ---- 2. Stop Run Trigger ----
        srdRangeOK = avgRange > 0 and rng > srdAdrMultMin * avgRange
    
        bullSrdClosePosOK = closePos >= (1 - srdCloseZonePct)
        bullSrdCloseExt   = close > high[1]
        bullSrdMidExt     = mid >= ta.highest(high, srdStructLen)[1]
        bullSrdSignal     = srdRangeOK and bullSrdClosePosOK and bullSrdCloseExt and bullSrdMidExt

        bearSrdClosePosOK = closePos <= srdCloseZonePct
        bearSrdCloseExt   = close < low[1]
        bearSrdMidExt     = mid <= ta.lowest(low, srdStructLen)[1]
        bearSrdSignal     = srdRangeOK and bearSrdClosePosOK and bearSrdCloseExt and bearSrdMidExt

        // ---- STATE TRACKING: REJECTION SEQUENCE & FAILED ABSORPTION ----
        var float rejActiveMid   = na
        var float rejActiveHigh  = na
        var float rejActiveLow   = na
        var bool  bullRejActive  = false
        var bool  bearRejActive  = false

        var bool  bullFailedAbsActive = false
        var bool  bearFailedAbsActive = false

        int barsSinceRej = ta.barssince(bullRej or bearRej)

        if bullRej
            rejActiveMid  := mid
            rejActiveHigh := high
            rejActiveLow  := low
            bullRejActive := true
            bearRejActive := false
            bullFailedAbsActive := false
            bearFailedAbsActive := false
        else if bearRej
            rejActiveMid  := mid
            rejActiveHigh := high
            rejActiveLow  := low
            bearRejActive := true
            bullRejActive := false
            bullFailedAbsActive := false
            bearFailedAbsActive := false

        // Check Rejection Failure -> triggers Failed Absorption Context
        if bullRejActive and close < rejActiveMid
            bullRejActive := false
            bearFailedAbsActive := true
        if bearRejActive and close > rejActiveMid
            bearRejActive := false
            bullFailedAbsActive := true

        // Invalidate Failed Absorption Context
        if bearFailedAbsActive and close > rejActiveHigh
            bearFailedAbsActive := false
        if bullFailedAbsActive and close < rejActiveLow
            bullFailedAbsActive := false

        // ---- STATE TRACKING: STOP RUN SEQUENCE ----
        var float srdActiveMid   = na
        var float srdActiveExt   = na
        var bool  bullSrdActive  = false
        var bool  bearSrdActive  = false

        int barsSinceSrd = ta.barssince(bullSrdSignal or bearSrdSignal)

        if bullSrdSignal
            srdActiveMid  := mid
            srdActiveExt  := high
            bullSrdActive := true
            bearSrdActive := false
        else if bearSrdSignal
            srdActiveMid  := mid
            srdActiveExt  := low
            bearSrdActive := true
            bullSrdActive := false

        if bullSrdActive and close < srdActiveMid
            bullSrdActive := false
        if bearSrdActive and close > srdActiveMid
            bearSrdActive := false

        // ---- 3. Fade After Stop Run (Applies to SRD Sequence Only) ----
        bullFade = bullSrdActive and not na(barsSinceSrd) and barsSinceSrd > 0 and high >= srdActiveExt * 0.995 and close < open
        bearFade = bearSrdActive and not na(barsSinceSrd) and barsSinceSrd > 0 and low <= srdActiveExt * 1.005 and close > open

        // ---- 4. Absorption (Applies to Rej and SRD sequences) ----
        absRangeOK = avgRange > 0 and rng < absAdrMaxMult * avgRange

        bullAbs_Rej = bullRejActive and not na(barsSinceRej) and barsSinceRej > 0 and absRangeOK and close > rejActiveMid and (not requireBodyConfirm or close > open) and math.abs(low - rejActiveMid) <= rejActiveMid * absMidTolPct
        bearAbs_Rej = bearRejActive and not na(barsSinceRej) and barsSinceRej > 0 and absRangeOK and close < rejActiveMid and (not requireBodyConfirm or close < open) and math.abs(high - rejActiveMid) <= rejActiveMid * absMidTolPct

        bullAbs_Srd = bullSrdActive and not na(barsSinceSrd) and barsSinceSrd > 0 and absRangeOK and close > srdActiveMid and (not requireBodyConfirm or close > open) and math.abs(low - srdActiveMid) <= srdActiveMid * absMidTolPct
        bearAbs_Srd = bearSrdActive and not na(barsSinceSrd) and barsSinceSrd > 0 and absRangeOK and close < srdActiveMid and (not requireBodyConfirm or close < open) and math.abs(high - srdActiveMid) <= srdActiveMid * absMidTolPct

        // ---- X. Outside ----
        odRangeOK = avgRange > 0 and rng > odAdrMultMin * avgRange
        odBull = odRangeOK and low < low[1] and close > high[1]
        odBear = odRangeOK and high > high[1] and close < low[1]

        // ---- 5. FNL / FNH (Applies to both sequences) ----
        fnlRangeOK = avgRange > 0 and rng >= adrMinPct * avgRange
        priorLowSweep  = ta.lowest(low, sweepLookback)[1]
        priorHighSweep = ta.highest(high, sweepLookback)[1]
        yMidFnl = (high[1] + low[1]) / 2.0

        fnlSweep  = low < priorLowSweep
        fnlClose  = requireAboveYMid ? close > yMidFnl : close > mid
        fnlSignal = fnlRangeOK and fnlSweep and fnlClose

        fnhSweep  = high > priorHighSweep
        fnhClose  = requireAboveYMid ? close < yMidFnl : close < mid
        fnhSignal = fnlRangeOK and fnhSweep and fnhClose

        bullFnl_Rej = bullRejActive and not na(barsSinceRej) and barsSinceRej > 0 and fnlSignal
        bearFnh_Rej = bearRejActive and not na(barsSinceRej) and barsSinceRej > 0 and fnhSignal
    
        bullFnl_Srd = bullSrdActive and not na(barsSinceSrd) and barsSinceSrd > 0 and fnlSignal
        bearFnh_Srd = bearSrdActive and not na(barsSinceSrd) and barsSinceSrd > 0 and fnhSignal

        unifiedBullFnl = bullFnl_Rej or bullFnl_Srd
        unifiedBearFnh = bearFnh_Rej or bearFnh_Srd

        // ---- 6. Failed Breakout (Applies to Failed Absorption Context) ----
        int barsSinceFa = ta.barssince(bullFailedAbsActive or bearFailedAbsActive)
        bullFailedBreakout = bullFailedAbsActive and not na(barsSinceFa) and barsSinceFa > 0 and low <= low[1] and close > open
        bearFailedBreakout = bearFailedAbsActive and not na(barsSinceFa) and barsSinceFa > 0 and high >= high[1] and close < open

        // ---- 7. Retest After Stop Run (Applies to Failed Absorption Context) ----
        bullRetestAfterSrd = bullFailedAbsActive and (bullFade or bullAbs_Srd)
        bearRetestAfterSrd = bearFailedAbsActive and (bearFade or bearAbs_Srd)

        // Mask Retest days out of the standard Fade/Abs rows for cleaner dashboard reporting
        bullFade_final = bullFade and not bullRetestAfterSrd
        bearFade_final = bearFade and not bearRetestAfterSrd
    
        unifiedBullAbs = bullAbs_Rej or (bullAbs_Srd and not bullRetestAfterSrd)
        unifiedBearAbs = bearAbs_Rej or (bearAbs_Srd and not bearRetestAfterSrd)

        // ---- 8. Continuation ----
        var bool prevActiveDayBull = false
        var bool prevActiveDayBear = false
    
        bullCont = prevActiveDayBull and close > close[1]
        bearCont = prevActiveDayBear and close < close[1]
    
        prevActiveDayBull := bullRej or bullSrdSignal or unifiedBullAbs or fnlSignal or bullFailedBreakout or bullRetestAfterSrd
        prevActiveDayBear := bearRej or bearSrdSignal or unifiedBearAbs or fnhSignal or bearFailedBreakout or bearRetestAfterSrd

        // Return single integer encoded with all booleans to bypass memory limits
        int encoded = 0
        encoded += bullAcc ? 1 : 0
        encoded += bearDist ? 2 : 0
        encoded += bullRej ? 4 : 0
        encoded += bearRej ? 8 : 0
        encoded += bullSrdSignal ? 16 : 0
        encoded += bearSrdSignal ? 32 : 0
        encoded += odBull ? 64 : 0
        encoded += odBear ? 128 : 0
        encoded += bullFade_final ? 256 : 0
        encoded += bearFade_final ? 512 : 0
        encoded += unifiedBullAbs ? 1024 : 0
        encoded += unifiedBearAbs ? 2048 : 0
        encoded += fnlSignal ? 4096 : 0
        encoded += fnhSignal ? 8192 : 0
        encoded += bullFailedBreakout ? 16384 : 0
        encoded += bearFailedBreakout ? 32768 : 0
        encoded += bullRetestAfterSrd ? 65536 : 0
        encoded += bearRetestAfterSrd ? 131072 : 0
        encoded += bullCont ? 262144 : 0
        encoded += bearCont ? 524288 : 0
        cached_encoded := encoded
        encoded

f_decode(int val) =>
    int temp = val
    acB = (temp % 2) != 0
    temp := math.floor(temp / 2)
    acS = (temp % 2) != 0
    temp := math.floor(temp / 2)
    rB  = (temp % 2) != 0
    temp := math.floor(temp / 2)
    rS  = (temp % 2) != 0
    temp := math.floor(temp / 2)
    sB  = (temp % 2) != 0
    temp := math.floor(temp / 2)
    sS  = (temp % 2) != 0
    temp := math.floor(temp / 2)
    odB = (temp % 2) != 0
    temp := math.floor(temp / 2)
    odS = (temp % 2) != 0
    temp := math.floor(temp / 2)
    fdB = (temp % 2) != 0
    temp := math.floor(temp / 2)
    fdS = (temp % 2) != 0
    temp := math.floor(temp / 2)
    aB  = (temp % 2) != 0
    temp := math.floor(temp / 2)
    aS  = (temp % 2) != 0
    temp := math.floor(temp / 2)
    fB  = (temp % 2) != 0
    temp := math.floor(temp / 2)
    fS  = (temp % 2) != 0
    temp := math.floor(temp / 2)
    fbB = (temp % 2) != 0
    temp := math.floor(temp / 2)
    fbS = (temp % 2) != 0
    temp := math.floor(temp / 2)
    rtB = (temp % 2) != 0
    temp := math.floor(temp / 2)
    rtS = (temp % 2) != 0
    temp := math.floor(temp / 2)
    cB  = (temp % 2) != 0
    temp := math.floor(temp / 2)
    cS  = (temp % 2) != 0
    temp := math.floor(temp / 2)
    [acB, acS, rB, rS, sB, sS, odB, odS, fdB, fdS, aB, aS, fB, fS, fbB, fbS, rtB, rtS, cB, cS]

// ---------------------------- 40 SECURITY CALLS ----------------------------
[c1acB, c1acS, c1rB, c1rS, c1sB, c1sS, c1odB, c1odS, c1fdB, c1fdS, c1aB, c1aS, c1fB, c1fS, c1fbB, c1fbS, c1rtB, c1rtS, c1cB, c1cS] = f_decode(request.security(c1, timeframe.period, f_calc()))
[c2acB, c2acS, c2rB, c2rS, c2sB, c2sS, c2odB, c2odS, c2fdB, c2fdS, c2aB, c2aS, c2fB, c2fS, c2fbB, c2fbS, c2rtB, c2rtS, c2cB, c2cS] = f_decode(request.security(c2, timeframe.period, f_calc()))
[c3acB, c3acS, c3rB, c3rS, c3sB, c3sS, c3odB, c3odS, c3fdB, c3fdS, c3aB, c3aS, c3fB, c3fS, c3fbB, c3fbS, c3rtB, c3rtS, c3cB, c3cS] = f_decode(request.security(c3, timeframe.period, f_calc()))
[c4acB, c4acS, c4rB, c4rS, c4sB, c4sS, c4odB, c4odS, c4fdB, c4fdS, c4aB, c4aS, c4fB, c4fS, c4fbB, c4fbS, c4rtB, c4rtS, c4cB, c4cS] = f_decode(request.security(c4, timeframe.period, f_calc()))
[c5acB, c5acS, c5rB, c5rS, c5sB, c5sS, c5odB, c5odS, c5fdB, c5fdS, c5aB, c5aS, c5fB, c5fS, c5fbB, c5fbS, c5rtB, c5rtS, c5cB, c5cS] = f_decode(request.security(c5, timeframe.period, f_calc()))
[c6acB, c6acS, c6rB, c6rS, c6sB, c6sS, c6odB, c6odS, c6fdB, c6fdS, c6aB, c6aS, c6fB, c6fS, c6fbB, c6fbS, c6rtB, c6rtS, c6cB, c6cS] = f_decode(request.security(c6, timeframe.period, f_calc()))
[c7acB, c7acS, c7rB, c7rS, c7sB, c7sS, c7odB, c7odS, c7fdB, c7fdS, c7aB, c7aS, c7fB, c7fS, c7fbB, c7fbS, c7rtB, c7rtS, c7cB, c7cS] = f_decode(request.security(c7, timeframe.period, f_calc()))
[c8acB, c8acS, c8rB, c8rS, c8sB, c8sS, c8odB, c8odS, c8fdB, c8fdS, c8aB, c8aS, c8fB, c8fS, c8fbB, c8fbS, c8rtB, c8rtS, c8cB, c8cS] = f_decode(request.security(c8, timeframe.period, f_calc()))

[s1acB, s1acS, s1rB, s1rS, s1sB, s1sS, s1odB, s1odS, s1fdB, s1fdS, s1aB, s1aS, s1fB, s1fS, s1fbB, s1fbS, s1rtB, s1rtS, s1cB, s1cS]     = f_decode(request.security(s1, timeframe.period, f_calc()))
[s2acB, s2acS, s2rB, s2rS, s2sB, s2sS, s2odB, s2odS, s2fdB, s2fdS, s2aB, s2aS, s2fB, s2fS, s2fbB, s2fbS, s2rtB, s2rtS, s2cB, s2cS]     = f_decode(request.security(s2, timeframe.period, f_calc()))
[s3acB, s3acS, s3rB, s3rS, s3sB, s3sS, s3odB, s3odS, s3fdB, s3fdS, s3aB, s3aS, s3fB, s3fS, s3fbB, s3fbS, s3rtB, s3rtS, s3cB, s3cS]     = f_decode(request.security(s3, timeframe.period, f_calc()))
[s4acB, s4acS, s4rB, s4rS, s4sB, s4sS, s4odB, s4odS, s4fdB, s4fdS, s4aB, s4aS, s4fB, s4fS, s4fbB, s4fbS, s4rtB, s4rtS, s4cB, s4cS]     = f_decode(request.security(s4, timeframe.period, f_calc()))
[s5acB, s5acS, s5rB, s5rS, s5sB, s5sS, s5odB, s5odS, s5fdB, s5fdS, s5aB, s5aS, s5fB, s5fS, s5fbB, s5fbS, s5rtB, s5rtS, s5cB, s5cS]     = f_decode(request.security(s5, timeframe.period, f_calc()))
