f_add(u5, u5acB, u5acS, u5rB, u5rS, u5sB, u5sS, u5odB, u5odS, u5fdB, u5fdS, u5aB, u5aS, u5fB, u5fS, u5fbB, u5fbS, u5rtB, u5rtS, u5cB, u5cS)
f_add(u6, u6acB, u6acS, u6rB, u6rS, u6sB, u6sS, u6odB, u6odS, u6fdB, u6fdS, u6aB, u6aS, u6fB, u6fS, u6fbB, u6fbS, u6rtB, u6rtS, u6cB, u6cS)

// ---------------------------- ANY-SIGNAL FLAGS FOR ALERTS ----------------------------
anyBullAcc  = false, anyBearAcc  = false
anyBullRej  = false, anyBearRej  = false
anyBullSrd  = false, anyBearSrd  = false
anyBullOd  = false, anyBearOd  = false
anyBullFade = false, anyBearFade = false
anyBullAbs  = false, anyBearAbs  = false
anyBullFnl  = false, anyBearFnh  = false
anyBullFb   = false, anyBearFb   = false
anyBullRt   = false, anyBearRt   = false
anyBullCont = false, anyBearCont = false

for idx = 0 to array.size(symArr) - 1
    anyBullAcc  := anyBullAcc  or array.get(bullAccArr, idx)
    anyBearAcc  := anyBearAcc  or array.get(bearAccArr, idx)
    anyBullRej  := anyBullRej  or array.get(bullRejArr, idx)
    anyBearRej  := anyBearRej  or array.get(bearRejArr, idx)
    anyBullSrd  := anyBullSrd  or array.get(bullSrdArr, idx)
    anyBearSrd  := anyBearSrd  or array.get(bearSrdArr, idx)
    anyBullOd   := anyBullOd   or array.get(bullOdArr, idx)
    anyBearOd   := anyBearOd   or array.get(bearOdArr, idx)
    anyBullFade := anyBullFade or array.get(bullFadeArr, idx)
    anyBearFade := anyBearFade or array.get(bearFadeArr, idx)
    anyBullAbs  := anyBullAbs  or array.get(bullAbsArr, idx)
    anyBearAbs  := anyBearAbs  or array.get(bearAbsArr, idx)
    anyBullFnl  := anyBullFnl  or array.get(bullFnlArr, idx)
    anyBearFnh  := anyBearFnh  or array.get(bearFnhArr, idx)
    anyBullFb   := anyBullFb   or array.get(bullFbArr, idx)
    anyBearFb   := anyBearFb   or array.get(bearFbArr, idx)
    anyBullRt   := anyBullRt   or array.get(bullRtArr, idx)
    anyBearRt   := anyBearRt   or array.get(bearRtArr, idx)
    anyBullCont := anyBullCont or array.get(bullContArr, idx)
    anyBearCont := anyBearCont or array.get(bearContArr, idx)

// ---------------------------- DASHBOARD TABLE ----------------------------
var bool is_initial_draw = true
if barstate.islast and (barstate.isconfirmed or is_initial_draw)
    is_initial_draw := false
    tablePos = tablePosStr == "Top Right" ? position.top_right : tablePosStr == "Top Left" ? position.top_left : tablePosStr == "Bottom Right" ? position.bottom_right : position.middle_left
    txtSize  = tableTextSz == "Tiny" ? size.tiny : tableTextSz == "Normal" ? size.normal : size.small

    bullAccList = "", bearAccList = ""
    bullRejList = "", bearRejList = ""
    bullSrdList = "", bearSrdList = ""
    bullOdList  = "", bearOdList  = ""
    bullFadeList= "", bearFadeList= ""
    bullAbsList = "", bearAbsList = ""
    bullFnlList = "", bearFnhList = ""
    bullFbList  = "", bearFbList  = ""
    bullRtList  = "", bearRtList  = ""
    bullContList= "", bearContList= ""
    
    bullAccCount = 0, bearAccCount = 0
    bullRejCount = 0, bearRejCount = 0
    bullSrdCount = 0, bearSrdCount = 0
    bullOdCount = 0, bearOdCount = 0
    bullFadeCount= 0, bearFadeCount= 0
    bullAbsCount = 0, bearAbsCount = 0
    bullFnlCount = 0, bearFnhCount = 0
    bullFbCount  = 0, bearFbCount  = 0
    bullRtCount  = 0, bearRtCount  = 0
    bullContCount= 0, bearContCount= 0

    for idx = 0 to array.size(symArr) - 1
        sym = array.get(symArr, idx)
        splitSym = str.split(sym, ":")
        cleanSym = array.size(splitSym) > 1 ? array.get(splitSym, 1) : sym
        
        if array.get(bullAccArr, idx)
            bullAccList += (bullAccList == "" ? "" : ", ") + cleanSym
            bullAccCount += 1
        if array.get(bearAccArr, idx)
            bearAccList += (bearAccList == "" ? "" : ", ") + cleanSym
            bearAccCount += 1
            
        if array.get(bullRejArr, idx)
            bullRejList += (bullRejList == "" ? "" : ", ") + cleanSym
            bullRejCount += 1
        if array.get(bearRejArr, idx)
            bearRejList += (bearRejList == "" ? "" : ", ") + cleanSym
            bearRejCount += 1
            
        if array.get(bullSrdArr, idx)
            bullSrdList += (bullSrdList == "" ? "" : ", ") + cleanSym
            bullSrdCount += 1
        if array.get(bearSrdArr, idx)
            bearSrdList += (bearSrdList == "" ? "" : ", ") + cleanSym
            bearSrdCount += 1
            
        if array.get(bullOdArr, idx)
            bullOdList += (bullOdList == "" ? "" : ", ") + cleanSym
            bullOdCount += 1
        if array.get(bearOdArr, idx)
            bearOdList += (bearOdList == "" ? "" : ", ") + cleanSym
            bearOdCount += 1
            
        if array.get(bullFadeArr, idx)
            bullFadeList += (bullFadeList == "" ? "" : ", ") + cleanSym
            bullFadeCount += 1
        if array.get(bearFadeArr, idx)
            bearFadeList += (bearFadeList == "" ? "" : ", ") + cleanSym
            bearFadeCount += 1
            
        if array.get(bullAbsArr, idx)
            bullAbsList += (bullAbsList == "" ? "" : ", ") + cleanSym
            bullAbsCount += 1
        if array.get(bearAbsArr, idx)
            bearAbsList += (bearAbsList == "" ? "" : ", ") + cleanSym
            bearAbsCount += 1
            
        if array.get(bullFnlArr, idx)
            bullFnlList += (bullFnlList == "" ? "" : ", ") + cleanSym
            bullFnlCount += 1
        if array.get(bearFnhArr, idx)
            bearFnhList += (bearFnhList == "" ? "" : ", ") + cleanSym
            bearFnhCount += 1
            
        if array.get(bullFbArr, idx)
            bullFbList += (bullFbList == "" ? "" : ", ") + cleanSym
            bullFbCount += 1
        if array.get(bearFbArr, idx)
            bearFbList += (bearFbList == "" ? "" : ", ") + cleanSym
            bearFbCount += 1
            
        if array.get(bullRtArr, idx)
            bullRtList += (bullRtList == "" ? "" : ", ") + cleanSym
            bullRtCount += 1
        if array.get(bearRtArr, idx)
            bearRtList += (bearRtList == "" ? "" : ", ") + cleanSym
            bearRtCount += 1
            
        if array.get(bullContArr, idx)
            bullContList += (bullContList == "" ? "" : ", ") + cleanSym
            bullContCount += 1
        if array.get(bearContArr, idx)
            bearContList += (bearContList == "" ? "" : ", ") + cleanSym
            bearContCount += 1

    // Setup Table 1: Blueprints (Dynamic active rows)
    int activeRows1 = (bullRejCount > 0 or bearRejCount > 0 ? 1 : 0) + 
                      (bullAbsCount > 0 or bearAbsCount > 0 ? 1 : 0) + 
                      (bullFnlCount > 0 or bearFnhCount > 0 ? 1 : 0) + 
                      (bullOdCount  > 0 or bearOdCount  > 0 ? 1 : 0) + 
                      (bullSrdCount > 0 or bearSrdCount > 0 ? 1 : 0)

    dash1 = table.new(tablePosStr == "Bottom center" ? position.middle_left : tablePosStr == "Top Left" ? position.top_left : tablePosStr == "Bottom Right" ? position.bottom_right : position.middle_left, 3, math.max(1, activeRows1) + 1, border_width=1, frame_width=1, frame_color=color.rgb(12, 246, 250))

    headerTxt1 = "INTRADAY BLUEPRINTS (" + str.tostring(array.size(symArr)) + ")"
    table.merge_cells(dash1, 0, 0, 2, 0)
    table.cell(dash1, 0, 0, headerTxt1, bgcolor=color.new(#116ac2, 0), text_color=#23fbff, text_size=txtSize)

    int rowIdx1 = 1

    if bullRejCount > 0 or bearRejCount > 0
        table.cell(dash1, 0, rowIdx1, "1. Rejection Blueprint", bgcolor=color.rgb(249, 226, 23, 87), text_color=color.rgb(10, 65, 230), text_size=txtSize)
        table.cell(dash1, 1, rowIdx1, bullRejCount > 0 ? "▲ " + str.tostring(bullRejCount) + "\n" + bullRejList : "-", bgcolor=bullRejCount > 0 ? color.new(color.lime, 78) : color.new(color.gray, 85), text_color=bullRejCount > 0 ? color.rgb(19, 65, 43) : color.gray, text_size=txtSize)
        table.cell(dash1, 2, rowIdx1, bearRejCount > 0 ? "▼ " + str.tostring(bearRejCount) + "\n" + bearRejList : "-", bgcolor=bearRejCount > 0 ? color.new(color.red, 78) : color.new(color.gray, 85), text_color=bearRejCount > 0 ? color.red : color.gray, text_size=txtSize)
        rowIdx1 := rowIdx1 + 1

    if bullAbsCount > 0 or bearAbsCount > 0
        table.cell(dash1, 0, rowIdx1, "2. Absorption Blueprint", bgcolor=color.rgb(249, 226, 23, 87), text_color=color.rgb(10, 65, 230), text_size=txtSize)
        table.cell(dash1, 1, rowIdx1, bullAbsCount > 0 ? "▲ " + str.tostring(bullAbsCount) + "\n" + bullAbsList : "-", bgcolor=bullAbsCount > 0 ? color.new(color.lime, 78) : color.new(color.gray, 85), text_color=bullAbsCount > 0 ? color.rgb(19, 65, 43) : color.gray, text_size=txtSize)
        table.cell(dash1, 2, rowIdx1, bearAbsCount > 0 ? "▼ " + str.tostring(bearAbsCount) + "\n" + bearAbsList : "-", bgcolor=bearAbsCount > 0 ? color.new(color.red, 78) : color.new(color.gray, 85), text_color=bearAbsCount > 0 ? color.red : color.gray, text_size=txtSize)
        rowIdx1 := rowIdx1 + 1

    if bullFnlCount > 0 or bearFnhCount > 0
        table.cell(dash1, 0, rowIdx1, "3. Failed New Low Blueprint", bgcolor=color.rgb(249, 226, 23, 87), text_color=color.rgb(10, 65, 230), text_size=txtSize)
        table.cell(dash1, 1, rowIdx1, bullFnlCount > 0 ? "▲ " + str.tostring(bullFnlCount) + "\n" + bullFnlList : "-", bgcolor=bullFnlCount > 0 ? color.new(color.lime, 78) : color.new(color.gray, 85), text_color=bullFnlCount > 0 ? color.rgb(19, 65, 43) : color.gray, text_size=txtSize)
        table.cell(dash1, 2, rowIdx1, bearFnhCount > 0 ? "▼ " + str.tostring(bearFnhCount) + "\n" + bearFnhList : "-", bgcolor=bearFnhCount > 0 ? color.new(color.red, 78) : color.new(color.gray, 85), text_color=bearFnhCount > 0 ? color.red : color.gray, text_size=txtSize)
        rowIdx1 := rowIdx1 + 1

    if bullOdCount > 0 or bearOdCount > 0
        table.cell(dash1, 0, rowIdx1, "4. Outside Blueprint", bgcolor=color.rgb(249, 226, 23, 87), text_color=color.rgb(10, 65, 230), text_size=txtSize)
        table.cell(dash1, 1, rowIdx1, bullOdCount > 0 ? "▲ " + str.tostring(bullOdCount) + "\n" + bullOdList : "-", bgcolor=bullOdCount > 0 ? color.new(color.lime, 78) : color.new(color.gray, 85), text_color=bullOdCount > 0 ? color.rgb(19, 65, 43) : color.gray, text_size=txtSize)
        table.cell(dash1, 2, rowIdx1, bearOdCount > 0 ? "▼ " + str.tostring(bearOdCount) + "\n" + bearOdList : "-", bgcolor=bearOdCount > 0 ? color.new(color.red, 78) : color.new(color.gray, 85), text_color=bearOdCount > 0 ? color.red : color.gray, text_size=txtSize)
        rowIdx1 := rowIdx1 + 1

    if bullSrdCount > 0 or bearSrdCount > 0
        table.cell(dash1, 0, rowIdx1, "5. Stop Run Blueprint", bgcolor=color.rgb(249, 226, 23, 87), text_color=color.rgb(10, 65, 230), text_size=txtSize)
        table.cell(dash1, 1, rowIdx1, bullSrdCount > 0 ? "▲ " + str.tostring(bullSrdCount) + "\n" + bullSrdList : "-", bgcolor=bullSrdCount > 0 ? color.new(color.lime, 78) : color.new(color.gray, 85), text_color=bullSrdCount > 0 ? color.rgb(19, 65, 43) : color.gray, text_size=txtSize)
        table.cell(dash1, 2, rowIdx1, bearSrdCount > 0 ? "▼ " + str.tostring(bearSrdCount) + "\n" + bearSrdList : "-", bgcolor=bearSrdCount > 0 ? color.new(color.red, 78) : color.new(color.gray, 85), text_color=bearSrdCount > 0 ? color.red : color.gray, text_size=txtSize)
        rowIdx1 := rowIdx1 + 1

    if activeRows1 == 0
        table.merge_cells(dash1, 0, 1, 2, 1)
        table.cell(dash1, 0, 1, "No Active Blueprints Found", bgcolor=color.new(color.gray, 85), text_color=color.gray, text_size=txtSize)

    // Setup Table 2: Trade Sequences (Dynamic active rows)
    int activeRows2 = (bullRejCount > 0 or bearRejCount > 0 ? 1 : 0) + 
                      (bullSrdCount > 0 or bearSrdCount > 0 ? 1 : 0) + 
                      ((bullFbCount + bullRtCount) > 0 or (bearFbCount + bearRtCount) > 0 ? 1 : 0) + 
                      (bullAccCount > 0 or bearAccCount > 0 ? 1 : 0)

    dash2 = table.new(tablePosStr == "Bottom center" ? position.middle_right : tablePosStr == "Top Left" ? position.bottom_left : tablePosStr == "Bottom Right" ? position.top_right : position.middle_right, 3, math.max(1, activeRows2) + 1, border_width=1, frame_width=1,  frame_color=color.rgb(12, 246, 250))

    headerTxt2 = "INTRADAY TRADE SEQUENCES (" + str.tostring(array.size(symArr)) + ")"
    table.merge_cells(dash2, 0, 0, 2, 0)
    table.cell(dash2, 0, 0, headerTxt2, bgcolor=#8b047b, text_color=color.rgb(12, 246, 250), text_size=txtSize)

    int rowIdx2 = 1

    if bullRejCount > 0 or bearRejCount > 0
        table.cell(dash2, 0, rowIdx2, "1. Rejection Sequence", bgcolor=color.rgb(249, 226, 23, 87), text_color=color.rgb(10, 65, 230), text_size=txtSize)
        table.cell(dash2, 1, rowIdx2, bullRejCount > 0 ? "▲ " + str.tostring(bullRejCount) + "\n" + bullRejList : "-", bgcolor=bullRejCount > 0 ? color.new(color.lime, 78) : color.new(color.gray, 85), text_color=bullRejCount > 0 ? color.rgb(19, 65, 43) : color.gray, text_size=txtSize)
        table.cell(dash2, 2, rowIdx2, bearRejCount > 0 ? "▼ " + str.tostring(bearRejCount) + "\n" + bearRejList : "-", bgcolor=bearRejCount > 0 ? color.new(color.red, 78) : color.new(color.gray, 85), text_color=bearRejCount > 0 ? color.red : color.gray, text_size=txtSize)
        rowIdx2 := rowIdx2 + 1

    if bullSrdCount > 0 or bearSrdCount > 0
        table.cell(dash2, 0, rowIdx2, "2. Stop Run Sequence", bgcolor=color.rgb(249, 226, 23, 87), text_color=color.rgb(10, 65, 230), text_size=txtSize)
        table.cell(dash2, 1, rowIdx2, bullSrdCount > 0 ? "▲ " + str.tostring(bullSrdCount) + "\n" + bullSrdList : "-", bgcolor=bullSrdCount > 0 ? color.new(color.lime, 78) : color.new(color.gray, 85), text_color=bullSrdCount > 0 ? color.rgb(19, 65, 43) : color.gray, text_size=txtSize)
        table.cell(dash2, 2, rowIdx2, bearSrdCount > 0 ? "▼ " + str.tostring(bearSrdCount) + "\n" + bearSrdList : "-", bgcolor=bearSrdCount > 0 ? color.new(color.red, 78) : color.new(color.gray, 85), text_color=bearSrdCount > 0 ? color.red : color.gray, text_size=txtSize)
        rowIdx2 := rowIdx2 + 1

    if (bullFbCount + bullRtCount) > 0 or (bearFbCount + bearRtCount) > 0
        table.cell(dash2, 0, rowIdx2, "3. Failed Absorption Sequence", bgcolor=color.rgb(249, 226, 23, 87), text_color=color.rgb(10, 65, 230), text_size=txtSize)
        table.cell(dash2, 1, rowIdx2, (bullFbCount + bullRtCount) > 0 ? "▲ " + str.tostring(bullFbCount + bullRtCount) + "\n" + (bullFbList != "" ? bullFbList : bullRtList) : "-", bgcolor=(bullFbCount + bullRtCount) > 0 ? color.new(color.lime, 78) : color.new(color.gray, 85), text_color=(bullFbCount + bullRtCount) > 0 ? color.rgb(19, 65, 43) : color.gray, text_size=txtSize)
        table.cell(dash2, 2, rowIdx2, (bearFbCount + bearRtCount) > 0 ? "▼ " + str.tostring(bearFbCount + bearRtCount) + "\n" + (bearFbList != "" ? bearFbList : bearRtList) : "-", bgcolor=(bearFbCount + bearRtCount) > 0 ? color.new(color.red, 78) : color.new(color.gray, 85), text_color=(bearFbCount + bearRtCount) > 0 ? color.red : color.gray, text_size=txtSize)
        rowIdx2 := rowIdx2 + 1

    if bullAccCount > 0 or bearAccCount > 0
        table.cell(dash2, 0, rowIdx2, "4. Accumulation Sequence", bgcolor=color.rgb(249, 226, 23, 87), text_color=color.rgb(10, 65, 230), text_size=txtSize)
        table.cell(dash2, 1, rowIdx2, bullAccCount > 0 ? "▲ " + str.tostring(bullAccCount) + "\n" + bullAccList : "-", bgcolor=bullAccCount > 0 ? color.new(color.lime, 78) : color.new(color.gray, 85), text_color=bullAccCount > 0 ? color.rgb(19, 65, 43) : color.gray, text_size=txtSize)
        table.cell(dash2, 2, rowIdx2, bearAccCount > 0 ? "▼ " + str.tostring(bearAccCount) + "\n" + bearAccList : "-", bgcolor=bearAccCount > 0 ? color.new(color.red, 78) : color.new(color.gray, 85), text_color=bearAccCount > 0 ? color.red : color.gray, text_size=txtSize)
        rowIdx2 := rowIdx2 + 1

    if activeRows2 == 0
        table.merge_cells(dash2, 0, 1, 2, 1)
        table.cell(dash2, 0, 1, "No Active Trade Sequences Today", bgcolor=color.new(color.gray, 85), text_color=color.gray, text_size=txtSize)

// ---------------------------- ALERTS ----------------------------

alertcondition(anyBullAcc, title="Accumulation Phase",    message="TLCS Sequence: Bullish Accumulation Phase on {{ticker}}")
alertcondition(anyBearAcc, title="Distribution Phase",    message="TLCS Sequence: Bearish Distribution Phase on {{ticker}}")
alertcondition(anyBullRej, title="Bullish Rejection", message="TLCS Sequence: Bullish Rejection on {{ticker}}")
alertcondition(anyBearRej, title="Bearish Rejection", message="TLCS Sequence: Bearish Rejection on {{ticker}}")
alertcondition(anyBullOd, title="Bullish Outside", message="TLCS Sequence: Bullish Outside on {{ticker}}")
alertcondition(anyBearOd, title="Bearish Outside", message="TLCS Sequence: Bearish Outside on {{ticker}}")
alertcondition(anyBullSrd, title="Bullish Stop Run",  message="TLCS Sequence: Bullish Stop Run on {{ticker}}")
alertcondition(anyBearSrd, title="Bearish Stop Run",  message="TLCS Sequence: Bearish Stop Run on {{ticker}}")
alertcondition(anyBullFade,title="Bullish Fade (SRD)",    message="TLCS Sequence: Bullish Fade After SRD on {{ticker}}")
alertcondition(anyBearFade,title="Bearish Fade (SRD)",    message="TLCS Sequence: Bearish Fade After SRD on {{ticker}}")
alertcondition(anyBullAbs, title="Bullish Absorption",    message="TLCS Sequence: Bullish Absorption on {{ticker}}")
alertcondition(anyBearAbs, title="Bearish Absorption",    message="TLCS Sequence: Bearish Absorption on {{ticker}}")
alertcondition(anyBullFnl, title="Bullish FNL (Seq)",     message="TLCS Sequence: Bullish FNL on {{ticker}}")
alertcondition(anyBearFnh, title="Bearish FNH (Seq)",     message="TLCS Sequence: Bearish FNH on {{ticker}}")
alertcondition(anyBullFb,  title="Bullish Failed Breakout",message="TLCS Sequence: Bullish Failed Breakout on {{ticker}}")
alertcondition(anyBearFb,  title="Bearish Failed Breakout",message="TLCS Sequence: Bearish Failed Breakout on {{ticker}}")
alertcondition(anyBullRt,  title="Bullish Retest (SRD)",  message="TLCS Sequence: Bullish Retest After SRD on {{ticker}}")
alertcondition(anyBearRt,  title="Bearish Retest (SRD)",  message="TLCS Sequence: Bearish Retest After SRD on {{ticker}}")
alertcondition(anyBullCont,title="Bullish Continuation",  message="TLCS Sequence: Bullish Continuation on {{ticker}}")
alertcondition(anyBearCont,title="Bearish Continuation",  message="TLCS Sequence: Bearish Continuation on {{ticker}}")

// =====================================================================================
// JSON PAYLOAD BUILDER & ALERT DISPATCHER
// =====================================================================================

f_build_json_row(sym, acB, acS, rB, rS, sB, sS, odB, odS, fdB, fdS, aB, aS, fB, fS, fbB, fbS, rtB, rtS, cB, cS) =>
    acc  = acB ? "Bullish" : acS ? "Bearish" : "NONE"
    rej  = rB ? "Bullish" : rS ? "Bearish" : "NONE"
    srd  = sB ? "Bullish" : sS ? "Bearish" : "NONE"
    out  = odB ? "Bullish" : odS ? "Bearish" : "NONE"
    fade = fdB? "Bullish" : fdS? "Bearish" : "NONE"
    abs  = aB ? "Bullish" : aS ? "Bearish" : "NONE"
    fnl  = fB ? "Bullish" : fS ? "Bearish" : "NONE"
    fb   = fbB? "Bullish" : fbS? "Bearish" : "NONE"
    rt   = rtB? "Bullish" : rtS? "Bearish" : "NONE"
    cont = cB ? "Bullish" : cS ? "Bearish" : "NONE"
    
    has_active = (acc != "NONE" or rej != "NONE" or srd != "NONE" or out != "NONE" or fade != "NONE" or abs != "NONE" or fnl != "NONE" or fb != "NONE" or rt != "NONE" or cont != "NONE")
    
    json_obj = "{\"sym\":\"" + sym + "\", \"acc\":\"" + acc + "\", \"rej\":\"" + rej + "\", \"srd\":\"" + srd + "\", \"out\":\"" + out + "\", \"fade\":\"" + fade + "\", \"abs\":\"" + abs + "\", \"fnl\":\"" + fnl + "\", \"fb\":\"" + fb + "\", \"rt\":\"" + rt + "\", \"cont\":\"" + cont + "\"}"
    
    [has_active, json_obj]

string json_array = "["
bool has_any_alerts = false

if array.size(symArr) > 0
    for i = 0 to array.size(symArr) - 1
        [is_active, row_json] = f_build_json_row(
          array.get(symArr, i), 
          array.get(bullAccArr, i), 
          array.get(bearAccArr, i), 
          array.get(bullRejArr, i), 
          array.get(bearRejArr, i), 
          array.get(bullSrdArr, i),
          array.get(bearSrdArr, i),
          array.get(bullOdArr, i),
          array.get(bearOdArr, i),
          array.get(bullFadeArr, i),
          array.get(bearFadeArr, i),
          array.get(bullAbsArr, i), 
          array.get(bearAbsArr, i), 
          array.get(bullFnlArr, i),
          array.get(bearFnhArr, i),
          array.get(bullFbArr, i),
          array.get(bearFbArr, i),
          array.get(bullRtArr, i),
          array.get(bearRtArr, i),
          array.get(bullContArr, i),
          array.get(bearContArr, i)
        )
        
        if is_active
            if has_any_alerts
                json_array := json_array + ", " 
            json_array := json_array + row_json
            has_any_alerts := true

json_array := json_array + "]"
string webhook_payload = "{\"type\": \"PivotBossScan\", \"scan_data\": " + json_array + "}"

if barstate.isrealtime and barstate.islast and barstate.isconfirmed
    alert(webhook_payload, alert.freq_once_per_bar_close)
