//@version=6
indicator('Virgin CPR Zones — D / W / M / Y', overlay = true, max_boxes_count = 500, max_labels_count = 500)

// ============================================================
//  INPUTS
// ============================================================
GEN = 'General'
showTags         = input.bool(true, 'Label zones (D / W / M / Y)', group = GEN)
showSignalLabels = input.bool(true, 'Show On-Chart Pop-Up Labels', group = GEN, tooltip = 'Draws prominent on-chart pop-up badges directly above/below the candle where price touches a virgin level')
labelFormat      = input.string('Compact (Date Only)', 'Pop-Up Label Display', options = ['Compact (Date Only)', 'Full (Date + Zone + Price)'], group = GEN, tooltip = 'Choose whether the on-chart pop-up label displays "VCPR Dated <Date>" cleanly or includes Zone and Price lines')
vcprDateFormat   = input.string('dd-MMM-yyyy', 'Pop-Up Date Format', options = ['dd-MMM-yyyy', 'dd-MM-yyyy', 'yyyy-MM-dd', 'dd MMM yyyy'], group = GEN, tooltip = 'Format for the VCPR creation date')
showShapes       = input.bool(true, 'Show On-Chart Triangles', group = GEN, tooltip = 'Plots directional signal arrows at the touch point')
showHud          = input.bool(true, 'Show On-Chart Signal HUD Card', group = GEN, tooltip = 'Displays a real-time HUD pop-up table on the chart with touch telemetry')
hudPos           = input.string(position.top_right, 'HUD Position', options = [position.top_right, position.bottom_right, position.top_left, position.bottom_left], group = GEN)
enableAlerts     = input.bool(true, 'Trigger Pop-up Dialog Alerts', group = GEN, tooltip = 'Triggers TradingView native popup notifications and audio chimes when a virgin level is touched')
alertFrequency   = input.string('Once Per Bar', 'Alert Frequency', options = ['Once Per Bar', 'Once Per Bar Close'], group = GEN)

GD = 'Daily'
dLines = input.bool(false, 'Show Daily CPR lines', group = GD)
dZones = input.bool(true, 'Show Daily Virgin CPR', group = GD)
dMax   = input.int(4, 'Max Daily zones', minval = 1, maxval = 22, group = GD, tooltip = 'Default 4 zones. Can be set up to 22 zones for ~1 month of sessions')
dCol   = input.color(#d6cdead5, 'Daily colour', group = GD)

GW = 'Weekly'
wLines = input.bool(false, 'Show Weekly CPR lines', group = GW)
wZones = input.bool(true, 'Show Weekly Virgin CPR', group = GW)
wMax   = input.int(4, 'Max Weekly zones', minval = 1, maxval = 12, group = GW)
wCol   = input.color(#a855f7d5, 'Weekly colour', group = GW)

GM = 'Monthly'
mLines = input.bool(false, 'Show Monthly CPR lines', group = GM)
mZones = input.bool(false, 'Show Monthly Virgin CPR', group = GM)
mMax   = input.int(4, 'Max Monthly zones', minval = 1, maxval = 12, group = GM)
mCol   = input.color(#f59e0bd5, 'Monthly colour', group = GM)

GY = 'Yearly'
yLines = input.bool(false, 'Show Yearly CPR lines', group = GY)
yZones = input.bool(false, 'Show Yearly Virgin CPR', group = GY)
yMax   = input.int(2, 'Max Yearly zones', minval = 1, maxval = 5, group = GY)
yCol   = input.color(#ef4444d5, 'Yearly colour', group = GY)


// ============================================================
//  CORE VIRGIN CPR ENGINE (AUTHENTIC PIVOTBOSS STP 2.0 FORMULA)
// ============================================================
f_virginCPR(string tf, bool drawLines, bool drawZones, int maxZones, color col, string tag, bool showLabels, string lblFmt, string dtFmt) =>

    // --- Normalize yearly timeframe string ('Y' / '1Y' -> '12M') because TradingView security requires '12M'
    string reqTf = (tf == 'Y' or tf == '1Y') ? '12M' : tf

    // --- Guard: the CPR timeframe must be >= the chart timeframe.
    bool tfOk = timeframe.in_seconds() <= timeframe.in_seconds(reqTf)

    // --- Developing HTF OHLC (no lookahead).
    [hh, ll, cc] = request.security(syminfo.tickerid, reqTf, [high, low, close], gaps = barmerge.gaps_off, lookahead = barmerge.lookahead_off)

    float p     = (hh + ll + cc) / 3.0
    float bc    = (hh + ll) / 2.0
    float tc    = 2.0 * p - bc
    float hiRaw = math.max(tc, bc)
    float loRaw = math.min(tc, bc)

    bool isNew = ta.change(time(reqTf)) != 0

    // --- Latch the CPR once per period so it never moves.
    //     On the first bar of a new period, [1] is the last bar of the
    //     previous period, i.e. that period's completed HLC.
    var float curHi   = na
    var float curLo   = na
    var float curP    = na
    var int   curTime = na

    if isNew
        curHi   := hiRaw[1]
        curLo   := loRaw[1]
        curP    := p[1]
        curTime := time(reqTf)

    // --- Snapshot of the period that just ended (read BEFORE any reset).
    var bool touched  = false
    float hiPrev   = curHi[1]
    float loPrev   = curLo[1]
    bool  tchPrev  = touched[1]
    int   timePrev = curTime[1]

    // --- Zone storage.
    var array<box>   zBox  = array.new_box()
    var array<label> zLab  = array.new_label()
    var array<float> zTop  = array.new_float()
    var array<float> zBot  = array.new_float()
    var array<bool>  zAct  = array.new_bool()
    var array<int>   zTime = array.new_int()

    // --- A CPR is virgin only once its own period closed untouched.
    if isNew and tfOk and drawZones
        bool wasVirgin = not na(hiPrev) and not tchPrev

        if wasVirgin
            if array.size(zBox) >= maxZones
                box.delete(array.shift(zBox))
                label.delete(array.shift(zLab))
                array.shift(zTop)
                array.shift(zBot)
                array.shift(zAct)
                array.shift(zTime)

            box nb = box.new(left = bar_index, top = hiPrev, right = bar_index + 1, bottom = loPrev, border_color = color.new(col, 20), bgcolor = color.new(col, 88), border_width = 1)

            label nl = label.new(x = bar_index, y = hiPrev, text = showTags ? tag : '', style = label.style_none, textcolor = col, size = size.tiny)

            array.push(zBox, nb)
            array.push(zLab, nl)
            array.push(zTop, hiPrev)
            array.push(zBot, loPrev)
            array.push(zAct, true)
            array.push(zTime, timePrev)

    // --- Reset the flag BEFORE testing this bar, so the very first
    //     candle of the new period can count as a touch.
    if isNew
        touched := false

    // --- `not na(curHi)` keeps the flag from ever becoming na and sticking.
    touched := touched or (not na(curHi) and high >= curLo and low <= curHi)

    // --- Signal trackers for the current bar
    bool  touchedBull = false
    bool  touchedBear = false
    float touchedTop  = na
    float touchedBot  = na
    int   touchedTime = na

    // --- Extend live zones; freeze them the moment price trades in.
    int n = array.size(zBox)
    if n > 0
        for i = 0 to n - 1
            if array.get(zAct, i)
                box   b  = array.get(zBox, i)
                label lb = array.get(zLab, i)
                float t  = array.get(zTop, i)
                float bt = array.get(zBot, i)

                box.set_right(b, bar_index)
                label.set_x(lb, bar_index)
                label.set_y(lb, t)

                // ── TOUCH TRIGGER: Price touches or penetrates active Virgin CPR zone ──
                if high >= bt and low <= t
                    array.set(zAct, i, false)

                    // Directional classification:
                    bool fromAbove = (close[1] > t) or (open > t)
                    bool fromBelow = (close[1] < bt) or (open < bt)
                    bool isSupport = fromAbove or (not fromBelow and open >= (t + bt) / 2.0)

                    if isSupport
                        touchedBull := true
                    else
                        touchedBear := true

                    touchedTop  := t
                    touchedBot  := bt
                    int zT       = array.get(zTime, i)
                    touchedTime := zT

                    // ── ON-CHART SIGNAL POP-UP LABEL ──
                    if showLabels
                        string dateStr = not na(zT) ? str.format_time(zT, dtFmt, syminfo.timezone) : ''
                        string tfPrefix = tag == 'D' ? 'VCPR Dated ' : (tag == 'W' ? 'Weekly VCPR Dated ' : (tag == 'M' ? 'Monthly VCPR Dated ' : 'Yearly VCPR Dated '))
                        string signalTitle = tfPrefix + dateStr
                        string zoneStr = str.tostring(bt, '#.##') + ' - ' + str.tostring(t, '#.##')
                        string labelText = signalTitle + (lblFmt == 'Full (Date + Zone + Price)' ? '\nZone: [' + zoneStr + ']\nPrice: ' + str.tostring(close, '#.##') : '')

                        color bgCol = isSupport ? color.new(#10b981, 10) : color.new(#ef4444, 10)

                        label.new(
                             x = bar_index,
                             y = isSupport ? low : high,
                             text = labelText,
                             style = isSupport ? label.style_label_up : label.style_label_down,
                             color = bgCol,
                             textcolor = color.white,
                             size = size.normal,
                             tooltip = signalTitle + '\nZone: [' + zoneStr + ']\nTouch Price: ' + str.tostring(close, '#.##')
                        )

    [tfOk and drawLines ? curHi : na, tfOk and drawLines ? curP : na, tfOk and drawLines ? curLo : na, touchedBull, touchedBear, touchedTop, touchedBot, touchedTime]


// ============================================================
//  CALLS — always unconditional; toggles gate the drawing only.
// ============================================================
[dHi, dP, dLo, dBull, dBear, dTop, dBot, dTime] = f_virginCPR('D', dLines, dZones, dMax, dCol, 'D', showSignalLabels, labelFormat, vcprDateFormat)
[wHi, wP, wLo, wBull, wBear, wTop, wBot, wTime] = f_virginCPR('W', wLines, wZones, wMax, wCol, 'W', showSignalLabels, labelFormat, vcprDateFormat)
[mHi, mP, mLo, mBull, mBear, mTop, mBot, mTime] = f_virginCPR('M', mLines, mZones, mMax, mCol, 'M', showSignalLabels, labelFormat, vcprDateFormat)
[yHi, yP, yLo, yBull, yBear, yTop, yBot, yTime] = f_virginCPR('12M', yLines, yZones, yMax, yCol, 'Y', showSignalLabels, labelFormat, vcprDateFormat)

bool anyBullTouch = dBull or wBull or mBull or yBull
bool anyBearTouch = dBear or wBear or mBear or yBear
bool anyTouch     = anyBullTouch or anyBearTouch


// ============================================================
//  REAL-TIME POP-UP DIALOG ALERTS (ZERO COMPILATION WARNINGS)
// ============================================================
if enableAlerts
    if dBull or dBear
        string dDate = not na(dTime) ? ' (VCPR Dated ' + str.format_time(dTime, vcprDateFormat, syminfo.timezone) + ')' : ' (Daily VCPR)'
        string dTitle = syminfo.ticker + dDate
        string dSig = dBull ? 'BULLISH SUPPORT TEST (Bounce)' : 'BEARISH RESISTANCE TEST (Rejection)'
        string dZone = str.tostring(dBot, '#.##') + ' - ' + str.tostring(dTop, '#.##')
        string dMsg = '🚨 [' + dTitle + '] ' + dSig + '\nZone: [' + dZone + ']\nTouch Price: ' + str.tostring(close, '#.##') + '\nBar H/L: ' + str.tostring(high, '#.##') + ' / ' + str.tostring(low, '#.##')
        if alertFrequency == 'Once Per Bar'
            alert(dMsg, alert.freq_once_per_bar)
        else
            alert(dMsg, alert.freq_once_per_bar_close)

    if wBull or wBear
        string wDate = not na(wTime) ? ' (Weekly VCPR Dated ' + str.format_time(wTime, vcprDateFormat, syminfo.timezone) + ')' : ' (Weekly VCPR)'
        string wTitle = syminfo.ticker + wDate
        string wSig = wBull ? 'BULLISH SUPPORT TEST (Bounce)' : 'BEARISH RESISTANCE TEST (Rejection)'
        string wZone = str.tostring(wBot, '#.##') + ' - ' + str.tostring(wTop, '#.##')
        string wMsg = '🚨 [' + wTitle + '] ' + wSig + '\nZone: [' + wZone + ']\nTouch Price: ' + str.tostring(close, '#.##') + '\nBar H/L: ' + str.tostring(high, '#.##') + ' / ' + str.tostring(low, '#.##')
        if alertFrequency == 'Once Per Bar'
            alert(wMsg, alert.freq_once_per_bar)
        else
            alert(wMsg, alert.freq_once_per_bar_close)

    if mBull or mBear
        string mDate = not na(mTime) ? ' (Monthly VCPR Dated ' + str.format_time(mTime, vcprDateFormat, syminfo.timezone) + ')' : ' (Monthly VCPR)'
        string mTitle = syminfo.ticker + mDate
        string mSig = mBull ? 'BULLISH SUPPORT TEST (Bounce)' : 'BEARISH RESISTANCE TEST (Rejection)'
        string mZone = str.tostring(mBot, '#.##') + ' - ' + str.tostring(mTop, '#.##')
        string mMsg = '🚨 [' + mTitle + '] ' + mSig + '\nZone: [' + mZone + ']\nTouch Price: ' + str.tostring(close, '#.##') + '\nBar H/L: ' + str.tostring(high, '#.##') + ' / ' + str.tostring(low, '#.##')
        if alertFrequency == 'Once Per Bar'
            alert(mMsg, alert.freq_once_per_bar)
        else
            alert(mMsg, alert.freq_once_per_bar_close)

    if yBull or yBear
        string yDate = not na(yTime) ? ' (Yearly VCPR Dated ' + str.format_time(yTime, vcprDateFormat, syminfo.timezone) + ')' : ' (Yearly VCPR)'
        string yTitle = syminfo.ticker + yDate
        string ySig = yBull ? 'BULLISH SUPPORT TEST (Bounce)' : 'BEARISH RESISTANCE TEST (Rejection)'
        string yZone = str.tostring(yBot, '#.##') + ' - ' + str.tostring(yTop, '#.##')
        string yMsg = '🚨 [' + yTitle + '] ' + ySig + '\nZone: [' + yZone + ']\nTouch Price: ' + str.tostring(close, '#.##') + '\nBar H/L: ' + str.tostring(high, '#.##') + ' / ' + str.tostring(low, '#.##')
        if alertFrequency == 'Once Per Bar'
            alert(yMsg, alert.freq_once_per_bar)
        else
            alert(yMsg, alert.freq_once_per_bar_close)


// ============================================================
//  ON-CHART SIGNAL SHAPES
// ============================================================
plotshape(showShapes and anyBullTouch, title = 'VCPR Support Touch (Bullish)', style = shape.triangleup, location = location.belowbar, color = #10b981, size = size.small, offset = 0)
plotshape(showShapes and anyBearTouch, title = 'VCPR Resistance Touch (Bearish)', style = shape.triangledown, location = location.abovebar, color = #ef4444, size = size.small, offset = 0)


// ============================================================
//  ON-CHART POP-UP HUD CARD (TABLE)
// ============================================================
var table hud = table.new(hudPos, 2, 6, bgcolor = color.new(#0f172a, 12), border_color = color.new(#334155, 40), border_width = 1)

var string lastSigTitle = "MONITORING VCPR ZONES"
var string lastSigType  = "NO TOUCH YET"
var string lastZoneStr  = "---"
var float  lastPrice    = na
var int    lastTouchBar = na
var color  lastSigCol   = color.gray

if anyTouch
    lastTouchBar := bar_index
    lastPrice    := close
    if dBull
        string dDate = not na(dTime) ? ' (' + str.format_time(dTime, vcprDateFormat, syminfo.timezone) + ')' : ''
        lastSigTitle := "VCPR DATED " + str.upper(not na(dTime) ? str.format_time(dTime, vcprDateFormat, syminfo.timezone) : "DAILY")
        lastSigType  := "▲ BULLISH SUPPORT TEST" + dDate
        lastZoneStr  := str.tostring(dBot, "#.##") + " - " + str.tostring(dTop, "#.##")
        lastSigCol   := #10b981
    else if dBear
        string dDate = not na(dTime) ? ' (' + str.format_time(dTime, vcprDateFormat, syminfo.timezone) + ')' : ''
        lastSigTitle := "VCPR DATED " + str.upper(not na(dTime) ? str.format_time(dTime, vcprDateFormat, syminfo.timezone) : "DAILY")
        lastSigType  := "▼ BEARISH RESISTANCE TEST" + dDate
        lastZoneStr  := str.tostring(dBot, "#.##") + " - " + str.tostring(dTop, "#.##")
        lastSigCol   := #ef4444
    else if wBull
        string wDate = not na(wTime) ? ' (' + str.format_time(wTime, vcprDateFormat, syminfo.timezone) + ')' : ''
        lastSigTitle := "WEEKLY VCPR DATED " + str.upper(not na(wTime) ? str.format_time(wTime, vcprDateFormat, syminfo.timezone) : "")
        lastSigType  := "▲ BULLISH SUPPORT TEST" + wDate
        lastZoneStr  := str.tostring(wBot, "#.##") + " - " + str.tostring(wTop, "#.##")
        lastSigCol   := #10b981
    else if wBear
        string wDate = not na(wTime) ? ' (' + str.format_time(wTime, vcprDateFormat, syminfo.timezone) + ')' : ''
        lastSigTitle := "WEEKLY VCPR DATED " + str.upper(not na(wTime) ? str.format_time(wTime, vcprDateFormat, syminfo.timezone) : "")
        lastSigType  := "▼ BEARISH RESISTANCE TEST" + wDate
        lastZoneStr  := str.tostring(wBot, "#.##") + " - " + str.tostring(wTop, "#.##")
        lastSigCol   := #ef4444
    else if mBull
        string mDate = not na(mTime) ? ' (' + str.format_time(mTime, vcprDateFormat, syminfo.timezone) + ')' : ''
        lastSigTitle := "MONTHLY VCPR DATED " + str.upper(not na(mTime) ? str.format_time(mTime, vcprDateFormat, syminfo.timezone) : "")
        lastSigType  := "▲ BULLISH SUPPORT TEST" + mDate
        lastZoneStr  := str.tostring(mBot, "#.##") + " - " + str.tostring(mTop, "#.##")
        lastSigCol   := #10b981
    else if mBear
        string mDate = not na(mTime) ? ' (' + str.format_time(mTime, vcprDateFormat, syminfo.timezone) + ')' : ''
        lastSigTitle := "MONTHLY VCPR DATED " + str.upper(not na(mTime) ? str.format_time(mTime, vcprDateFormat, syminfo.timezone) : "")
        lastSigType  := "▼ BEARISH RESISTANCE TEST" + mDate
        lastZoneStr  := str.tostring(mBot, "#.##") + " - " + str.tostring(mTop, "#.##")
        lastSigCol   := #ef4444
    else if yBull
        string yDate = not na(yTime) ? ' (' + str.format_time(yTime, vcprDateFormat, syminfo.timezone) + ')' : ''
        lastSigTitle := "YEARLY VCPR DATED " + str.upper(not na(yTime) ? str.format_time(yTime, vcprDateFormat, syminfo.timezone) : "")
        lastSigType  := "▲ BULLISH SUPPORT TEST" + yDate
        lastZoneStr  := str.tostring(yBot, "#.##") + " - " + str.tostring(yTop, "#.##")
        lastSigCol   := #10b981
    else if yBear
        string yDate = not na(yTime) ? ' (' + str.format_time(yTime, vcprDateFormat, syminfo.timezone) + ')' : ''
        lastSigTitle := "YEARLY VCPR DATED " + str.upper(not na(yTime) ? str.format_time(yTime, vcprDateFormat, syminfo.timezone) : "")
        lastSigType  := "▼ BEARISH RESISTANCE TEST" + yDate
        lastZoneStr  := str.tostring(yBot, "#.##") + " - " + str.tostring(yTop, "#.##")
        lastSigCol   := #ef4444

if showHud and barstate.islast
    bool isLiveTouchNow = anyTouch
    color headerBg = isLiveTouchNow ? color.new(lastSigCol, 15) : color.new(#1e293b, 10)
    color headerTextCol = isLiveTouchNow ? color.white : #94a3b8

    table.cell(hud, 0, 0, isLiveTouchNow ? "⚡ LIVE VCPR TOUCH POP-UP" : "🧲 VCPR POP-UP MONITOR", bgcolor = headerBg, text_color = headerTextCol, text_size = size.small)
    table.cell(hud, 1, 0, "D / W / M / Y", bgcolor = headerBg, text_color = headerTextCol, text_size = size.small)

    table.cell(hud, 0, 1, "TICKER / TF", text_color = #94a3b8, text_size = size.tiny)
    table.cell(hud, 1, 1, syminfo.ticker + " (" + timeframe.period + ")", text_color = color.white, text_size = size.tiny)

    table.cell(hud, 0, 2, "STATUS / TYPE", text_color = #94a3b8, text_size = size.tiny)
    table.cell(hud, 1, 2, lastSigType, text_color = lastSigCol, text_size = size.tiny)

    table.cell(hud, 0, 3, "VIRGIN ZONE", text_color = #94a3b8, text_size = size.tiny)
    table.cell(hud, 1, 3, lastZoneStr, text_color = color.white, text_size = size.tiny)

    table.cell(hud, 0, 4, "TOUCH PRICE", text_color = #94a3b8, text_size = size.tiny)
    string priceStr = not na(lastPrice) ? str.tostring(lastPrice, "#.##") : "---"
    table.cell(hud, 1, 4, priceStr, text_color = color.white, text_size = size.tiny)

    table.cell(hud, 0, 5, "LAST TOUCH", text_color = #94a3b8, text_size = size.tiny)
    string agoStr = not na(lastTouchBar) ? (bar_index == lastTouchBar ? "ACTIVE ON THIS BAR!" : str.tostring(bar_index - lastTouchBar) + " bars ago") : "None in range"
    table.cell(hud, 1, 5, agoStr, text_color = not na(lastTouchBar) and bar_index == lastTouchBar ? #f59e0b : #cbd5e1, text_size = size.tiny)


// ============================================================
//  CPR LINES (OPTIONAL PLOTS)
// ============================================================
plot(dLines ? dHi : na, 'Daily CPR High', dCol, 1)
plot(dLines ? dP : na,  'Daily CPR Pivot', color.new(dCol, 40), style = plot.style_circles)
plot(dLines ? dLo : na, 'Daily CPR Low',  dCol, 1)

plot(wLines ? wHi : na, 'Weekly CPR High', wCol, 1)
plot(wLines ? wP : na,  'Weekly CPR Pivot', color.new(wCol, 40), style = plot.style_circles)
plot(wLines ? wLo : na, 'Weekly CPR Low',  wCol, 1)

plot(mLines ? mHi : na, 'Monthly CPR High', mCol, 1)
plot(mLines ? mP : na,  'Monthly CPR Pivot', color.new(mCol, 40), style = plot.style_circles)
plot(mLines ? mLo : na, 'Monthly CPR Low',  mCol, 1)

plot(yLines ? yHi : na, 'Yearly CPR High', yCol, 1)
plot(yLines ? yP : na,  'Yearly CPR Pivot', color.new(yCol, 40), style = plot.style_circles)
plot(yLines ? yLo : na, 'Yearly CPR Low',  yCol, 1)


// ============================================================
//  ALERT CONDITIONS (FOR TRADINGVIEW ALERT DIALOG)
// ============================================================
alertcondition(dBull, title = 'Daily VCPR Support Touch (Bullish)', message = '🔔 [VCPR Alert] {{ticker}} touched Daily Virgin CPR Support at {{close}}!')
alertcondition(dBear, title = 'Daily VCPR Resistance Touch (Bearish)', message = '🔔 [VCPR Alert] {{ticker}} touched Daily Virgin CPR Resistance at {{close}}!')
alertcondition(wBull, title = 'Weekly VCPR Support Touch (Bullish)', message = '🔔 [VCPR Alert] {{ticker}} touched Weekly Virgin CPR Support at {{close}}!')
alertcondition(wBear, title = 'Weekly VCPR Resistance Touch (Bearish)', message = '🔔 [VCPR Alert] {{ticker}} touched Weekly Virgin CPR Resistance at {{close}}!')
alertcondition(mBull, title = 'Monthly VCPR Support Touch (Bullish)', message = '🔔 [VCPR Alert] {{ticker}} touched Monthly Virgin CPR Support at {{close}}!')
alertcondition(mBear, title = 'Monthly VCPR Resistance Touch (Bearish)', message = '🔔 [VCPR Alert] {{ticker}} touched Monthly Virgin CPR Resistance at {{close}}!')
alertcondition(yBull, title = 'Yearly VCPR Support Touch (Bullish)', message = '🔔 [VCPR Alert] {{ticker}} touched Yearly Virgin CPR Support at {{close}}!')
alertcondition(yBear, title = 'Yearly VCPR Resistance Touch (Bearish)', message = '🔔 [VCPR Alert] {{ticker}} touched Yearly Virgin CPR Resistance at {{close}}!')
alertcondition(anyTouch, title = 'Any Virgin CPR Touch (D / W / M / Y)', message = '🔔 [VCPR Alert] {{ticker}} touched Virgin CPR zone at {{close}}!')
