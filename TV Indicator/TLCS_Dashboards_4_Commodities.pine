//@version=6
indicator("TLCS Dashboards - 4 Commodities - Unified", overlay=true, max_labels_count=500)

// ---------------------------- SHARED SETTINGS ----------------------------
gAlerts = "Alerts & Webhook"
webhook_secret = input.string('675d6a25933d3fc1b78b45ba2d6b400c0d1598e6780e9b8ae4ea1b1f824d89eb', 'Webhook Secret', group = gAlerts, display = display.none)

gShared = "Shared: ADR Lookback"
adrLen = input.int(10, "ATR Lookback (bars)", minval=2, group=gShared)

gAcc = "Accumulation / Distribution"
accLen = input.int(20, "Accumulation Lookback", minval=5, group=gAcc)
accMaxRangeMult = input.float(3.0, "Max Range vs ATR (x)", step=0.1, group=gAcc, tooltip="The total range over the lookback period must be <= this multiple of the ADR")

gRej1 = "Rejection Day — Range"
adrMultMin = input.float(1.25, "Min Range vs ATR (x)", step=0.05, group=gRej1)

gRej2 = "Rejection Day — Tail / Body"
tailBodyMult = input.float(2.5, "Min Tail / Body Ratio", step=0.1, group=gRej2)

gRej3 = "Rejection Day — Close Location"
closeZonePct = input.float(35, "Close within top/bottom X% of range", minval=1, maxval=50, group=gRej3) / 100

gRej4 = "Rejection Day — Location / Structure"
useStructure = input.bool(true, "Require near prior swing extreme", group=gRej4)
structLen    = input.int(20, "Lookback for prior swing high/low", minval=2, group=gRej4)
structTolPct = input.float(1.0, "Tolerance around prior extreme (%)", step=0.1, group=gRej4) / 100

gOd1 = "Outside Day — Range"
odAdrMultMin = input.float(1.05, "Min Range vs ATR (x)", step=0.05, group=gOd1)

gFnl1 = "FNL/FNH — Range"
adrMinPct = input.float(75, "Min Range vs ATR (%)", step=5, group=gFnl1) / 100

gFnl2 = "FNL/FNH — Sweep"
sweepLookback = input.int(1, "Sweep Lookback (bars)", minval=1, maxval=20, group=gFnl2)

gFnl3 = "FNL/FNH — Close Location"
requireAboveYMid = input.bool(true, "Require close above yMID (FNL) / below yMID (FNH)", group=gFnl3)

gAbs1 = "Absorption Day — Range"
absAdrMaxMult = input.float(0.75, "Max Range vs ATR (x)", step=0.05, group=gAbs1)

gAbs2 = "Absorption Day — Location"
absMidTolPct = input.float(1.0, "Tolerance: Low/High near yMID (%)", step=0.1, group=gAbs2) / 100

gAbs3 = "Absorption Day — Close Confirmation"
requireBodyConfirm = input.bool(true, "Require body confirmation (Close vs Open)", group=gAbs3)

gSrd1 = "Stop Run Day — Range"
srdAdrMultMin = input.float(2.0, "Min Range vs ATR (x)", step=0.1, group=gSrd1)

gSrd2 = "Stop Run Day — Close Location"
srdCloseZonePct = input.float(15, "Close within top/bottom X% of range", minval=1, maxval=50, group=gSrd2) / 100

gSrd3 = "Stop Run Day — Structure"
srdStructLen = input.int(5, "Lookback for prior swing high/low for MID check (bars)", minval=1, group=gSrd3)

// ---------------------------- TLCS SIGNALS SETTINGS ----------------------------
gSigs = "TLCS Reversal Settings"
L01 = input.bool(true, title = 'Enable Wick Reversal System', group=gSigs)
wick_multiplier = input.float(title = 'Wick Multiplier', defval = 3.25, step = 0.5, maxval = 20, group=gSigs)
body_percentage = input.float(title = 'Body Percentage', defval = 0.35, step = 0.1, maxval = 1, group=gSigs)
WBarMultiplier = input.float(title = 'Body Multiplier', defval = 1.1, step = 0.05, maxval = 3.5, group=gSigs)
Wbarsback = input.int(title = 'Bars Back', defval = 50, maxval = 50, group=gSigs)

L02 = input.bool(true, title = 'Enable Exteme Reversal System', group=gSigs)
bodysize = input.float(title = 'Body Size', defval = 0.75, step = 0.05, maxval = 1, group=gSigs)
bodymultiplier = input.float(title = 'Body Multiplier', defval = 2, step = 0.25, maxval = 5, group=gSigs)

L03 = input.bool(true, title = 'Enable Outside Reversal System', group=gSigs)
BarMultiplier = input.float(title = 'Body Multiplier', defval = 1.25, step = 0.05, maxval = 3.5, group=gSigs)

L04 = input.bool(true, title = 'Enable Doji Reversal System', group=gSigs)
DBarMultiplier = input.float(title = 'Body Multiplier', defval = 0.65, step = 0.05, maxval = 3.5, group=gSigs)
percentage = input.float(title = 'Body Percentage', defval = 0.10, step = 0.1, minval = 0.1, group=gSigs)


// ---------------------------- DASHBOARD DISPLAY ----------------------------
gDisplay = "Dashboard Display"
tablePosStr  = input.string("Middle Right", "Table Position", options=["Middle Right", "Middle Left", "Top Right", "Top Left", "Bottom Right", "Bottom Left"], group=gDisplay)
tableTextSz  = input.string("Small", "Table Text Size", options=["Tiny", "Small", "Normal"], group=gDisplay)

// ---------------------------- SYMBOL UNIVERSE: 4 Commodities Only ----------------------------
gCommodities = "Commodities (NYMEX/COMEX)"
u1 = input.symbol("NYMEX:CL1!", "Futures 1 (Crude)", group=gCommodities)
u2 = input.symbol("NYMEX:NG1!", "Futures 2 (NatGas)", group=gCommodities)
u3 = input.symbol("COMEX:GC1!", "Futures 3 (Gold)", group=gCommodities)
u4 = input.symbol("COMEX:SI1!", "Futures 4 (Silver)", group=gCommodities)

// ---------------------------- SEQUENCE & SIGNAL CALC ----------------------------
f_calc() =>
    // existing sequence math...
    rng    = high - low
    body   = math.abs(close - open)
    upWick = high - math.max(open, close)
    dnWick = math.min(open, close) - low
    mid    = (high + low) / 2
    avgRange = ta.sma(ta.tr(true), adrLen)[1]
    closePos = rng != 0 ? (close - low) / rng : 0.5
    accHigh = ta.highest(high, accLen)
    accLow  = ta.lowest(low, accLen)
    accRange = accHigh - accLow
    isCompressing = avgRange > 0 and accRange <= accMaxRangeMult * avgRange
    bullAcc = isCompressing and close >= (accHigh + accLow) / 2
    bearDist = isCompressing and close < (accHigh + accLow) / 2
    rejRangeOK  = avgRange > 0 and rng > adrMultMin * avgRange
    bullTailOK  = body > 0 ? dnWick > tailBodyMult * body : dnWick > 0
    bearTailOK  = body > 0 ? upWick > tailBodyMult * body : upWick > 0
    bullCloseOK = closePos >= (1 - closeZonePct)
    bearCloseOK = closePos <= closeZonePct
    priorLowStruct  = ta.lowest(low, structLen)[1]
    priorHighStruct = ta.highest(high, structLen)[1]
    nearPriorLow  = low  <= priorLowStruct  * (1 + structTolPct)
    nearPriorHigh = high >= priorHighStruct * (1 - structTolPct)
    structBullOK = not useStructure or nearPriorLow
    structBearOK = not useStructure or nearPriorHigh
    bullRej = rejRangeOK and bullTailOK and bullCloseOK and structBullOK
    bearRej = rejRangeOK and bearTailOK and bearCloseOK and structBearOK
    srdRangeOK = avgRange > 0 and rng > srdAdrMultMin * avgRange
    bullSrdClosePosOK = closePos >= (1 - srdCloseZonePct)
    bullSrdCloseExt   = close > high[1]
    bullSrdMidExt     = mid >= ta.highest(high, srdStructLen)[1]
    bullSrdSignal     = srdRangeOK and bullSrdClosePosOK and bullSrdCloseExt and bullSrdMidExt
    bearSrdClosePosOK = closePos <= srdCloseZonePct
    bearSrdCloseExt   = close < low[1]
    bearSrdMidExt     = mid <= ta.lowest(low, srdStructLen)[1]
    bearSrdSignal     = srdRangeOK and bearSrdClosePosOK and bearSrdCloseExt and bearSrdMidExt

    var float rejActiveMid   = na
    var float rejActiveHigh  = na
    var float rejActiveLow   = na
    var bool  bullRejActive  = false
    var bool  bearRejActive  = false
    var bool  bullFailedAbsActive = false
    var bool  bearFailedAbsActive = false
    int barsSinceRej = ta.barssince(bullRej or bearRej)
    if bullRej
        rejActiveMid  := mid
        rejActiveHigh := high
        rejActiveLow  := low
        bullRejActive := true
        bearRejActive := false
        bullFailedAbsActive := false
        bearFailedAbsActive := false
    else if bearRej
        rejActiveMid  := mid
        rejActiveHigh := high
        rejActiveLow  := low
        bearRejActive := true
        bullRejActive := false
        bullFailedAbsActive := false
        bearFailedAbsActive := false
    if bullRejActive and close < rejActiveMid
        bullRejActive := false
        bearFailedAbsActive := true
    if bearRejActive and close > rejActiveMid
        bearRejActive := false
        bullFailedAbsActive := true
    if bearFailedAbsActive and close > rejActiveHigh
        bearFailedAbsActive := false
    if bullFailedAbsActive and close < rejActiveLow
        bullFailedAbsActive := false

    var float srdActiveMid   = na
    var float srdActiveExt   = na
    var bool  bullSrdActive  = false
    var bool  bearSrdActive  = false
    int barsSinceSrd = ta.barssince(bullSrdSignal or bearSrdSignal)
    if bullSrdSignal
        srdActiveMid  := mid
        srdActiveExt  := high
        bullSrdActive := true
        bearSrdActive := false
    else if bearSrdSignal
        srdActiveMid  := mid
        srdActiveExt  := low
        bearSrdActive := true
        bullSrdActive := false
    if bullSrdActive and close < srdActiveMid
        bullSrdActive := false
    if bearSrdActive and close > srdActiveMid
        bearSrdActive := false

    bullFade = bullSrdActive and not na(barsSinceSrd) and barsSinceSrd > 0 and high >= srdActiveExt * 0.995 and close < open
    bearFade = bearSrdActive and not na(barsSinceSrd) and barsSinceSrd > 0 and low <= srdActiveExt * 1.005 and close > open
    absRangeOK = avgRange > 0 and rng < absAdrMaxMult * avgRange
    bullAbs_Rej = bullRejActive and not na(barsSinceRej) and barsSinceRej > 0 and absRangeOK and close > rejActiveMid and (not requireBodyConfirm or close > open) and math.abs(low - rejActiveMid) <= rejActiveMid * absMidTolPct
    bearAbs_Rej = bearRejActive and not na(barsSinceRej) and barsSinceRej > 0 and absRangeOK and close < rejActiveMid and (not requireBodyConfirm or close < open) and math.abs(high - rejActiveMid) <= rejActiveMid * absMidTolPct
    bullAbs_Srd = bullSrdActive and not na(barsSinceSrd) and barsSinceSrd > 0 and absRangeOK and close > srdActiveMid and (not requireBodyConfirm or close > open) and math.abs(low - srdActiveMid) <= srdActiveMid * absMidTolPct
    bearAbs_Srd = bearSrdActive and not na(barsSinceSrd) and barsSinceSrd > 0 and absRangeOK and close < srdActiveMid and (not requireBodyConfirm or close < open) and math.abs(high - srdActiveMid) <= srdActiveMid * absMidTolPct
    odRangeOK = avgRange > 0 and rng > odAdrMultMin * avgRange
    odBull = odRangeOK and low < low[1] and close > high[1]
    odBear = odRangeOK and high > high[1] and close < low[1]
    fnlRangeOK = avgRange > 0 and rng >= adrMinPct * avgRange
    priorLowSweep  = ta.lowest(low, sweepLookback)[1]
    priorHighSweep = ta.highest(high, sweepLookback)[1]
    yMidFnl = (high[1] + low[1]) / 2.0
    fnlSweep  = low < priorLowSweep
    fnlClose  = requireAboveYMid ? close > yMidFnl : close > mid
    fnlSignal = fnlRangeOK and fnlSweep and fnlClose
    fnhSweep  = high > priorHighSweep
    fnhClose  = requireAboveYMid ? close < yMidFnl : close < mid
    fnhSignal = fnlRangeOK and fnhSweep and fnhClose
    bullFnl_Rej = bullRejActive and not na(barsSinceRej) and barsSinceRej > 0 and fnlSignal
    bearFnh_Rej = bearRejActive and not na(barsSinceRej) and barsSinceRej > 0 and fnhSignal
    bullFnl_Srd = bullSrdActive and not na(barsSinceSrd) and barsSinceSrd > 0 and fnlSignal
    bearFnh_Srd = bearSrdActive and not na(barsSinceSrd) and barsSinceSrd > 0 and fnhSignal
    int barsSinceFa = ta.barssince(bullFailedAbsActive or bearFailedAbsActive)
    bullFailedBreakout = bullFailedAbsActive and not na(barsSinceFa) and barsSinceFa > 0 and low <= low[1] and close > open
    bearFailedBreakout = bearFailedAbsActive and not na(barsSinceFa) and barsSinceFa > 0 and high >= high[1] and close < open
    bullRetestAfterSrd = bullFailedAbsActive and (bullFade or bullAbs_Srd)
    bearRetestAfterSrd = bearFailedAbsActive and (bearFade or bearAbs_Srd)
    bullFade_final = bullFade and not bullRetestAfterSrd
    bearFade_final = bearFade and not bearRetestAfterSrd
    unifiedBullAbs = bullAbs_Rej or (bullAbs_Srd and not bullRetestAfterSrd)
    unifiedBearAbs = bearAbs_Rej or (bearAbs_Srd and not bearRetestAfterSrd)
    var bool prevActiveDayBull = false
    var bool prevActiveDayBear = false
    bullCont = prevActiveDayBull and close > close[1]
    bearCont = prevActiveDayBear and close < close[1]
    prevActiveDayBull := bullRej or bullSrdSignal or unifiedBullAbs or fnlSignal or bullFailedBreakout or bullRetestAfterSrd
    prevActiveDayBear := bearRej or bearSrdSignal or unifiedBearAbs or fnhSignal or bearFailedBreakout or bearRetestAfterSrd


    // --- TLCS SIGNALS LOGIC (Extracted from Live Alerts) ---
    // EMA Logic
    fPivot = (high + low + close) / 3
    fFastEMA1 = 5
    fSlowEMA1 = 13
    fPivotEMAF1 = ta.ema(fPivot, fFastEMA1)
    fPivotEMAF2 = ta.ema(fPivotEMAF1, fFastEMA1)
    fPivotEMAS1 = ta.ema(fPivot, fSlowEMA1)
    fPivotEMAS2 = ta.ema(fPivotEMAS1, fSlowEMA1)
    PDEMAF = fPivotEMAF1 * 2 - fPivotEMAF2
    PDEMAS = fPivotEMAS1 * 2 - fPivotEMAS2
    fPivotPDEMAF = ta.ema(PDEMAF, fFastEMA1)
    fPivotPDEMAS = ta.ema(PDEMAS, fSlowEMA1)
    fShortEMA = ta.ema(fPivot, 13)
    fMedEMA = ta.ema(fPivot, 32)
    
    // MACD / STEP LOGIC
    upper = ta.highest(92)
    lower = ta.lowest(92)
    out = 100 * (close - upper) / (upper - lower)
    m0 = ta.ema(out, 21)
    m10 = ta.sma(out, 96)
    
    len14 = 14
    up14 = ta.change(high)
    down14 = -ta.change(low)
    plusDM = na(up14) ? na : up14 > down14 and up14 > 0 ? up14 : 0
    minusDM = na(down14) ? na : down14 > up14 and down14 > 0 ? down14 : 0
    trur = ta.rma(ta.tr, len14)
    plus = fixnan(100 * ta.rma(plusDM, len14) / trur)
    minus = fixnan(100 * ta.rma(minusDM, len14) / trur)

    GREENZONE = (plus > minus) and (m0 > m10)
    REDZONE = (minus > plus) and (m0 < m10)

    // REVERSALS MATH
    pivotlbar = 10
    highleftempty = ta.pivothigh(pivotlbar, 0)
    lowleftempty = ta.pivotlow(pivotlbar, 0)

    Wmybodysize = math.abs(close - open)
    WAverageBody = ta.sma(Wmybodysize, Wbarsback)
    Wmycandlesize = high - low
    WAverageCandle = ta.sma(Wmycandlesize, Wbarsback)

    Wlong = close > open and open - low >= (close - open) * wick_multiplier and high - close <= (high - low) * body_percentage or close < open and close - low >= (open - close) * wick_multiplier and high - close <= (high - low) * body_percentage or close == open and close != high and high - low >= (high - close) * wick_multiplier and high - close <= (high - low) * body_percentage or open == high and close == high and high - low >= ta.sma(high - low, 50)
    Wshort = close < open and high - open >= (open - close) * wick_multiplier and close - low <= (high - low) * body_percentage or close > open and high - close >= (close - open) * wick_multiplier and close - low <= (high - low) * body_percentage or close == open and close != low and high - low >= (close - low) * wick_multiplier and close - low <= (high - low) * body_percentage or open == low and close == low and high - low >= ta.sma(high - low, 50)

    Wlongsig = GREENZONE and bool(lowleftempty) and L01 and Wlong and high - low >= WAverageCandle * WBarMultiplier
    Wshortsig = REDZONE and bool(highleftempty) and L01 and Wshort and high - low >= WAverageCandle * WBarMultiplier

    Elongsig = GREENZONE and open[1] - close[1] >= bodysize * (high[1] - low[1]) and high[1] - low[1] > WAverageCandle * bodymultiplier and open[1] - close[1] > WAverageBody and close > open and L02
    Eshortsig = REDZONE and close[1] - open[1] >= bodysize * (high[1] - low[1]) and high[1] - low[1] > WAverageCandle * bodymultiplier and close[1] - open[1] > WAverageBody and open > close and L02

    AverageCandle1 = ta.sma(Wmycandlesize, Wbarsback)
    Olongsig = GREENZONE and low < low[1] and close > high[1] and high - low >= AverageCandle1 * BarMultiplier and L03
    Oshortsig = REDZONE and high > high[1] and close < low[1] and high - low >= AverageCandle1 * BarMultiplier and L03

    frangehl = high[1] - low[1]
    frangeco = math.abs(close[1] - open[1])
    sma10 = ta.sma(close, 10)
    Dshort = frangeco <= frangehl * percentage and close < low[1] and low[1] > sma10 and close < open or close < low[2] and close[1] >= low[2] and frangeco <= frangeco * percentage and close < open and low[2] > sma10
    Dlong = frangeco <= frangehl * percentage and close > high[1] and high[1] < sma10 and close > open or close > high[2] and close[1] <= high[2] and frangeco <= frangeco * percentage and close > open and high[2] < sma10

    Dlongsig = GREENZONE and bool(lowleftempty) and L04 and Dlong and high - low >= WAverageCandle * DBarMultiplier
    Dshortsig = REDZONE and bool(highleftempty) and L04 and Dshort and high - low >= WAverageCandle * DBarMultiplier

    // SIGNAL MATH - Using simple representations due to compilation limits inside request.security on massive ZigZag divergence arrays
    // A simplified Missile proxy using the engine variables
    RisingUp = (plus >= minus) and (fPivotPDEMAF >= fPivotPDEMAS) and (m0 >= m10)
    FallingDown = (minus >= plus) and (fPivotPDEMAF <= fPivotPDEMAS) and (m0 <= m10)
    
    R_up = RisingUp and close > open
    R_dn = FallingDown and close < open
    
    // Using simple proxies for Bounce and Signals
    MissileBuy = R_up and fShortEMA > fMedEMA and close > fMedEMA
    MissileSell = R_dn and fShortEMA < fMedEMA and close < fMedEMA
    
    ScalpBuy = RisingUp and close > open and ta.crossover(fShortEMA, fMedEMA)
    ScalpSell = FallingDown and close < open and ta.crossunder(fShortEMA, fMedEMA)
    
    LightningBuy = RisingUp and ta.crossover(m0, m10)
    LightningSell = FallingDown and ta.crossunder(m0, m10)
    
    CallBuy = RisingUp and close > open and ta.crossover(close, fMedEMA)
    PutSell = FallingDown and close < open and ta.crossunder(close, fMedEMA)
    
    [bullAcc, bearDist, bullRej, bearRej, bullSrdSignal, bearSrdSignal, odBull, odBear, bullFade_final, bearFade_final, unifiedBullAbs, unifiedBearAbs, fnlSignal, fnhSignal, bullFailedBreakout, bearFailedBreakout, bullRetestAfterSrd, bearRetestAfterSrd, bullCont, bearCont, Wlongsig, Wshortsig, Elongsig, Eshortsig, Olongsig, Oshortsig, Dlongsig, Dshortsig, MissileBuy, MissileSell, ScalpBuy, ScalpSell, LightningBuy, LightningSell, CallBuy, PutSell]

// ---------------------------- 4 SECURITY CALLS ----------------------------
[u1acB, u1acS, u1rB, u1rS, u1sB, u1sS, u1odB, u1odS, u1fdB, u1fdS, u1aB, u1aS, u1fB, u1fS, u1fbB, u1fbS, u1rtB, u1rtS, u1cB, u1cS, u1wB, u1wS, u1eB, u1eS, u1oB, u1oS, u1dB, u1dS, u1mB, u1mS, u1scB, u1scS, u1lB, u1lS, u1clB, u1ptS] = request.security(u1, "D", f_calc())
[u2acB, u2acS, u2rB, u2rS, u2sB, u2sS, u2odB, u2odS, u2fdB, u2fdS, u2aB, u2aS, u2fB, u2fS, u2fbB, u2fbS, u2rtB, u2rtS, u2cB, u2cS, u2wB, u2wS, u2eB, u2eS, u2oB, u2oS, u2dB, u2dS, u2mB, u2mS, u2scB, u2scS, u2lB, u2lS, u2clB, u2ptS] = request.security(u2, "D", f_calc())
[u3acB, u3acS, u3rB, u3rS, u3sB, u3sS, u3odB, u3odS, u3fdB, u3fdS, u3aB, u3aS, u3fB, u3fS, u3fbB, u3fbS, u3rtB, u3rtS, u3cB, u3cS, u3wB, u3wS, u3eB, u3eS, u3oB, u3oS, u3dB, u3dS, u3mB, u3mS, u3scB, u3scS, u3lB, u3lS, u3clB, u3ptS] = request.security(u3, "D", f_calc())
[u4acB, u4acS, u4rB, u4rS, u4sB, u4sS, u4odB, u4odS, u4fdB, u4fdS, u4aB, u4aS, u4fB, u4fS, u4fbB, u4fbS, u4rtB, u4rtS, u4cB, u4cS, u4wB, u4wS, u4eB, u4eS, u4oB, u4oS, u4dB, u4dS, u4mB, u4mS, u4scB, u4scS, u4lB, u4lS, u4clB, u4ptS] = request.security(u4, "D", f_calc())

// ---------------------------- COLLECT RESULTS INTO ARRAYS ----------------------------
symArr     = array.new_string()
bullAccArr = array.new_bool()
bearAccArr = array.new_bool()
bullRejArr = array.new_bool()
bearRejArr = array.new_bool()
bullSrdArr = array.new_bool()
bearSrdArr = array.new_bool()
bullOdArr  = array.new_bool()
bearOdArr  = array.new_bool()
bullFadeArr= array.new_bool()
bearFadeArr= array.new_bool()
bullAbsArr = array.new_bool()
bearAbsArr = array.new_bool()
bullFnlArr = array.new_bool()
bearFnhArr = array.new_bool()
bullFbArr  = array.new_bool()
bearFbArr  = array.new_bool()
bullRtArr  = array.new_bool()
bearRtArr  = array.new_bool()
bullContArr= array.new_bool()
bearContArr= array.new_bool()
// Reversals
wBArr = array.new_bool()
wSArr = array.new_bool()
eBArr = array.new_bool()
eSArr = array.new_bool()
oBArr = array.new_bool()
oSArr = array.new_bool()
dBArr = array.new_bool()
dSArr = array.new_bool()
// Signals
mBArr = array.new_bool()
mSArr = array.new_bool()
scBArr = array.new_bool()
scSArr = array.new_bool()
lBArr = array.new_bool()
lSArr = array.new_bool()
clBArr = array.new_bool()
ptSArr = array.new_bool()

f_add(sym, acB, acS, rB, rS, sB, sS, odB, odS, fdB, fdS, aB, aS, fB, fS, fbB, fbS, rtB, rtS, cB, cS, wB, wS, eB, eS, oB, oS, dB, dS, mB, mS, scB, scS, lB, lS, clB, ptS) =>
    if sym != ""
        array.push(symArr, sym)
        array.push(bullAccArr, acB)
        array.push(bearAccArr, acS)
        array.push(bullRejArr, rB)
        array.push(bearRejArr, rS)
        array.push(bullSrdArr, sB)
        array.push(bearSrdArr, sS)
        array.push(bullOdArr, odB)
        array.push(bearOdArr, odS)
        array.push(bullFadeArr, fdB)
        array.push(bearFadeArr, fdS)
        array.push(bullAbsArr, aB)
        array.push(bearAbsArr, aS)
        array.push(bullFnlArr, fB)
        array.push(bearFnhArr, fS)
        array.push(bullFbArr, fbB)
        array.push(bearFbArr, fbS)
        array.push(bullRtArr, rtB)
        array.push(bearRtArr, rtS)
        array.push(bullContArr, cB)
        array.push(bearContArr, cS)
        array.push(wBArr, wB)
        array.push(wSArr, wS)
        array.push(eBArr, eB)
        array.push(eSArr, eS)
        array.push(oBArr, oB)
        array.push(oSArr, oS)
        array.push(dBArr, dB)
        array.push(dSArr, dS)
        array.push(mBArr, mB)
        array.push(mSArr, mS)
        array.push(scBArr, scB)
        array.push(scSArr, scS)
        array.push(lBArr, lB)
        array.push(lSArr, lS)
        array.push(clBArr, clB)
        array.push(ptSArr, ptS)

f_add(u1, u1acB, u1acS, u1rB, u1rS, u1sB, u1sS, u1odB, u1odS, u1fdB, u1fdS, u1aB, u1aS, u1fB, u1fS, u1fbB, u1fbS, u1rtB, u1rtS, u1cB, u1cS, u1wB, u1wS, u1eB, u1eS, u1oB, u1oS, u1dB, u1dS, u1mB, u1mS, u1scB, u1scS, u1lB, u1lS, u1clB, u1ptS)
f_add(u2, u2acB, u2acS, u2rB, u2rS, u2sB, u2sS, u2odB, u2odS, u2fdB, u2fdS, u2aB, u2aS, u2fB, u2fS, u2fbB, u2fbS, u2rtB, u2rtS, u2cB, u2cS, u2wB, u2wS, u2eB, u2eS, u2oB, u2oS, u2dB, u2dS, u2mB, u2mS, u2scB, u2scS, u2lB, u2lS, u2clB, u2ptS)
f_add(u3, u3acB, u3acS, u3rB, u3rS, u3sB, u3sS, u3odB, u3odS, u3fdB, u3fdS, u3aB, u3aS, u3fB, u3fS, u3fbB, u3fbS, u3rtB, u3rtS, u3cB, u3cS, u3wB, u3wS, u3eB, u3eS, u3oB, u3oS, u3dB, u3dS, u3mB, u3mS, u3scB, u3scS, u3lB, u3lS, u3clB, u3ptS)
f_add(u4, u4acB, u4acS, u4rB, u4rS, u4sB, u4sS, u4odB, u4odS, u4fdB, u4fdS, u4aB, u4aS, u4fB, u4fS, u4fbB, u4fbS, u4rtB, u4rtS, u4cB, u4cS, u4wB, u4wS, u4eB, u4eS, u4oB, u4oS, u4dB, u4dS, u4mB, u4mS, u4scB, u4scS, u4lB, u4lS, u4clB, u4ptS)

// ---------------------------- DASHBOARD TABLE (UNIFIED SIGNALS, BLUEPRINTS & SEQUENCES) ----------------------------
if barstate.islast
    tablePos = tablePosStr == "Middle Left" ? position.middle_left : tablePosStr == "Top Left" ? position.top_left : tablePosStr == "Bottom Left" ? position.bottom_left : tablePosStr == "Top Right" ? position.top_right : tablePosStr == "Bottom Right" ? position.bottom_right : position.middle_right
    txtSize  = tableTextSz == "Tiny" ? size.tiny : tableTextSz == "Normal" ? size.normal : size.small

    // Lists - Signals & Reversals
    string r_wB = "", string r_wS = ""
    string r_eB = "", string r_eS = ""
    string r_oB = "", string r_oS = ""
    string r_dB = "", string r_dS = ""
    string r_mB = "", string r_mS = ""
    string r_scB = "", string r_scS = ""
    string r_lB = "", string r_lS = ""
    string r_clB = "", string r_ptS = ""
    
    // Counts - Signals & Reversals
    int c_wB = 0, int c_wS = 0
    int c_eB = 0, int c_eS = 0
    int c_oB = 0, int c_oS = 0
    int c_dB = 0, int c_dS = 0
    int c_mB = 0, int c_mS = 0
    int c_scB = 0, int c_scS = 0
    int c_lB = 0, int c_lS = 0
    int c_clB = 0, int c_ptS = 0

    // Lists - Day Types & Sequences
    string bullRejList = "", string bearRejList = ""
    string bullSrdList = "", string bearSrdList = ""
    string bullOdList  = "", string bearOdList  = ""
    string bullFnlList = "", string bearFnhList = ""
    string bullAbsList = "", string bearAbsList = ""
    string bullFbList  = "", string bearFbList  = ""
    string bullRtList  = "", string bearRtList  = ""
    string bullAccList = "", string bearAccList = ""

    // Counts - Day Types & Sequences
    int bullRejCount = 0, int bearRejCount = 0
    int bullSrdCount = 0, int bearSrdCount = 0
    int bullOdCount  = 0, int bearOdCount  = 0
    int bullFnlCount = 0, int bearFnhCount = 0
    int bullAbsCount = 0, int bearAbsCount = 0
    int bullFbCount  = 0, int bearFbCount  = 0
    int bullRtCount  = 0, int bearRtCount  = 0
    int bullAccCount = 0, int bearAccCount = 0
    
    // Process Arrays
    for idx = 0 to array.size(symArr) - 1
        sym = array.get(symArr, idx)
        splitSym = str.split(sym, ":")
        cleanSym = array.size(splitSym) > 1 ? array.get(splitSym, 1) : sym
        cleanSym := str.replace_all(cleanSym, "1!", "")
        
        // Signals & Reversals
        if array.get(mBArr, idx)
            r_mB += (r_mB == "" ? "" : "
") + cleanSym
            c_mB += 1
        if array.get(mSArr, idx)
            r_mS += (r_mS == "" ? "" : "
") + cleanSym
            c_mS += 1
            
        if array.get(scBArr, idx)
            r_scB += (r_scB == "" ? "" : "
") + cleanSym
            c_scB += 1
        if array.get(scSArr, idx)
            r_scS += (r_scS == "" ? "" : "
") + cleanSym
            c_scS += 1
            
        if array.get(lBArr, idx)
            r_lB += (r_lB == "" ? "" : "
") + cleanSym
            c_lB += 1
        if array.get(lSArr, idx)
            r_lS += (r_lS == "" ? "" : "
") + cleanSym
            c_lS += 1
            
        if array.get(clBArr, idx)
            r_clB += (r_clB == "" ? "" : "
") + cleanSym
            c_clB += 1
        if array.get(ptSArr, idx)
            r_ptS += (r_ptS == "" ? "" : "
") + cleanSym
            c_ptS += 1

        if array.get(wBArr, idx)
            r_wB += (r_wB == "" ? "" : "
") + cleanSym
            c_wB += 1
        if array.get(wSArr, idx)
            r_wS += (r_wS == "" ? "" : "
") + cleanSym
            c_wS += 1
            
        if array.get(eBArr, idx)
            r_eB += (r_eB == "" ? "" : "
") + cleanSym
            c_eB += 1
        if array.get(eSArr, idx)
            r_eS += (r_eS == "" ? "" : "
") + cleanSym
            c_eS += 1
            
        if array.get(oBArr, idx)
            r_oB += (r_oB == "" ? "" : "
") + cleanSym
            c_oB += 1
        if array.get(oSArr, idx)
            r_oS += (r_oS == "" ? "" : "
") + cleanSym
            c_oS += 1
            
        if array.get(dBArr, idx)
            r_dB += (r_dB == "" ? "" : "
") + cleanSym
            c_dB += 1
        if array.get(dSArr, idx)
            r_dS += (r_dS == "" ? "" : "
") + cleanSym
            c_dS += 1

        // Blueprints & Sequences
        if array.get(bullRejArr, idx)
            bullRejList += (bullRejList == "" ? "" : "
") + cleanSym
            bullRejCount += 1
        if array.get(bearRejArr, idx)
            bearRejList += (bearRejList == "" ? "" : "
") + cleanSym
            bearRejCount += 1

        if array.get(bullSrdArr, idx)
            bullSrdList += (bullSrdList == "" ? "" : "
") + cleanSym
            bullSrdCount += 1
        if array.get(bearSrdArr, idx)
            bearSrdList += (bearSrdList == "" ? "" : "
") + cleanSym
            bearSrdCount += 1

        if array.get(bullOdArr, idx)
            bullOdList += (bullOdList == "" ? "" : "
") + cleanSym
            bullOdCount += 1
        if array.get(bearOdArr, idx)
            bearOdList += (bearOdList == "" ? "" : "
") + cleanSym
            bearOdCount += 1

        if array.get(bullFnlArr, idx)
            bullFnlList += (bullFnlList == "" ? "" : "
") + cleanSym
            bullFnlCount += 1
        if array.get(bearFnhArr, idx)
            bearFnhList += (bearFnhList == "" ? "" : "
") + cleanSym
            bearFnhCount += 1

        if array.get(bullAbsArr, idx)
            bullAbsList += (bullAbsList == "" ? "" : "
") + cleanSym
            bullAbsCount += 1
        if array.get(bearAbsArr, idx)
            bearAbsList += (bearAbsList == "" ? "" : "
") + cleanSym
            bearAbsCount += 1

        if array.get(bullFbArr, idx)
            bullFbList += (bullFbList == "" ? "" : "
") + cleanSym
            bullFbCount += 1
        if array.get(bearFbArr, idx)
            bearFbList += (bearFbList == "" ? "" : "
") + cleanSym
            bearFbCount += 1

        if array.get(bullRtArr, idx)
            bullRtList += (bullRtList == "" ? "" : "
") + cleanSym
            bullRtCount += 1
        if array.get(bearRtArr, idx)
            bearRtList += (bearRtList == "" ? "" : "
") + cleanSym
            bearRtCount += 1

        if array.get(bullAccArr, idx)
            bullAccList += (bullAccList == "" ? "" : "
") + cleanSym
            bullAccCount += 1
        if array.get(bearAccArr, idx)
            bearAccList += (bearAccList == "" ? "" : "
") + cleanSym
            bearAccCount += 1

    var table dash1 = table.new(tablePos, 3, 25, border_width=1, frame_width=1, frame_color=color.rgb(12, 246, 250))
    int curR = 0

    // SECTION 1: SIGNALS & REVERSALS
    int totalSigs = c_mB + c_mS + c_scB + c_scS + c_lB + c_lS + c_clB + c_ptS + c_wB + c_wS + c_eB + c_eS + c_oB + c_oS + c_dB + c_dS
    if totalSigs > 0
        table.merge_cells(dash1, 0, curR, 2, curR)
        table.cell(dash1, 0, curR, "TLCS SIGNALS & REVERSALS (4)", bgcolor=color.new(#116ac2, 0), text_color=color.rgb(12, 246, 250), text_size=txtSize)
        curR += 1

        if c_mB > 0 or c_mS > 0
            table.cell(dash1, 0, curR, "Missile", bgcolor=color.new(#0c1220, 15), text_color=color.rgb(12, 246, 250), text_size=txtSize)
            table.cell(dash1, 1, curR, c_mB > 0 ? "▲ " + str.tostring(c_mB) + "
" + r_mB : "-", bgcolor=c_mB > 0 ? color.new(color.lime, 80) : color.new(#0c1220, 15), text_color=c_mB > 0 ? color.green : color.gray, text_size=txtSize)
            table.cell(dash1, 2, curR, c_mS > 0 ? "▼ " + str.tostring(c_mS) + "
" + r_mS : "-", bgcolor=c_mS > 0 ? color.new(color.red, 80) : color.new(#0c1220, 15), text_color=c_mS > 0 ? color.red : color.gray, text_size=txtSize)
            curR += 1

        if c_scB > 0 or c_scS > 0
            table.cell(dash1, 0, curR, "Scalp", bgcolor=color.new(#0c1220, 15), text_color=color.rgb(12, 246, 250), text_size=txtSize)
            table.cell(dash1, 1, curR, c_scB > 0 ? "▲ " + str.tostring(c_scB) + "
" + r_scB : "-", bgcolor=c_scB > 0 ? color.new(color.lime, 80) : color.new(#0c1220, 15), text_color=c_scB > 0 ? color.green : color.gray, text_size=txtSize)
            table.cell(dash1, 2, curR, c_scS > 0 ? "▼ " + str.tostring(c_scS) + "
" + r_scS : "-", bgcolor=c_scS > 0 ? color.new(color.red, 80) : color.new(#0c1220, 15), text_color=c_scS > 0 ? color.red : color.gray, text_size=txtSize)
            curR += 1

        if c_lB > 0 or c_lS > 0
            table.cell(dash1, 0, curR, "Lightning", bgcolor=color.new(#0c1220, 15), text_color=color.rgb(12, 246, 250), text_size=txtSize)
            table.cell(dash1, 1, curR, c_lB > 0 ? "▲ " + str.tostring(c_lB) + "
" + r_lB : "-", bgcolor=c_lB > 0 ? color.new(color.lime, 80) : color.new(#0c1220, 15), text_color=c_lB > 0 ? color.green : color.gray, text_size=txtSize)
            table.cell(dash1, 2, curR, c_lS > 0 ? "▼ " + str.tostring(c_lS) + "
" + r_lS : "-", bgcolor=c_lS > 0 ? color.new(color.red, 80) : color.new(#0c1220, 15), text_color=c_lS > 0 ? color.red : color.gray, text_size=txtSize)
            curR += 1

        if c_clB > 0 or c_ptS > 0
            table.cell(dash1, 0, curR, "Call / Put", bgcolor=color.new(#0c1220, 15), text_color=color.rgb(12, 246, 250), text_size=txtSize)
            table.cell(dash1, 1, curR, c_clB > 0 ? "▲ " + str.tostring(c_clB) + "
" + r_clB : "-", bgcolor=c_clB > 0 ? color.new(color.lime, 80) : color.new(#0c1220, 15), text_color=c_clB > 0 ? color.green : color.gray, text_size=txtSize)
            table.cell(dash1, 2, curR, c_ptS > 0 ? "▼ " + str.tostring(c_ptS) + "
" + r_ptS : "-", bgcolor=c_ptS > 0 ? color.new(color.red, 80) : color.new(#0c1220, 15), text_color=c_ptS > 0 ? color.red : color.gray, text_size=txtSize)
            curR += 1

        if c_wB > 0 or c_wS > 0
            table.cell(dash1, 0, curR, "Wick Reversal", bgcolor=color.new(#0c1220, 15), text_color=color.rgb(12, 246, 250), text_size=txtSize)
            table.cell(dash1, 1, curR, c_wB > 0 ? "▲ " + str.tostring(c_wB) + "
" + r_wB : "-", bgcolor=c_wB > 0 ? color.new(color.lime, 80) : color.new(#0c1220, 15), text_color=c_wB > 0 ? color.green : color.gray, text_size=txtSize)
            table.cell(dash1, 2, curR, c_wS > 0 ? "▼ " + str.tostring(c_wS) + "
" + r_wS : "-", bgcolor=c_wS > 0 ? color.new(color.red, 80) : color.new(#0c1220, 15), text_color=c_wS > 0 ? color.red : color.gray, text_size=txtSize)
            curR += 1

        if c_eB > 0 or c_eS > 0
            table.cell(dash1, 0, curR, "Extreme Reversal", bgcolor=color.new(#0c1220, 15), text_color=color.rgb(12, 246, 250), text_size=txtSize)
            table.cell(dash1, 1, curR, c_eB > 0 ? "▲ " + str.tostring(c_eB) + "
" + r_eB : "-", bgcolor=c_eB > 0 ? color.new(color.lime, 80) : color.new(#0c1220, 15), text_color=c_eB > 0 ? color.green : color.gray, text_size=txtSize)
            table.cell(dash1, 2, curR, c_eS > 0 ? "▼ " + str.tostring(c_eS) + "
" + r_eS : "-", bgcolor=c_eS > 0 ? color.new(color.red, 80) : color.new(#0c1220, 15), text_color=c_eS > 0 ? color.red : color.gray, text_size=txtSize)
            curR += 1

        if c_oB > 0 or c_oS > 0
            table.cell(dash1, 0, curR, "Outside Reversal", bgcolor=color.new(#0c1220, 15), text_color=color.rgb(12, 246, 250), text_size=txtSize)
            table.cell(dash1, 1, curR, c_oB > 0 ? "▲ " + str.tostring(c_oB) + "
" + r_oB : "-", bgcolor=c_oB > 0 ? color.new(color.lime, 80) : color.new(#0c1220, 15), text_color=c_oB > 0 ? color.green : color.gray, text_size=txtSize)
            table.cell(dash1, 2, curR, c_oS > 0 ? "▼ " + str.tostring(c_oS) + "
" + r_oS : "-", bgcolor=c_oS > 0 ? color.new(color.red, 80) : color.new(#0c1220, 15), text_color=c_oS > 0 ? color.red : color.gray, text_size=txtSize)
            curR += 1

        if c_dB > 0 or c_dS > 0
            table.cell(dash1, 0, curR, "Doji Reversal", bgcolor=color.new(#0c1220, 15), text_color=color.rgb(12, 246, 250), text_size=txtSize)
            table.cell(dash1, 1, curR, c_dB > 0 ? "▲ " + str.tostring(c_dB) + "
" + r_dB : "-", bgcolor=c_dB > 0 ? color.new(color.lime, 80) : color.new(#0c1220, 15), text_color=c_dB > 0 ? color.green : color.gray, text_size=txtSize)
            table.cell(dash1, 2, curR, c_dS > 0 ? "▼ " + str.tostring(c_dS) + "
" + r_dS : "-", bgcolor=c_dS > 0 ? color.new(color.red, 80) : color.new(#0c1220, 15), text_color=c_dS > 0 ? color.red : color.gray, text_size=txtSize)
            curR += 1

    // SECTION 2: DAY TYPE BLUEPRINTS
    int totalBlueprints = bullRejCount + bearRejCount + bullSrdCount + bearSrdCount + bullOdCount + bearOdCount + bullFnlCount + bearFnhCount + bullAbsCount + bearAbsCount
    if totalBlueprints > 0
        table.merge_cells(dash1, 0, curR, 2, curR)
        table.cell(dash1, 0, curR, "DAY TYPE BLUEPRINTS (4)", bgcolor=color.new(#116ac2, 0), text_color=color.rgb(12, 246, 250), text_size=txtSize)
        curR += 1

        if bullRejCount > 0 or bearRejCount > 0
            table.cell(dash1, 0, curR, "Rejection Day", bgcolor=color.new(#0c1220, 15), text_color=color.rgb(12, 246, 250), text_size=txtSize)
            table.cell(dash1, 1, curR, bullRejCount > 0 ? "▲ " + str.tostring(bullRejCount) + "
" + bullRejList : "-", bgcolor=bullRejCount > 0 ? color.new(color.lime, 80) : color.new(#0c1220, 15), text_color=bullRejCount > 0 ? color.green : color.gray, text_size=txtSize)
            table.cell(dash1, 2, curR, bearRejCount > 0 ? "▼ " + str.tostring(bearRejCount) + "
" + bearRejList : "-", bgcolor=bearRejCount > 0 ? color.new(color.red, 80) : color.new(#0c1220, 15), text_color=bearRejCount > 0 ? color.red : color.gray, text_size=txtSize)
            curR += 1

        if bullAbsCount > 0 or bearAbsCount > 0
            table.cell(dash1, 0, curR, "Absorption Day", bgcolor=color.new(#0c1220, 15), text_color=color.rgb(12, 246, 250), text_size=txtSize)
            table.cell(dash1, 1, curR, bullAbsCount > 0 ? "▲ " + str.tostring(bullAbsCount) + "
" + bullAbsList : "-", bgcolor=bullAbsCount > 0 ? color.new(color.lime, 80) : color.new(#0c1220, 15), text_color=bullAbsCount > 0 ? color.green : color.gray, text_size=txtSize)
            table.cell(dash1, 2, curR, bearAbsCount > 0 ? "▼ " + str.tostring(bearAbsCount) + "
" + bearAbsList : "-", bgcolor=bearAbsCount > 0 ? color.new(color.red, 80) : color.new(#0c1220, 15), text_color=bearAbsCount > 0 ? color.red : color.gray, text_size=txtSize)
            curR += 1

        if bullFnlCount > 0 or bearFnhCount > 0
            table.cell(dash1, 0, curR, "Failed New Low/High", bgcolor=color.new(#0c1220, 15), text_color=color.rgb(12, 246, 250), text_size=txtSize)
            table.cell(dash1, 1, curR, bullFnlCount > 0 ? "▲ " + str.tostring(bullFnlCount) + "
" + bullFnlList : "-", bgcolor=bullFnlCount > 0 ? color.new(color.lime, 80) : color.new(#0c1220, 15), text_color=bullFnlCount > 0 ? color.green : color.gray, text_size=txtSize)
            table.cell(dash1, 2, curR, bearFnhCount > 0 ? "▼ " + str.tostring(bearFnhCount) + "
" + bearFnhList : "-", bgcolor=bearFnhCount > 0 ? color.new(color.red, 80) : color.new(#0c1220, 15), text_color=bearFnhCount > 0 ? color.red : color.gray, text_size=txtSize)
            curR += 1

        if bullOdCount > 0 or bearOdCount > 0
            table.cell(dash1, 0, curR, "Outside Day", bgcolor=color.new(#0c1220, 15), text_color=color.rgb(12, 246, 250), text_size=txtSize)
            table.cell(dash1, 1, curR, bullOdCount > 0 ? "▲ " + str.tostring(bullOdCount) + "
" + bullOdList : "-", bgcolor=bullOdCount > 0 ? color.new(color.lime, 80) : color.new(#0c1220, 15), text_color=bullOdCount > 0 ? color.green : color.gray, text_size=txtSize)
            table.cell(dash1, 2, curR, bearOdCount > 0 ? "▼ " + str.tostring(bearOdCount) + "
" + bearOdList : "-", bgcolor=bearOdCount > 0 ? color.new(color.red, 80) : color.new(#0c1220, 15), text_color=bearOdCount > 0 ? color.red : color.gray, text_size=txtSize)
            curR += 1

        if bullSrdCount > 0 or bearSrdCount > 0
            table.cell(dash1, 0, curR, "Stop Run Day", bgcolor=color.new(#0c1220, 15), text_color=color.rgb(12, 246, 250), text_size=txtSize)
            table.cell(dash1, 1, curR, bullSrdCount > 0 ? "▲ " + str.tostring(bullSrdCount) + "
" + bullSrdList : "-", bgcolor=bullSrdCount > 0 ? color.new(color.lime, 80) : color.new(#0c1220, 15), text_color=bullSrdCount > 0 ? color.green : color.gray, text_size=txtSize)
            table.cell(dash1, 2, curR, bearSrdCount > 0 ? "▼ " + str.tostring(bearSrdCount) + "
" + bearSrdList : "-", bgcolor=bearSrdCount > 0 ? color.new(color.red, 80) : color.new(#0c1220, 15), text_color=bearSrdCount > 0 ? color.red : color.gray, text_size=txtSize)
            curR += 1

    // SECTION 3: TRADE SEQUENCES
    int totalSequences = bullRejCount + bearRejCount + bullSrdCount + bearSrdCount + bullFbCount + bearFbCount + bullRtCount + bearRtCount + bullAccCount + bearAccCount
    if totalSequences > 0
        table.merge_cells(dash1, 0, curR, 2, curR)
        table.cell(dash1, 0, curR, "TRADE SEQUENCES (4)", bgcolor=color.new(#116ac2, 0), text_color=color.rgb(12, 246, 250), text_size=txtSize)
        curR += 1

        if bullRejCount > 0 or bearRejCount > 0
            table.cell(dash1, 0, curR, "Rejection Sequence", bgcolor=color.new(#0c1220, 15), text_color=color.rgb(12, 246, 250), text_size=txtSize)
            table.cell(dash1, 1, curR, bullRejCount > 0 ? "▲ " + str.tostring(bullRejCount) + "
" + bullRejList : "-", bgcolor=bullRejCount > 0 ? color.new(color.lime, 80) : color.new(#0c1220, 15), text_color=bullRejCount > 0 ? color.green : color.gray, text_size=txtSize)
            table.cell(dash1, 2, curR, bearRejCount > 0 ? "▼ " + str.tostring(bearRejCount) + "
" + bearRejList : "-", bgcolor=bearRejCount > 0 ? color.new(color.red, 80) : color.new(#0c1220, 15), text_color=bearRejCount > 0 ? color.red : color.gray, text_size=txtSize)
            curR += 1

        if bullSrdCount > 0 or bearSrdCount > 0
            table.cell(dash1, 0, curR, "Stop Run Sequence", bgcolor=color.new(#0c1220, 15), text_color=color.rgb(12, 246, 250), text_size=txtSize)
            table.cell(dash1, 1, curR, bullSrdCount > 0 ? "▲ " + str.tostring(bullSrdCount) + "
" + bullSrdList : "-", bgcolor=bullSrdCount > 0 ? color.new(color.lime, 80) : color.new(#0c1220, 15), text_color=bullSrdCount > 0 ? color.green : color.gray, text_size=txtSize)
            table.cell(dash1, 2, curR, bearSrdCount > 0 ? "▼ " + str.tostring(bearSrdCount) + "
" + bearSrdList : "-", bgcolor=bearSrdCount > 0 ? color.new(color.red, 80) : color.new(#0c1220, 15), text_color=bearSrdCount > 0 ? color.red : color.gray, text_size=txtSize)
            curR += 1

        if (bullFbCount + bullRtCount) > 0 or (bearFbCount + bearRtCount) > 0
            table.cell(dash1, 0, curR, "Failed Absorption Sequence", bgcolor=color.new(#0c1220, 15), text_color=color.rgb(12, 246, 250), text_size=txtSize)
            table.cell(dash1, 1, curR, (bullFbCount + bullRtCount) > 0 ? "▲ " + str.tostring(bullFbCount + bullRtCount) + "
" + (bullFbList != "" ? bullFbList : bullRtList) : "-", bgcolor=(bullFbCount + bullRtCount) > 0 ? color.new(color.lime, 80) : color.new(#0c1220, 15), text_color=(bullFbCount + bullRtCount) > 0 ? color.green : color.gray, text_size=txtSize)
            table.cell(dash1, 2, curR, (bearFbCount + bearRtCount) > 0 ? "▼ " + str.tostring(bearFbCount + bearRtCount) + "
" + (bearFbList != "" ? bearFbList : bearRtList) : "-", bgcolor=(bearFbCount + bearRtCount) > 0 ? color.new(color.red, 80) : color.new(#0c1220, 15), text_color=(bearFbCount + bearRtCount) > 0 ? color.red : color.gray, text_size=txtSize)
            curR += 1

        if bullAccCount > 0 or bearAccCount > 0
            table.cell(dash1, 0, curR, "Accumulation Sequence", bgcolor=color.new(#0c1220, 15), text_color=color.rgb(12, 246, 250), text_size=txtSize)
            table.cell(dash1, 1, curR, bullAccCount > 0 ? "▲ " + str.tostring(bullAccCount) + "
" + bullAccList : "-", bgcolor=bullAccCount > 0 ? color.new(color.lime, 80) : color.new(#0c1220, 15), text_color=bullAccCount > 0 ? color.green : color.gray, text_size=txtSize)
            table.cell(dash1, 2, curR, bearAccCount > 0 ? "▼ " + str.tostring(bearAccCount) + "
" + bearAccList : "-", bgcolor=bearAccCount > 0 ? color.new(color.red, 80) : color.new(#0c1220, 15), text_color=bearAccCount > 0 ? color.red : color.gray, text_size=txtSize)
            curR += 1

    if curR == 0
        table.merge_cells(dash1, 0, 0, 2, 0)
        table.cell(dash1, 0, 0, "NO ACTIVE SIGNALS / BLUEPRINTS", bgcolor=color.new(#0c1220, 15), text_color=color.gray, text_size=txtSize)
