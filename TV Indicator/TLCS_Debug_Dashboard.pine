    var SeqState st = SeqState.new()
    [acB, acS, rB, rS, sB, sS, odB, odS, fdB, fdS, aB, aS, fB, fS, fbB, fbS, rtB, rtS, cContB, cContS, rejActB, rejActS, srdActB, srdActS, faActB, faActS, accActB, accActS] = f_calc(st)
    packSignals28(acB, acS, rB, rS, sB, sS, odB, odS, fdB, fdS, aB, aS, fB, fS, fbB, fbS, rtB, rtS, cContB, cContS, rejActB, rejActS, srdActB, srdActS, faActB, faActS, accActB, accActS)

f_calc_dt_9() =>
    var SeqState st = SeqState.new()
    [acB, acS, rB, rS, sB, sS, odB, odS, fdB, fdS, aB, aS, fB, fS, fbB, fbS, rtB, rtS, cContB, cContS, rejActB, rejActS, srdActB, srdActS, faActB, faActS, accActB, accActS] = f_calc(st)
    packSignals28(acB, acS, rB, rS, sB, sS, odB, odS, fdB, fdS, aB, aS, fB, fS, fbB, fbS, rtB, rtS, cContB, cContS, rejActB, rejActS, srdActB, srdActS, faActB, faActS, accActB, accActS)

// ---- SYMBOLS & REQUESTS -----------------------------------------
gDomestic = "Domestic Markets (NSE / MCX)"
u1 = input.symbol("NSEIX:NIFTY1!", "GIFT NIFTY Futures", group=gDomestic)
u2 = input.symbol("MCX:NATURALGAS1!", "MCX NaturalGas", group=gDomestic)
u3 = input.symbol("MCX:CRUDEOIL1!", "MCX CrudeOil", group=gDomestic)
u4 = input.symbol("MCX:GOLD1!", "MCX Gold", group=gDomestic)
u5 = input.symbol("MCX:SILVER1!", "MCX Silver", group=gDomestic)

gNymex = "Commodities (NYMEX/COMEX)"
u6 = input.symbol("NYMEX:CL1!", "Futures 1 (Crude)", group=gNymex)
u7 = input.symbol("NYMEX:NG1!", "Futures 2 (NatGas)", group=gNymex)
u8 = input.symbol("COMEX:GC1!", "Futures 3 (Gold)", group=gNymex)
u9 = input.symbol("COMEX:SI1!", "Futures 4 (Silver)", group=gNymex)

gDisplay = "Dashboard Display"
tableTextSz  = input.string("Small", "Table Text Size", options=["Tiny", "Small", "Normal"], group=gDisplay)

f_dbgCell(pack, bullBit, bearBit) =>
    bullHit = unpackBit(pack, bullBit)
    bearHit = unpackBit(pack, bearBit)
    bullHit and bearHit ? "▲▼" : bullHit ? "▲" : bearHit ? "▼" : "-"

[u1_s0, u1_d0] = request.security(u1, "D", [f_calc_sigs_1(), f_calc_dt_1()], lookahead=barmerge.lookahead_on)
[u2_s0, u2_d0] = request.security(u2, "D", [f_calc_sigs_2(), f_calc_dt_2()], lookahead=barmerge.lookahead_on)
[u3_s0, u3_d0] = request.security(u3, "D", [f_calc_sigs_3(), f_calc_dt_3()], lookahead=barmerge.lookahead_on)
[u4_s0, u4_d0] = request.security(u4, "D", [f_calc_sigs_4(), f_calc_dt_4()], lookahead=barmerge.lookahead_on)
[u5_s0, u5_d0] = request.security(u5, "D", [f_calc_sigs_5(), f_calc_dt_5()], lookahead=barmerge.lookahead_on)
[u6_s0, u6_d0] = request.security(u6, "D", [f_calc_sigs_6(), f_calc_dt_6()], lookahead=barmerge.lookahead_on)
[u7_s0, u7_d0] = request.security(u7, "D", [f_calc_sigs_7(), f_calc_dt_7()], lookahead=barmerge.lookahead_on)
[u8_s0, u8_d0] = request.security(u8, "D", [f_calc_sigs_8(), f_calc_dt_8()], lookahead=barmerge.lookahead_on)
[u9_s0, u9_d0] = request.security(u9, "D", [f_calc_sigs_9(), f_calc_dt_9()], lookahead=barmerge.lookahead_on)

f_simplifySym(sym) =>
    parts = str.split(sym, ":")
    base  = array.size(parts) > 1 ? array.get(parts, array.size(parts) - 1) : array.get(parts, 0)
    base := str.replace(base, "1!", "")
    base

if barstate.islast
    txtSize = tableTextSz == "Tiny" ? size.tiny : tableTextSz == "Normal" ? size.normal : size.small

    // ---- ALL SIGNAL TYPES + BLUEPRINTS + SEQUENCES (FULL DEBUG ENGINE) -------
    dbgLabels  = array.from("Missile", "Scalp", "Lightning", "Wick Reversal", "Extreme Reversal", "Outside Reversal", "Doji Reversal", "Price Divergences", "Hidden Divergences", "Rejection Day", "Absorption Day", "Failed New Low/High", "Outside Day", "Stop Run Day", "Rejection Seq", "Stop Run Seq", "Failed Abs Seq", "Acc/Dist Seq")
    dbgBullBit = array.from(1, 4, 16, 64, 256, 1024, 4096, 16384, 65536, 4, 1024, 4096, 64, 16, 1048576, 4194304, 16777216, 67108864)
    dbgBearBit = array.from(2, 8, 32, 128, 512, 2048, 8192, 32768, 131072, 8, 2048, 8192, 128, 32, 2097152, 8388608, 33554432, 134217728)
    dbgUseSig  = array.from(true, true, true, true, true, true, true, true, true, false, false, false, false, false, false, false, false, false)

    sigPacks = array.from(u1_s0, u2_s0, u3_s0, u4_s0, u5_s0, u6_s0, u7_s0, u8_s0, u9_s0)
    dtPacks  = array.from(u1_d0, u2_d0, u3_d0, u4_d0, u5_d0, u6_d0, u7_d0, u8_d0, u9_d0)
    symNames = array.from(f_simplifySym(u1), f_simplifySym(u2), f_simplifySym(u3), f_simplifySym(u4), f_simplifySym(u5), f_simplifySym(u6), f_simplifySym(u7), f_simplifySym(u8), f_simplifySym(u9))

    numDbgRows = array.size(dbgLabels)
    numDbgCols = 9

    cellMat = matrix.new<string>(numDbgRows, numDbgCols, "-")
    for r = 0 to numDbgRows - 1
        useSig = array.get(dbgUseSig, r)
        bBit   = array.get(dbgBullBit, r)
        brBit  = array.get(dbgBearBit, r)
        for c = 0 to numDbgCols - 1
            pack = useSig ? array.get(sigPacks, c) : array.get(dtPacks, c)
            matrix.set(cellMat, r, c, f_dbgCell(pack, bBit, brBit))

    rowActive = array.new<bool>(numDbgRows, false)
    colActive = array.new<bool>(numDbgCols, false)
    for r = 0 to numDbgRows - 1
        for c = 0 to numDbgCols - 1
            if matrix.get(cellMat, r, c) != "-"
                array.set(rowActive, r, true)
                array.set(colActive, c, true)

    activeCols = array.new<int>()
    for c = 0 to numDbgCols - 1
        if array.get(colActive, c)
            array.push(activeCols, c)
    numActiveCols = array.size(activeCols)

    activeRows = array.new<int>()
    for r = 0 to numDbgRows - 1
        if array.get(rowActive, r)
            array.push(activeRows, r)
    numActiveRows = array.size(activeRows)

    // -- Stop Run Debug Table: Always show, even if empty --
    if numActiveCols == 0 or numActiveRows == 0
        table dashDebugEmpty = table.new(position.top_right, 1, 1, border_width=1, frame_width=1, frame_color=color.rgb(255, 165, 0))
        table.cell(dashDebugEmpty, 0, 0, "ALL FILTERS DEBUG\n(0 Signals Today)", bgcolor=color.new(color.orange, 0), text_color=color.black, text_size=txtSize, text_halign=text.align_center)
    else
        table dashDebug = table.new(position.top_right, numActiveCols + 1, numActiveRows + 2, border_width=1, frame_width=1, frame_color=color.rgb(255, 165, 0))
        table.merge_cells(dashDebug, 0, 0, numActiveCols, 0)
        table.cell(dashDebug, 0, 0, "ALL FILTERS DEBUG (Today, All Symbols)", bgcolor=color.new(color.orange, 0), text_color=color.black, text_size=txtSize, text_halign=text.align_center)
        table.cell(dashDebug, 0, 1, "Filter Type", bgcolor=color.new(color.orange, 60), text_color=color.black, text_size=txtSize, text_halign=text.align_right)

        for i = 0 to numActiveCols - 1
            origCol = array.get(activeCols, i)
            table.cell(dashDebug, i + 1, 1, array.get(symNames, origCol), bgcolor=color.new(color.orange, 60), text_color=color.black, text_size=txtSize, text_halign=text.align_center)

        for j = 0 to numActiveRows - 1
            origRow = array.get(activeRows, j)
            rowNum = j + 2
            table.cell(dashDebug, 0, rowNum, array.get(dbgLabels, origRow), bgcolor=color.new(color.orange, 60), text_color=color.black, text_size=txtSize, text_halign=text.align_right)
            for i = 0 to numActiveCols - 1
                origCol = array.get(activeCols, i)
                val = matrix.get(cellMat, origRow, origCol)
                valFg = val == "▲▼" ? color.rgb(180, 83, 9) : val == "▲" ? color.rgb(0, 130, 0) : val == "▼" ? color.rgb(204, 0, 0) : color.rgb(120, 120, 120)
                table.cell(dashDebug, i + 1, rowNum, val, bgcolor=color.new(color.orange, 60), text_color=valFg, text_size=txtSize, text_halign=text.align_center)
