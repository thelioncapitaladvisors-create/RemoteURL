// ---- MEMORY OPTIMIZATION: BITMASK PACKING (PINE SAFE) -----------------------
packSignals18(b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14, b15, b16, b17, b18) =>
    r = (b1 ? 1 : 0) + (b2 ? 2 : 0) + (b3 ? 4 : 0) + (b4 ? 8 : 0)
    r += (b5 ? 16 : 0) + (b6 ? 32 : 0) + (b7 ? 64 : 0) + (b8 ? 128 : 0)
    r += (b9 ? 256 : 0) + (b10 ? 512 : 0) + (b11 ? 1024 : 0) + (b12 ? 2048 : 0)
    r += (b13 ? 4096 : 0) + (b14 ? 8192 : 0) + (b15 ? 16384 : 0) + (b16 ? 32768 : 0)
    r += (b17 ? 65536 : 0) + (b18 ? 131072 : 0)
    r

packSignals20(b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14, b15, b16, b17, b18, b19, b20) =>
    r = (b1 ? 1 : 0) + (b2 ? 2 : 0) + (b3 ? 4 : 0) + (b4 ? 8 : 0)
    r += (b5 ? 16 : 0) + (b6 ? 32 : 0) + (b7 ? 64 : 0) + (b8 ? 128 : 0)
    r += (b9 ? 256 : 0) + (b10 ? 512 : 0) + (b11 ? 1024 : 0) + (b12 ? 2048 : 0)
    r += (b13 ? 4096 : 0) + (b14 ? 8192 : 0) + (b15 ? 16384 : 0) + (b16 ? 32768 : 0)
    r += (b17 ? 65536 : 0) + (b18 ? 131072 : 0) + (b19 ? 262144 : 0) + (b20 ? 524288 : 0)
    r

packSignals28(b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14, b15, b16, b17, b18, b19, b20, b21, b22, b23, b24, b25, b26, b27, b28) =>
    r = (b1 ? 1 : 0) + (b2 ? 2 : 0) + (b3 ? 4 : 0) + (b4 ? 8 : 0)
    r += (b5 ? 16 : 0) + (b6 ? 32 : 0) + (b7 ? 64 : 0) + (b8 ? 128 : 0)
    r += (b9 ? 256 : 0) + (b10 ? 512 : 0) + (b11 ? 1024 : 0) + (b12 ? 2048 : 0)
    r += (b13 ? 4096 : 0) + (b14 ? 8192 : 0) + (b15 ? 16384 : 0) + (b16 ? 32768 : 0)
    r += (b17 ? 65536 : 0) + (b18 ? 131072 : 0) + (b19 ? 262144 : 0) + (b20 ? 524288 : 0)
    r += (b21 ? 1048576 : 0) + (b22 ? 2097152 : 0) + (b23 ? 4194304 : 0) + (b24 ? 8388608 : 0)
    r += (b25 ? 16777216 : 0) + (b26 ? 33554432 : 0) + (b27 ? 67108864 : 0) + (b28 ? 134217728 : 0)
    r

unpackBit(pack, bit) => (math.floor(pack / bit) % 2) != 0

// ---- SUPPORT & RESISTANCE INPUTS -------------------------------------------
srMaxBreaks  = input.int(3, 'S&R Max Breaks', minval = 2, group = 'Support & Resistance')
srMaxDistPct = input.float(2.0, 'S&R Max Distance %', minval = 0.1, group = 'Support & Resistance')
srLookback   = input.int(100, 'Reversal-Candle Lookback (bars)', minval = 20, group = 'Support & Resistance')

// ---- REVERSAL SYSTEM INPUTS (AUTHENTIC MASTER RULES) -----------------------
pivotlbar       = input.int(10, 'Length to Highest/Lowest (Reversals)', group='Reversal Systems')
wick_multiplier = input.float(3.25, 'Wick Multiplier', step=0.5, maxval=20, group='Reversal Systems')
body_percentage = input.float(0.35, 'Body Percentage', step=0.1, maxval=1, group='Reversal Systems')
WBarMultiplier  = input.float(1.1, 'Body & Candle Range Multiplier', step=0.1, maxval=5, group='Reversal Systems')
Wbarsback       = input.int(50, 'Average Candle and Body Lookback', group='Reversal Systems')
ext_bodysize    = input.float(0.75, 'Extreme Reversal Body Size Ratio', step=0.05, maxval=1, group='Reversal Systems')
ext_bodymult    = input.float(2.0, 'Extreme Reversal Candle Multiplier', step=0.25, maxval=5, group='Reversal Systems')
out_barmult     = input.float(1.25, 'Outside Reversal Multiplier', step=0.05, maxval=3.5, group='Reversal Systems')
doji_barmult    = input.float(0.65, 'Doji Reversal Multiplier', step=0.05, maxval=3.5, group='Reversal Systems')
doji_pct        = input.float(0.10, 'Doji Body Percentage', step=0.05, minval=0.05, group='Reversal Systems')

// ---- DIVERGENCE SETTINGS (AUTHENTIC ZIGZAG ENGINE) ------------------------
gDiv           = "Divergence Settings"
divOscType     = input.string('rsi', 'Divergence Oscillator', ['rsi', 'cci', 'cmo', 'cog', 'mfi', 'roc', 'stoch', 'wpr'], group=gDiv)
divLength      = input.int(14, 'Oscillator Length', minval=1, group=gDiv)
divZigzagLen   = input.int(13, 'Zigzag Length', minval=2, group=gDiv)
divRepaint     = input.bool(true, 'Repaint (Fast Pivot Anchor)', group=gDiv)

// =========================================================================
// AUTHENTIC ZIGZAG DIVERGENCE ENGINE (PARITY WITH MASTER INDICATOR)
// =========================================================================
enum CustomSeries
    EMA
    SMA
    RMA
    HMA
    WMA
    VWMA
    SWMA
    LINREG
    MEDIAN
    MOM
    HIGH
    LOW
    MEDIAN_HIGH
    MEDIAN_LOW
    PERCENTRANK
    HIGHLOW

customseries(float source = close, simple CustomSeries maType = CustomSeries.SMA, simple int length = 14) =>
    switch maType
        CustomSeries.EMA => ta.ema(source, length)
        CustomSeries.SMA => ta.sma(source, length)
        CustomSeries.RMA => ta.rma(source, length)
        CustomSeries.HMA => ta.hma(source, length)
        CustomSeries.WMA => ta.wma(source, length)
        CustomSeries.VWMA => ta.vwma(source, length)
        CustomSeries.SWMA => ta.swma(source)
        CustomSeries.LINREG => ta.linreg(source, length, 0)
        CustomSeries.MEDIAN => ta.median(source, length)
        CustomSeries.MOM => ta.mom(source, length)
        CustomSeries.HIGH => ta.highest(source, length)
        CustomSeries.LOW => ta.lowest(source, length)
        CustomSeries.MEDIAN_HIGH => ta.median(ta.highest(source, length), length)
        CustomSeries.MEDIAN_LOW => ta.median(ta.lowest(source, length), length)
        CustomSeries.PERCENTRANK => ta.percentrank(source, length)
        => (ta.highest(length) + ta.lowest(length)) / 2

method ma(simple CustomSeries maType = CustomSeries.SMA, simple int length = 14, float source = close) =>
    customseries(source, maType, length)

type Indicator
    float indicatorHigh
    float indicatorLow

type PivotCandle
    float _high = high
    float _low = low
    int length = 5
    int pHighBar
    int pLowBar
    float pHigh
    float pLow
    array<Indicator> indicators

type Pivot
    chart.point point
    int dir
    int level = 0
    int componentIndex = 0
    int subComponents = 0
    int microComponents = 1
    float ratio = 1.0
    float sizeRatio = 1.0
    float barRatio = 1.0
    array<Pivot> subPivots
    array<Pivot> micropivots
    array<string> indicatorNames
    array<float> indicatorValues
    array<float> indicatorRatios

type ZigzagFlags
    bool newPivot = false
    bool doublePivot = false
    bool updateLastPivot = false

type Zigzag
    int length = 5
    int numberOfPivots = 20
    int offset = 0
    int level = 0
    array<Pivot> zigzagPivots
    ZigzagFlags flags

method init(array<Indicator> indicators, matrix<float> indicatorValues) =>
    for i = 0 to na(indicatorValues) or indicatorValues.rows() == 0 ? na : indicatorValues.rows() - 1 by 1
        iRow = indicatorValues.row(i)
        Indicator indicator = Indicator.new(iRow.first(), iRow.last())
        indicators.push(indicator)
    indicators

method init(PivotCandle candle, matrix<float> indicators = na) =>
    candle.pHighBar := ta.highestbars(candle._high, candle.length)
    candle.pLowBar := ta.lowestbars(candle._low, candle.length)
    candle.pHigh := ta.highest(candle._high, candle.length)
    candle.pLow := ta.lowest(candle._low, candle.length)
    candle.indicators := array.new<Indicator>()
    candle.indicators.init(indicators)
    candle

method unshift(array<Pivot> arr, Pivot val, int maxItems) =>
    arr.unshift(val)
    if arr.size() > maxItems
        arr.pop()

method update(Pivot this, PivotCandle candle, array<string> indicatorNames) =>
    dir = math.sign(this.dir)
    array<float> _indicators = array.new<float>()
    for indicator in candle.indicators
        indicatorValue = dir > 0 ? indicator.indicatorHigh : indicator.indicatorLow
        _indicators.push(indicatorValue)
    this.indicatorNames := indicatorNames
    this.indicatorValues := _indicators
    this.indicatorRatios := array.new<float>()
    this

method init(Zigzag this) =>
    if na(this.zigzagPivots)
        this.zigzagPivots := array.new<Pivot>()
        this.flags := ZigzagFlags.new()
        this.flags
    this

method addnewpivot(Zigzag this, Pivot pivot, array<Pivot> components = na) =>
    dir = math.sign(pivot.dir)
    if this.zigzagPivots.size() >= 1
        lastPivot = this.zigzagPivots.get(0)
        lastValue = lastPivot.point.price
        pivot.subComponents := lastPivot.componentIndex - pivot.componentIndex
        if not na(components) ? components.size() > lastPivot.componentIndex : false
            pivot.subPivots := components.slice(pivot.componentIndex, lastPivot.componentIndex + 1)
            microComponents = 0
            for [index, subPivot] in pivot.subPivots
                if index != pivot.subPivots.size() - 1
                    microComponents := microComponents + subPivot.microComponents
                    if na(subPivot.micropivots) or subPivot.micropivots.size() == 0
                        pivot.micropivots.push(subPivot)
                    else
                        pivot.micropivots.concat(subPivot.micropivots)
                else if pivot.level == 1
                    pivot.micropivots.push(subPivot)
            pivot.microComponents := microComponents

        if math.sign(lastPivot.dir) == math.sign(dir)
            runtime.error('Direction mismatch')
        if this.zigzagPivots.size() >= 2
            llastPivot = this.zigzagPivots.get(1)
            value = pivot.point.price
            llastValue = llastPivot.point.price
            newDir = dir * value > dir * llastValue ? dir * 2 : dir
            pivot.dir := int(newDir)
            pivot.ratio := math.round(math.abs(lastValue - value) / math.abs(llastValue - lastValue), 3)
            pivot.barRatio := math.round(math.abs(lastPivot.point.index - pivot.point.index) / math.abs(llastPivot.point.index - lastPivot.point.index), 3)

            if this.zigzagPivots.size() >= 3
                lllastPivot = this.zigzagPivots.get(2)
                lllastValue = lllastPivot.point.price
                pivot.sizeRatio := math.round(math.abs(lastValue - value) / math.abs(lllastValue - llastValue), 3)

            llastIndicators = llastPivot.indicatorValues
            indicators = pivot.indicatorValues
            lastIndicators = lastPivot.indicatorValues
            pivot.indicatorRatios.clear()
            for [index, indicatorValue] in indicators
                lastIndicatorValue = lastIndicators.get(index)
                llastIndicatorValue = llastIndicators.get(index)
                indicatorRatio = math.round(math.abs(lastIndicatorValue - indicatorValue) / math.abs(llastIndicatorValue - lastIndicatorValue), 3)
                pivot.indicatorRatios.push(indicatorRatio)
    this.zigzagPivots.unshift(pivot, this.numberOfPivots)
    this

method addnewpivot(Zigzag this, Pivot pivot, PivotCandle candle, array<string> indicatorNames, array<Pivot> components = na) =>
    pivot.update(candle, indicatorNames)
    this.addnewpivot(pivot, components)

method calculate(Zigzag this, array<float> ohlc, matrix<float> indicators, array<string> indicatorNames, int ltfHighTime = time, int ltfLowTime = time) =>
    _ohlc = na(ohlc[this.offset]) ? ohlc : ohlc[this.offset]
    _indicators = na(indicators[this.offset]) ? indicators : indicators[this.offset]
    this.init()
    PivotCandle candle = PivotCandle.new(_ohlc.max(), _ohlc.min(), this.length)
    candle.init(_indicators)
    pDir = 1
    Pivot lastPivot = na
    this.flags.updateLastPivot := false
    this.flags.newPivot := false
    this.flags.doublePivot := false
    newBar = bar_index - this.offset
    newbartime = time[this.offset]
    distanceFromLastPivot = 0
    forceDoublePivot = false

    if this.zigzagPivots.size() > 0
        lastPivot := this.zigzagPivots.get(0)
        pDir := int(math.sign(lastPivot.dir))
        distanceFromLastPivot := newBar - lastPivot.point.index

    if this.zigzagPivots.size() > 1
        llastPivot = this.zigzagPivots.get(1)
        llastDir = int(math.sign(llastPivot.dir))
        forceDoublePivot := pDir == 1 and candle.pLowBar == 0 ? candle.pLow < llastPivot.point.price : pDir == -1 and candle.pHighBar == 0 ? candle.pHigh > llastPivot.point.price : false

    overflow = distanceFromLastPivot >= this.length

    if (pDir == 1 and candle.pHighBar == 0 or pDir == -1 and candle.pLowBar == 0) and this.zigzagPivots.size() >= 1
        value = pDir == 1 ? candle.pHigh : candle.pLow
        ipivot = pDir == 1 ? candle.pLow : candle.pHigh
        inewbartime = pDir == 1 ? ltfHighTime[this.offset] : ltfLowTime[this.offset]
        removeOld = value * lastPivot.dir >= lastPivot.point.price * lastPivot.dir
        if removeOld
            this.flags.updateLastPivot := true
            this.flags.newPivot := true
            this.zigzagPivots.shift()
            newPivotObject = Pivot.new(chart.point.from_index(newBar, value), pDir, micropivots = array.new<Pivot>())
            newPivotObject.point.time := inewbartime
            this.addnewpivot(newPivotObject, candle, indicatorNames)

    if pDir == 1 and candle.pLowBar == 0 or pDir == -1 and candle.pHighBar == 0 and (not this.flags.newPivot or forceDoublePivot)
        value = pDir == 1 ? candle.pLow : candle.pHigh
        inewbartime = pDir == 1 ? ltfLowTime[this.offset] : ltfHighTime[this.offset]
        newPivotObject = Pivot.new(chart.point.from_index(newBar, value), -pDir, micropivots = array.new<Pivot>())
        newPivotObject.point.time := inewbartime
        this.addnewpivot(newPivotObject, candle, indicatorNames)
        this.flags.doublePivot := this.flags.newPivot
        this.flags.newPivot := true

    if overflow and not this.flags.newPivot
        ipivot = pDir == 1 ? candle.pLow : candle.pHigh
        ipivotbar = pDir == 1 ? newBar + candle.pLowBar : newBar + candle.pHighBar
        ipivottime = pDir == 1 ? ltfLowTime[newBar - ipivotbar + this.offset] : ltfHighTime[newBar - ipivotbar + this.offset]
        offset = newBar - ipivotbar
        PivotCandle iCandle = na
        if offset == 0
            iCandle := candle
        else
            iPrice = close[offset]
            iMa    = ta.sma(close, 200)[offset]
            iIndicators = matrix.new<float>()
            iIndicators.add_row(0, array.from(iPrice, iPrice, iPrice))
            iIndicators.add_row(1, array.from(iMa, iMa, iMa))
            iIndicators.add_row(2, array.from(iPrice, iPrice, iPrice))
            iCandle := PivotCandle.new(ipivot, ipivot, this.length)
            iCandle.indicators := array.new<Indicator>()
            iCandle.indicators.init(iIndicators)
        newPivotObject = Pivot.new(chart.point.from_index(ipivotbar, ipivot), -pDir, micropivots = array.new<Pivot>())
        newPivotObject.point.time := ipivottime
        this.addnewpivot(newPivotObject, iCandle, indicatorNames)
        this.flags.newPivot := true
    this

oscillator(simple string type = 'rsi', simple int length = 14, float source = close, float highSource = high, float lowSource = low) =>
    osc = switch type
        'cci'   => ta.cci(source, length)
        'cmo'   => ta.cmo(source, length)
        'cog'   => ta.cog(source, length)
        'mfi'   => ta.mfi(source, length)
        'roc'   => ta.roc(source, length)
        'rsi'   => ta.rsi(source, length)
        'stoch' => ta.stoch(source, highSource, lowSource, length)
        'wpr'   => ta.wpr(length)
        => ta.rsi(source, length)
    osc

enum DivergenceType
    BullishDivergence = "Bullish Divergence"
    BearishDivergence = "Bearish Divergence"
    BullishHiddenDivergence = "Bullish Hidden Divergence"
    BearishHiddenDivergence = "Bearish Hidden Divergence"
    None = "None"

type ZigzagProperties
    int trendMethod = 1
    bool repaint = true

enum PivotDirection
    HH = "Higher High"
    LH = "Lower High"
    HL = "Higher Low"
    LL = "Lower Low"

getDivergenceType(direction, divergence) =>
    direction > 0 ?
         (divergence > 0 ? DivergenceType.BearishDivergence : DivergenceType.BearishHiddenDivergence) :
         (divergence > 0 ? DivergenceType.BullishDivergence : DivergenceType.BullishHiddenDivergence)

getPivotDirection(dir, ratio) =>
    dir > 0 ? (ratio > 1 ? PivotDirection.HH : PivotDirection.LH) : ratio > 1 ? PivotDirection.LL : PivotDirection.HL

type DivergenceSignalObject
    int startIndex
    int endIndex
    DivergenceType divergenceType

method divergenceSignal(Zigzag this, array<DivergenceSignalObject> signalObjects, ZigzagProperties properties) =>
    startIndex = properties.repaint ? 0 : 1
    DivergenceType divergenceType = DivergenceType.None
    if this.zigzagPivots.size() > 2 + startIndex
        lastPivot = this.zigzagPivots.get(startIndex)
        llastPivot = this.zigzagPivots.get(startIndex + 2)
        skip = false
        if this.flags.updateLastPivot
            if signalObjects.size() > 0
                lastSignal = signalObjects.last()
                divergenceStartBar = lastSignal.startIndex
                llastPivotBar = llastPivot.point.index

                divergenceEndBar = lastSignal.endIndex
                lastPivotBar = lastPivot.point.index
                if llastPivotBar == divergenceStartBar and lastPivotBar > divergenceEndBar
                    signalObjects.pop()
                skip := llastPivotBar == divergenceStartBar and lastPivotBar == divergenceEndBar
                skip

        if this.flags.newPivot and not skip
            dir = math.sign(lastPivot.dir)
            lastPrice = lastPivot.indicatorValues.get(0)
            oscRatio = lastPivot.ratio
            priceRatio = lastPivot.indicatorRatios.get(0)

            priceDirection = getPivotDirection(lastPivot.dir, priceRatio)
            oscillatorDirection = getPivotDirection(lastPivot.dir, oscRatio)

            lastTrend = lastPivot.indicatorValues.get(2)
            lastMa = lastPivot.indicatorValues.get(1)

            if priceDirection != oscillatorDirection and llastPivot.indicatorRatios.size() > 0
                llastPrice = llastPivot.indicatorValues.get(0)
                llastRatio = llastPivot.indicatorRatios.get(0)
                llastMa = llastPivot.indicatorValues.get(1)

                sentiment = math.sign(oscRatio - priceRatio)
                trend = properties.trendMethod == 3 ? math.sign(lastTrend) : properties.trendMethod == 1 ? math.sign(dir * (llastRatio - 1)) : math.sign(llastMa - lastMa)
                divergence = trend == dir and sentiment < 0 ? 1 : trend != dir and sentiment > 0 ? -1 : 0

                startBar = llastPivot.point.index
                endBar   = lastPivot.point.index
                startPrice = llastPrice
                endPrice   = lastPrice

                if divergence != 0 and endBar > startBar
                    candidateType = getDivergenceType(dir, divergence)

                    validDivergence = true
                    for bar = startBar + 1 to endBar - 1 by 1
                        offsetBar = bar_index - bar
                        if offsetBar >= 0
                            priceAtBar = close[offsetBar]
                            priceTheo = startPrice + ((endPrice - startPrice) / (endBar - startBar)) * (bar - startBar)

                            if priceAtBar * dir > priceTheo * dir
                                validDivergence := false
                                break

                    if validDivergence
                        divergenceType := candidateType
                        signalObjects.push(DivergenceSignalObject.new(startBar, endBar, divergenceType))
                        if signalObjects.size() > 50
                            signalObjects.shift()

    divergenceType

f_calc_sigs_impl(Zigzag zz, ZigzagProperties zzProps, array<DivergenceSignalObject> divSigObjects) =>
    fPivot = (high + low + close) / 3
    fFastEMA1 = 5
    fSlowEMA1 = 13
    fPivotEMAF1 = ta.ema(fPivot, fFastEMA1)
    fPivotEMAF2 = ta.ema(fPivotEMAF1, fFastEMA1)
    fPivotEMAS1 = ta.ema(fPivot, fSlowEMA1)
    fPivotEMAS2 = ta.ema(fPivotEMAS1, fSlowEMA1)
    PDEMAF = fPivotEMAF1 * 2 - fPivotEMAF2
    PDEMAS = fPivotEMAS1 * 2 - fPivotEMAS2
    fPivotPDEMAF = ta.ema(PDEMAF, fFastEMA1)
    fPivotPDEMAS = ta.ema(PDEMAS, fSlowEMA1)
    fShortEMA = ta.ema(fPivot, 13)
    fMedEMA = ta.ema(fPivot, 32)
    upper = ta.highest(92)
    lower = ta.lowest(92)
    out = 100 * (close - upper) / (upper - lower)
    m0 = ta.ema(out, 21)
    m10 = ta.sma(out, 96)
    len14 = 14
    up14 = ta.change(high)
    down14 = -ta.change(low)
    plusDM = na(up14) ? na : (up14 > down14 and up14 > 0 ? up14 : 0)
    minusDM = na(down14) ? na : (down14 > up14 and down14 > 0 ? down14 : 0)
    trur = ta.rma(ta.tr, len14)
    plus = fixnan(100 * ta.rma(plusDM, len14) / trur)
    minus = fixnan(100 * ta.rma(minusDM, len14) / trur)

    GREEN = (plus > minus) and (m0 > m10)
    RED   = (minus > plus) and (m0 < m10)
    GREENZONE = GREEN
    REDZONE   = RED

    // Missile S&R Bounce Detection
    bullpower = open[1] > close[1] ? close > open ? close >= open[1] ? close[1] >= open ? close - open > open[1] - close[1] ? 1 : na : na : na : na : na
    bearpower = close[1] > open[1] ? open > close ? open >= close[1] ? open[1] >= close ? open - close > close[1] - open[1] ? 1 : na : na : na : na : na
    intraMid = (high + low) / 2

    bool bouncedUpAnyLevel   = false
    bool bouncedDownAnyLevel = false
    
    for i = 1 to srLookback
        if not na(bearpower[i])
            rv = intraMid[i]
            if math.abs(rv - close) / close * 100 < srMaxDistPct
                int breaks = 0
                for j = i - 1 to 0
                    if (open[j] < rv and close[j] > rv) or (open[j] > rv and close[j] < rv)
                        breaks += 1
                if breaks < srMaxBreaks
                    if high >= rv and open <= rv and low < rv and close < rv and close < open
                        bouncedDownAnyLevel := true
        
        if not na(bullpower[i])
            sv = intraMid[i]
            if math.abs(sv - close) / close * 100 < srMaxDistPct
                int breaks = 0
                for j = i - 1 to 0
                    if (open[j] < sv and close[j] > sv) or (open[j] > sv and close[j] < sv)
                        breaks += 1
                if breaks < srMaxBreaks
                    if low <= sv and open >= sv and high > sv and close > sv and close > open
                        bouncedUpAnyLevel := true

    bool GrS = GREEN and bouncedUpAnyLevel
    bool ReS = RED and bouncedDownAnyLevel

    RisingUp = (plus >= minus) and (fPivotPDEMAF >= fPivotPDEMAS) and (m0 >= m10)
    FallingDown = (minus >= plus) and (fPivotPDEMAF <= fPivotPDEMAS) and (m0 <= m10)

    _mb = GrS
    _ms = ReS
    _sb = RisingUp and close > open and ta.crossover(fShortEMA, fMedEMA)
    _ss = FallingDown and close < open and ta.crossunder(fShortEMA, fMedEMA)
    _lb = RisingUp and ta.crossover(m0, m10)
    _ls = FallingDown and ta.crossunder(m0, m10)

    // Pivot High / Low for Reversals (Strict 10-bar pivot)
    highleftempty = ta.pivothigh(pivotlbar, 0)
    lowleftempty  = ta.pivotlow(pivotlbar, 0)

    // 1. Wick Reversal System
    Wmybodysize    = math.abs(close - open)
    WAverageBody   = ta.sma(Wmybodysize, Wbarsback)
    Wmycandlesize  = high - low
    WAverageCandle = ta.sma(Wmycandlesize, Wbarsback)

    Wlong = close > open and open - low >= (close - open) * wick_multiplier and high - close <= (high - low) * body_percentage or 
       close < open and close - low >= (open - close) * wick_multiplier and high - close <= (high - low) * body_percentage or 
       close == open and close != high and high - low >= (high - close) * wick_multiplier and high - close <= (high - low) * body_percentage or 
       open == high and close == high and high - low >= ta.sma(high - low, 50)

    Wshort = close < open and high - open >= (open - close) * wick_multiplier and close - low <= (high - low) * body_percentage or 
       close > open and high - close >= (close - open) * wick_multiplier and close - low <= (high - low) * body_percentage or 
       close == open and close != low and high - low >= (close - low) * wick_multiplier and close - low <= (high - low) * body_percentage or 
       open == low and close == low and high - low >= ta.sma(high - low, 50)

    _wls = GREENZONE and not na(lowleftempty) and Wlong and (high - low >= WAverageCandle * WBarMultiplier)
    _wss = REDZONE and not na(highleftempty) and Wshort and (high - low >= WAverageCandle * WBarMultiplier)

    // 2. Extreme Reversal System
    AverageCandle = ta.sma(high - low, 50)
    AverageBody   = ta.sma(math.abs(open - close), 50)

    _els = GREENZONE and (open[1] - close[1] >= ext_bodysize * (high[1] - low[1])) and (high[1] - low[1] > AverageCandle * ext_bodymult) and (open[1] - close[1] > AverageBody) and (close > open)
    _ess = REDZONE and (close[1] - open[1] >= ext_bodysize * (high[1] - low[1])) and (high[1] - low[1] > AverageCandle * ext_bodymult) and (close[1] - open[1] > AverageBody) and (open > close)

    // 3. Outside Reversal System
    AverageCandle1 = ta.sma(high - low, 50)
    _ols = GREENZONE and (low < low[1]) and (close > high[1]) and (high - low >= AverageCandle1 * out_barmult)
    _oss = REDZONE and (high > high[1]) and (close < low[1]) and (high - low >= AverageCandle1 * out_barmult)

    // 4. Doji Reversal System
    frangehl = high[1] - low[1]
    frangeco = math.abs(close[1] - open[1])
    sma10 = ta.sma(close, 10)

    Dshort = (frangeco <= frangehl * doji_pct and close < low[1] and low[1] > sma10 and close < open) or 
       (close < low[2] and close[1] >= low[2] and frangeco <= frangeco * doji_pct and close < open and low[2] > sma10)

    Dlong = (frangeco <= frangehl * doji_pct and close > high[1] and high[1] < sma10 and close > open) or 
       (close > high[2] and close[1] <= high[2] and frangeco <= frangeco * doji_pct and close > open and high[2] < sma10)

    _dls = GREENZONE and not na(lowleftempty) and Dlong and (high - low >= WAverageCandle * doji_barmult)
    _dss = REDZONE and not na(highleftempty) and Dshort and (high - low >= WAverageCandle * doji_barmult)

    // 5. Divergences (Authentic Zigzag Divergence Engine)
    oscVal = oscillator(divOscType, divLength)
    maVal  = ta.sma(close, 200)
    divIndicators = matrix.new<float>()
    divIndicatorNames = array.from('Price', 'SMA-200', 'External Trend')
    divIndicators.add_row(0, array.from(close, close, close))
    divIndicators.add_row(1, array.from(maVal, maVal, maVal))
    divIndicators.add_row(2, array.from(close, close, close))

    zzProps.repaint := divRepaint
    zz.length := divZigzagLen
    zz.calculate(array.from(oscVal), divIndicators, divIndicatorNames)
    currentDiv = zz.divergenceSignal(divSigObjects, zzProps)

    _bDiv   = currentDiv == DivergenceType.BullishDivergence
    _brDiv  = currentDiv == DivergenceType.BearishDivergence
    _bhDiv  = currentDiv == DivergenceType.BullishHiddenDivergence
    _brhDiv = currentDiv == DivergenceType.BearishHiddenDivergence

    packSignals18(_mb, _ms, _sb, _ss, _lb, _ls, _wls, _wss, _els, _ess, _ols, _oss, _dls, _dss, _bDiv, _brDiv, _bhDiv, _brhDiv)

f_calc_sigs_1() =>
    var Zigzag zz = Zigzag.new(divZigzagLen, 300, 0)
    var ZigzagProperties zzProps = ZigzagProperties.new(1, divRepaint)
    var divSigObjects = array.new<DivergenceSignalObject>()
    f_calc_sigs_impl(zz, zzProps, divSigObjects)

