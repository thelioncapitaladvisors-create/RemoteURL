// 7-Day Matrix Arrays (Column 0 = Today, Column 1 = 1d, ... Column 6 = 6d)
var bullMissile = matrix.new<string>(7, 0, "")
var bearMissile = matrix.new<string>(7, 0, "")
var bullScalp   = matrix.new<string>(7, 0, "")
var bearScalp   = matrix.new<string>(7, 0, "")
var bullLight   = matrix.new<string>(7, 0, "")
var bearLight   = matrix.new<string>(7, 0, "")
var bullWick    = matrix.new<string>(7, 0, "")
var bearWick    = matrix.new<string>(7, 0, "")
var bullExt     = matrix.new<string>(7, 0, "")
var bearExt     = matrix.new<string>(7, 0, "")
var bullOut     = matrix.new<string>(7, 0, "")
var bearOut     = matrix.new<string>(7, 0, "")
var bullDoji    = matrix.new<string>(7, 0, "")
var bearDoji    = matrix.new<string>(7, 0, "")
var bullDiv     = matrix.new<string>(7, 0, "")
var bearDiv     = matrix.new<string>(7, 0, "")
var bullHDiv    = matrix.new<string>(7, 0, "")
var bearHDiv    = matrix.new<string>(7, 0, "")

f_get_pos(posStr) =>
    switch posStr
        "Bottom Right"  => position.bottom_right
        "Bottom Center" => position.bottom_center
        "Bottom Left"   => position.bottom_left
        "Top Right"     => position.top_right
        "Top Center"    => position.top_center
        "Top Left"      => position.top_left
        "Middle Left"   => position.middle_left
        => position.middle_right

tablePos = f_get_pos(tablePosStr)

f_simplifySym(sym) =>
    parts = str.split(sym, ":")
    base  = array.size(parts) > 1 ? array.get(parts, array.size(parts) - 1) : array.get(parts, 0)
    base := str.replace(base, "1!", "")
    base

f_clean_ticker(sym) => f_simplifySym(sym)

f_mat_push(m, dayIdx, val) =>
    currentVal = matrix.get(m, dayIdx, 0)
    newVal = currentVal == "" ? val : currentVal + "\n" + val
    matrix.set(m, dayIdx, 0, newVal)

f_add_day(sym, dayIdx, sigPack) =>
    cleanSym = f_simplifySym(sym)
    if unpackBit(sigPack, 1)
        f_mat_push(bullMissile, dayIdx, cleanSym)
    if unpackBit(sigPack, 2)
        f_mat_push(bearMissile, dayIdx, cleanSym)
    if unpackBit(sigPack, 4)
        f_mat_push(bullScalp, dayIdx, cleanSym)
    if unpackBit(sigPack, 8)
        f_mat_push(bearScalp, dayIdx, cleanSym)
    if unpackBit(sigPack, 16)
        f_mat_push(bullLight, dayIdx, cleanSym)
    if unpackBit(sigPack, 32)
        f_mat_push(bearLight, dayIdx, cleanSym)
    if unpackBit(sigPack, 64)
        f_mat_push(bullWick, dayIdx, cleanSym)
    if unpackBit(sigPack, 128)
        f_mat_push(bearWick, dayIdx, cleanSym)
    if unpackBit(sigPack, 256)
        f_mat_push(bullExt, dayIdx, cleanSym)
    if unpackBit(sigPack, 512)
        f_mat_push(bearExt, dayIdx, cleanSym)
    if unpackBit(sigPack, 1024)
        f_mat_push(bullOut, dayIdx, cleanSym)
    if unpackBit(sigPack, 2048)
        f_mat_push(bearOut, dayIdx, cleanSym)
    if unpackBit(sigPack, 4096)
        f_mat_push(bullDoji, dayIdx, cleanSym)
    if unpackBit(sigPack, 8192)
        f_mat_push(bearDoji, dayIdx, cleanSym)
    if unpackBit(sigPack, 16384)
        f_mat_push(bullDiv, dayIdx, cleanSym)
    if unpackBit(sigPack, 32768)
        f_mat_push(bearDiv, dayIdx, cleanSym)
    if unpackBit(sigPack, 65536)
        f_mat_push(bullHDiv, dayIdx, cleanSym)
    if unpackBit(sigPack, 131072)
        f_mat_push(bearHDiv, dayIdx, cleanSym)

f_add_sym_all(sym, s0, s1, s2, s3, s4, s5, s6) =>
    if sym != ""
        for i = 0 to lookback_days - 1
            sigPack = i == 0 ? s0 : i == 1 ? s1 : i == 2 ? s2 : i == 3 ? s3 : i == 4 ? s4 : i == 5 ? s5 : s6
            f_add_day(sym, i, sigPack)


// Helper function to build structured Daily TF trade JSON for Day 0 signals
f_build_trade_json(sym, sigPack, o, h, l, c, atr) =>
    clean = f_simplifySym(sym)
    if sigPack > 0 and not na(c) and not na(atr) and atr > 0
        string sigType = ""
        string strat   = ""
        float  entryP  = na
        float  slP     = na
        float  tp1P    = na
        float  tp2P    = na
        float  tp3P    = na
        float  tp4P    = na

        // Divergence signals: Midpoint limit touch entry, confirmation extreme SL
        if unpackBit(sigPack, 16384)
            sigType := "LONG REGULAR DIVERGENCE"
            strat   := "DIV"
            entryP  := (h + l) / 2.0
            slP     := l - 0.5 * atr
            tp1P    := entryP + 1.5 * atr
            tp2P    := entryP + 2.5 * atr
            tp3P    := entryP + 3.5 * atr
            tp4P    := entryP + 4.5 * atr
        else if unpackBit(sigPack, 32768)
            sigType := "SHORT REGULAR DIVERGENCE"
            strat   := "DIV"
            entryP  := (h + l) / 2.0
            slP     := h + 0.5 * atr
            tp1P    := entryP - 1.5 * atr
            tp2P    := entryP - 2.5 * atr
            tp3P    := entryP - 3.5 * atr
            tp4P    := entryP - 4.5 * atr
        else if unpackBit(sigPack, 65536)
            sigType := "LONG HIDDEN DIVERGENCE"
            strat   := "DIV"
            entryP  := (h + l) / 2.0
            slP     := l - 0.5 * atr
            tp1P    := entryP + 1.5 * atr
            tp2P    := entryP + 2.5 * atr
            tp3P    := entryP + 3.5 * atr
            tp4P    := entryP + 4.5 * atr
        else if unpackBit(sigPack, 131072)
            sigType := "SHORT HIDDEN DIVERGENCE"
            strat   := "DIV"
            entryP  := (h + l) / 2.0
            slP     := h + 0.5 * atr
            tp1P    := entryP - 1.5 * atr
            tp2P    := entryP - 2.5 * atr
            tp3P    := entryP - 3.5 * atr
            tp4P    := entryP - 4.5 * atr
        else if unpackBit(sigPack, 16)
            sigType := "LONG LIGHTNING"
            strat   := "LIGHTNING"
            entryP  := c
            slP     := l - 0.50 * atr
            tp1P    := entryP + 1.5 * atr
            tp2P    := entryP + 2.5 * atr
            tp3P    := entryP + 3.5 * atr
            tp4P    := entryP + 4.5 * atr
        else if unpackBit(sigPack, 32)
            sigType := "SHORT LIGHTNING"
            strat   := "LIGHTNING"
            entryP  := c
            slP     := h + 0.50 * atr
            tp1P    := entryP - 1.5 * atr
            tp2P    := entryP - 2.5 * atr
            tp3P    := entryP - 3.5 * atr
            tp4P    := entryP - 4.5 * atr
        else if unpackBit(sigPack, 256)
            sigType := "LONG EXTREME REVERSAL"
            strat   := "EXT_REV"
            entryP  := c
            slP     := l - 0.50 * atr
            tp1P    := entryP + 1.5 * atr
            tp2P    := entryP + 2.5 * atr
            tp3P    := entryP + 3.5 * atr
            tp4P    := entryP + 4.5 * atr
        else if unpackBit(sigPack, 512)
            sigType := "SHORT EXTREME REVERSAL"
            strat   := "EXT_REV"
            entryP  := c
            slP     := h + 0.50 * atr
            tp1P    := entryP - 1.5 * atr
            tp2P    := entryP - 2.5 * atr
            tp3P    := entryP - 3.5 * atr
            tp4P    := entryP - 4.5 * atr
        else if unpackBit(sigPack, 1024)
            sigType := "LONG OUTSIDE REVERSAL"
            strat   := "OUTSIDE_REV"
            entryP  := c
            slP     := l - 0.50 * atr
            tp1P    := entryP + 1.5 * atr
            tp2P    := entryP + 2.5 * atr
            tp3P    := entryP + 3.5 * atr
            tp4P    := entryP + 4.5 * atr
        else if unpackBit(sigPack, 2048)
            sigType := "SHORT OUTSIDE REVERSAL"
            strat   := "OUTSIDE_REV"
            entryP  := c
            slP     := h + 0.50 * atr
            tp1P    := entryP - 1.5 * atr
            tp2P    := entryP - 2.5 * atr
            tp3P    := entryP - 3.5 * atr
            tp4P    := entryP - 4.5 * atr
        else if unpackBit(sigPack, 1)
            sigType := "LONG MISSILE"
            strat   := "MISSILE"
            entryP  := c
            slP     := l - 0.50 * atr
            tp1P    := entryP + 1.5 * atr
            tp2P    := entryP + 2.5 * atr
            tp3P    := entryP + 3.5 * atr
            tp4P    := entryP + 4.5 * atr
        else if unpackBit(sigPack, 2)
            sigType := "SHORT MISSILE"
            strat   := "MISSILE"
            entryP  := c
            slP     := h + 0.50 * atr
            tp1P    := entryP - 1.5 * atr
            tp2P    := entryP - 2.5 * atr
            tp3P    := entryP - 3.5 * atr
            tp4P    := entryP - 4.5 * atr
        else if unpackBit(sigPack, 4)
            sigType := "LONG SCALP"
            strat   := "SCALP"
            entryP  := c
            slP     := l - 0.50 * atr
            tp1P    := entryP + 1.5 * atr
            tp2P    := entryP + 2.5 * atr
            tp3P    := entryP + 3.5 * atr
            tp4P    := entryP + 4.5 * atr
        else if unpackBit(sigPack, 8)
            sigType := "SHORT SCALP"
            strat   := "SCALP"
            entryP  := c
            slP     := h + 0.50 * atr
            tp1P    := entryP - 1.5 * atr
            tp2P    := entryP - 2.5 * atr
            tp3P    := entryP - 3.5 * atr
            tp4P    := entryP - 4.5 * atr

        if sigType != ""
            '{"symbol":"' + sym + '","cleanSym":"' + clean + '","type":"' + sigType + '","strategy":"' + strat + '","status":"ACTIVE LIMIT","entry":' + str.tostring(entryP, "#.##") + ',"stop":' + str.tostring(slP, "#.##") + ',"target":' + str.tostring(tp1P, "#.##") + ',"tp2":' + str.tostring(tp2P, "#.##") + ',"tp3":' + str.tostring(tp3P, "#.##") + ',"tp4":' + str.tostring(tp4P, "#.##") + ',"timeframe":"1D"}'
        else
            ""
    else
        ""

// ---- THEME COLOR DEFINITIONS -------------------------------------------
isOriginal = tableTheme == "Original TLCS"
isDark     = tableTheme == "Dark Theme"

c_frame     = isOriginal ? color.rgb(12, 246, 250) : isDark ? color.rgb(51, 65, 85) : color.rgb(203, 213, 225)
c_border    = isOriginal ? color.rgb(12, 246, 250) : isDark ? color.rgb(51, 65, 85) : color.rgb(226, 232, 240)

c_header_bg = isOriginal ? color.new(#116ac2, 0) : isDark ? color.rgb(15, 23, 42) : color.rgb(30, 58, 138)
c_header_fg = isOriginal ? color.rgb(12, 246, 250) : isDark ? color.rgb(56, 189, 248) : color.white

c_colhdr_bg = isOriginal ? color.rgb(17, 106, 194) : isDark ? color.rgb(30, 41, 59) : color.rgb(241, 245, 249)
c_colhdr_fg = isOriginal ? color.white : isDark ? color.white : color.rgb(15, 23, 42)

c_label_bg  = isOriginal ? color.rgb(249, 226, 23, 87) : isDark ? color.rgb(30, 41, 59) : color.rgb(248, 250, 252)
c_label_fg  = isOriginal ? color.rgb(10, 65, 230) : isDark ? color.rgb(226, 232, 240) : color.rgb(15, 23, 42)

c_bull_bg   = c_label_bg
c_bull_fg   = isOriginal ? color.rgb(0, 130, 0) : isDark ? color.rgb(74, 222, 128) : color.rgb(22, 101, 52)

c_bear_bg   = c_label_bg
c_bear_fg   = isOriginal ? color.rgb(204, 0, 0) : isDark ? color.rgb(248, 113, 113) : color.rgb(153, 27, 27)

c_mixed_fg  = isOriginal ? color.rgb(190, 85, 0) : isDark ? color.rgb(251, 191, 36) : color.rgb(180, 83, 9)

c_empty_bg  = c_label_bg
c_empty_fg  = isOriginal ? color.rgb(120, 120, 120) : isDark ? color.rgb(100, 116, 139) : color.rgb(148, 163, 184)

f_render_matrix_row(t, r, labelText, bullMat, bearMat, tSize) =>
    hasAny = false
    for d = 0 to lookback_days - 1
        if matrix.get(bullMat, d, 0) != "" or matrix.get(bearMat, d, 0) != ""
            hasAny := true

    if hasAny
        table.cell(t, 0, r, labelText, bgcolor=c_label_bg, text_color=c_label_fg, text_size=tSize, text_halign=text.align_right)
        for colIdx = 1 to lookback_days
            d = lookback_days - colIdx
            bTxt = matrix.get(bullMat, d, 0)
            brTxt = matrix.get(bearMat, d, 0)
            
            bFormatted = bTxt != "" ? "▲ " + str.replace_all(bTxt, "\n", "\n▲ ") : ""
            brFormatted = brTxt != "" ? "▼ " + str.replace_all(brTxt, "\n", "\n▼ ") : ""
            cellTxt = (bFormatted != "" and brFormatted != "") ? bFormatted + "\n" + brFormatted : bFormatted != "" ? bFormatted : brFormatted != "" ? brFormatted : "-"

            cellBg = c_label_bg
            cellFg = (bTxt != "" and brTxt != "") ? c_mixed_fg : bTxt != "" ? c_bull_fg : brTxt != "" ? c_bear_fg : c_empty_fg

            table.cell(t, colIdx, r, cellTxt, bgcolor=cellBg, text_color=cellFg, text_size=tSize, text_halign=text.align_center)
        true
    else
        false

var table dash1 = na
if barstate.islast
    bullMissile := matrix.new<string>(7, 1, "")
    bearMissile := matrix.new<string>(7, 1, "")
    bullScalp   := matrix.new<string>(7, 1, "")
    bearScalp   := matrix.new<string>(7, 1, "")
    bullLight   := matrix.new<string>(7, 1, "")
    bearLight   := matrix.new<string>(7, 1, "")
    bullWick    := matrix.new<string>(7, 1, "")
    bearWick    := matrix.new<string>(7, 1, "")
    bullExt     := matrix.new<string>(7, 1, "")
    bearExt     := matrix.new<string>(7, 1, "")
    bullOut     := matrix.new<string>(7, 1, "")
    bearOut     := matrix.new<string>(7, 1, "")
    bullDoji    := matrix.new<string>(7, 1, "")
    bearDoji    := matrix.new<string>(7, 1, "")
    bullDiv     := matrix.new<string>(7, 1, "")
    bearDiv     := matrix.new<string>(7, 1, "")
    bullHDiv    := matrix.new<string>(7, 1, "")
    bearHDiv    := matrix.new<string>(7, 1, "")

    f_add_sym_all(u1, u1_s0, u1_s1, u1_s2, u1_s3, u1_s4, u1_s5, u1_s6)
    f_add_sym_all(u2, u2_s0, u2_s1, u2_s2, u2_s3, u2_s4, u2_s5, u2_s6)
    f_add_sym_all(u3, u3_s0, u3_s1, u3_s2, u3_s3, u3_s4, u3_s5, u3_s6)
    f_add_sym_all(u4, u4_s0, u4_s1, u4_s2, u4_s3, u4_s4, u4_s5, u4_s6)
    f_add_sym_all(u5, u5_s0, u5_s1, u5_s2, u5_s3, u5_s4, u5_s5, u5_s6)
    f_add_sym_all(u6, u6_s0, u6_s1, u6_s2, u6_s3, u6_s4, u6_s5, u6_s6)
    f_add_sym_all(u7, u7_s0, u7_s1, u7_s2, u7_s3, u7_s4, u7_s5, u7_s6)
    f_add_sym_all(u8, u8_s0, u8_s1, u8_s2, u8_s3, u8_s4, u8_s5, u8_s6)
    f_add_sym_all(u9, u9_s0, u9_s1, u9_s2, u9_s3, u9_s4, u9_s5, u9_s6)

    txtSize = tableTextSz == "Tiny" ? size.tiny : tableTextSz == "Normal" ? size.normal : size.small

    dash1 := table.new(tablePos, lookback_days + 1, 15, border_width=1, frame_width=1, frame_color=c_frame, border_color=c_border)
    
    int currentRow = 0

    // Header: TLCS SIGNALS (Daily)
    table.merge_cells(dash1, 0, currentRow, lookback_days, currentRow)
    table.cell(dash1, 0, currentRow, "TLCS SIGNALS (" + sigTf + ")", bgcolor=c_header_bg, text_color=c_header_fg, text_size=txtSize, text_halign=text.align_center)
    currentRow += 1

    table.cell(dash1, 0, currentRow, "FILTER TYPE", bgcolor=c_colhdr_bg, text_color=c_colhdr_fg, text_size=txtSize, text_halign=text.align_right)
    for colIdx = 1 to lookback_days
        dayOffset = lookback_days - colIdx
        colName = dayOffset == 0 ? "1" : str.tostring(dayOffset + 1)
        table.cell(dash1, colIdx, currentRow, colName, bgcolor=c_colhdr_bg, text_color=c_colhdr_fg, text_size=txtSize, text_halign=text.align_center)
    currentRow += 1

    if f_render_matrix_row(dash1, currentRow, "Missile", bullMissile, bearMissile, txtSize)
        currentRow += 1
    if f_render_matrix_row(dash1, currentRow, "Scalp", bullScalp, bearScalp, txtSize)
        currentRow += 1
    if f_render_matrix_row(dash1, currentRow, "Lightning", bullLight, bearLight, txtSize)
        currentRow += 1
    if f_render_matrix_row(dash1, currentRow, "Wick Reversal", bullWick, bearWick, txtSize)
        currentRow += 1
    if f_render_matrix_row(dash1, currentRow, "Extreme Reversal", bullExt, bearExt, txtSize)
        currentRow += 1
    if f_render_matrix_row(dash1, currentRow, "Outside Reversal", bullOut, bearOut, txtSize)
        currentRow += 1
    if f_render_matrix_row(dash1, currentRow, "Doji Reversal", bullDoji, bearDoji, txtSize)
        currentRow += 1
    if f_render_matrix_row(dash1, currentRow, "Price Divergences", bullDiv, bearDiv, txtSize)
        currentRow += 1
    if f_render_matrix_row(dash1, currentRow, "Hidden Divergences", bullHDiv, bearHDiv, txtSize)
        currentRow += 1

    // Universal 7-Day Session Matrix Alert Engine (Strict Daily Candle Close)
    bool isDailyClose = false
    if timeframe.isdaily
        isDailyClose := barstate.isconfirmed
    else if timeframe.isintraday
        isDailyClose := (session.islastbar_regular and barstate.isconfirmed) or (ta.change(time("D")) != 0 and barstate.isconfirmed)
    else
        isDailyClose := barstate.isconfirmed

    if (isDailyClose or barstate.islast) and enable_alerts
        string daysJson = "["
        for col = 0 to 6
            bM = str.replace_all(matrix.get(bullMissile, col, 0), "\n", ",")
            sM = str.replace_all(matrix.get(bearMissile, col, 0), "\n", ",")
            bSc = str.replace_all(matrix.get(bullScalp, col, 0), "\n", ",")
            sSc = str.replace_all(matrix.get(bearScalp, col, 0), "\n", ",")
            bL = str.replace_all(matrix.get(bullLight, col, 0), "\n", ",")
            sL = str.replace_all(matrix.get(bearLight, col, 0), "\n", ",")
            bW = str.replace_all(matrix.get(bullWick, col, 0), "\n", ",")
            sW = str.replace_all(matrix.get(bearWick, col, 0), "\n", ",")
            bE = str.replace_all(matrix.get(bullExt, col, 0), "\n", ",")
            sE = str.replace_all(matrix.get(bearExt, col, 0), "\n", ",")
            bO = str.replace_all(matrix.get(bullOut, col, 0), "\n", ",")
            sO = str.replace_all(matrix.get(bearOut, col, 0), "\n", ",")
            bDj = str.replace_all(matrix.get(bullDoji, col, 0), "\n", ",")
            sDj = str.replace_all(matrix.get(bearDoji, col, 0), "\n", ",")
            bD = str.replace_all(matrix.get(bullDiv, col, 0), "\n", ",")
            sD = str.replace_all(matrix.get(bearDiv, col, 0), "\n", ",")
            bHD = str.replace_all(matrix.get(bullHDiv, col, 0), "\n", ",")
            sHD = str.replace_all(matrix.get(bearHDiv, col, 0), "\n", ",")

            daysJson += '{"col":' + str.tostring(col) + ',"bM":"' + bM + '","sM":"' + sM + '","bSc":"' + bSc + '","sSc":"' + sSc + '","bL":"' + bL + '","sL":"' + sL + '","bW":"' + bW + '","sW":"' + sW + '","bE":"' + bE + '","sE":"' + sE + '","bO":"' + bO + '","sO":"' + sO + '","bDj":"' + bDj + '","sDj":"' + sDj + '","bD":"' + bD + '","sD":"' + sD + '","bHD":"' + bHD + '","sHD":"' + sHD + '"}' + (col < 6 ? ',' : '')
        daysJson += "]"

        string t1Json = f_build_trade_json(u1, u1_s0, u1_o, u1_h, u1_l, u1_c, u1_a)
        string t2Json = f_build_trade_json(u2, u2_s0, u2_o, u2_h, u2_l, u2_c, u2_a)
        string t3Json = f_build_trade_json(u3, u3_s0, u3_o, u3_h, u3_l, u3_c, u3_a)
        string t4Json = f_build_trade_json(u4, u4_s0, u4_o, u4_h, u4_l, u4_c, u4_a)
        string t5Json = f_build_trade_json(u5, u5_s0, u5_o, u5_h, u5_l, u5_c, u5_a)
        string t6Json = f_build_trade_json(u6, u6_s0, u6_o, u6_h, u6_l, u6_c, u6_a)
        string t7Json = f_build_trade_json(u7, u7_s0, u7_o, u7_h, u7_l, u7_c, u7_a)
        string t8Json = f_build_trade_json(u8, u8_s0, u8_o, u8_h, u8_l, u8_c, u8_a)
        string t9Json = f_build_trade_json(u9, u9_s0, u9_o, u9_h, u9_l, u9_c, u9_a)

        string tradesJson = "["
        string activeSep = ""
        if t1Json != ""
            tradesJson += activeSep + t1Json
            activeSep := ","
        if t2Json != ""
            tradesJson += activeSep + t2Json
            activeSep := ","
        if t3Json != ""
            tradesJson += activeSep + t3Json
            activeSep := ","
        if t4Json != ""
            tradesJson += activeSep + t4Json
            activeSep := ","
        if t5Json != ""
            tradesJson += activeSep + t5Json
            activeSep := ","
        if t6Json != ""
            tradesJson += activeSep + t6Json
            activeSep := ","
        if t7Json != ""
            tradesJson += activeSep + t7Json
            activeSep := ","
        if t8Json != ""
            tradesJson += activeSep + t8Json
            activeSep := ","
        if t9Json != ""
            tradesJson += activeSep + t9Json
            activeSep := ","
        tradesJson += "]"

        string alertPayload = '{"ticker":"' + syminfo.ticker + '","trigger":"DailySignalsMatrix","secret":"' + webhook_secret + '","timeframe":"' + sigTf + '","matrix_days":' + daysJson + ',"signals":{"bullMissile":"' + matrix.get(bullMissile, 0, 0) + '","bearMissile":"' + matrix.get(bearMissile, 0, 0) + '","bullScalp":"' + matrix.get(bullScalp, 0, 0) + '","bearScalp":"' + matrix.get(bearScalp, 0, 0) + '","bullLight":"' + matrix.get(bullLight, 0, 0) + '","bearLight":"' + matrix.get(bearLight, 0, 0) + '","bullDiv":"' + matrix.get(bullDiv, 0, 0) + '","bearDiv":"' + matrix.get(bearDiv, 0, 0) + '","bullHDiv":"' + matrix.get(bullHDiv, 0, 0) + '","bearHDiv":"' + matrix.get(bearHDiv, 0, 0) + '"},"trades":' + tradesJson + ',"timestamp":"' + str.tostring(time) + '"}'

        alert(alertPayload, alert.freq_once_per_bar_close)
