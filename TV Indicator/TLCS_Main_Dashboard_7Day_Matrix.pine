//@version=6
indicator("TLCS MAIN DASHBOARD", overlay=true, max_labels_count=500)
// © TheLionCapitalsolutions.com and market-store.online

// ---- MEMORY OPTIMIZATION: BITMASK PACKING (PINE SAFE) -----------------------
packSignals18(b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14, b15, b16, b17, b18) =>
    r = (b1 ? 1 : 0) + (b2 ? 2 : 0) + (b3 ? 4 : 0) + (b4 ? 8 : 0)
    r += (b5 ? 16 : 0) + (b6 ? 32 : 0) + (b7 ? 64 : 0) + (b8 ? 128 : 0)
    r += (b9 ? 256 : 0) + (b10 ? 512 : 0) + (b11 ? 1024 : 0) + (b12 ? 2048 : 0)
    r += (b13 ? 4096 : 0) + (b14 ? 8192 : 0) + (b15 ? 16384 : 0) + (b16 ? 32768 : 0)
    r += (b17 ? 65536 : 0) + (b18 ? 131072 : 0)
    r

packSignals20(b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14, b15, b16, b17, b18, b19, b20) =>
    r = (b1 ? 1 : 0) + (b2 ? 2 : 0) + (b3 ? 4 : 0) + (b4 ? 8 : 0)
    r += (b5 ? 16 : 0) + (b6 ? 32 : 0) + (b7 ? 64 : 0) + (b8 ? 128 : 0)
    r += (b9 ? 256 : 0) + (b10 ? 512 : 0) + (b11 ? 1024 : 0) + (b12 ? 2048 : 0)
    r += (b13 ? 4096 : 0) + (b14 ? 8192 : 0) + (b15 ? 16384 : 0) + (b16 ? 32768 : 0)
    r += (b17 ? 65536 : 0) + (b18 ? 131072 : 0) + (b19 ? 262144 : 0) + (b20 ? 524288 : 0)
    r

// Extended to 28 bits: adds the 8 persistent "sequence active" states (bits
// 21-28) needed for the 4 Trade Sequence rows, on top of the original 20
// single-day Blueprint bits.
packSignals28(b1, b2, b3, b4, b5, b6, b7, b8, b9, b10, b11, b12, b13, b14, b15, b16, b17, b18, b19, b20, b21, b22, b23, b24, b25, b26, b27, b28) =>
    r = (b1 ? 1 : 0) + (b2 ? 2 : 0) + (b3 ? 4 : 0) + (b4 ? 8 : 0)
    r += (b5 ? 16 : 0) + (b6 ? 32 : 0) + (b7 ? 64 : 0) + (b8 ? 128 : 0)
    r += (b9 ? 256 : 0) + (b10 ? 512 : 0) + (b11 ? 1024 : 0) + (b12 ? 2048 : 0)
    r += (b13 ? 4096 : 0) + (b14 ? 8192 : 0) + (b15 ? 16384 : 0) + (b16 ? 32768 : 0)
    r += (b17 ? 65536 : 0) + (b18 ? 131072 : 0) + (b19 ? 262144 : 0) + (b20 ? 524288 : 0)
    r += (b21 ? 1048576 : 0) + (b22 ? 2097152 : 0) + (b23 ? 4194304 : 0) + (b24 ? 8388608 : 0)
    r += (b25 ? 16777216 : 0) + (b26 ? 33554432 : 0) + (b27 ? 67108864 : 0) + (b28 ? 134217728 : 0)
    r

// Pine-compatible bit extraction using modulo arithmetic
unpackBit(pack, bit) => (math.floor(pack / bit) % 2) != 0

// ---- INPUTS --------------------------------------------------------
webhook_secret = input.string('675d6a25933d3fc1b78b45ba2d6b400c0d1598e6780e9b8ae4ea1b1f824d89eb', 'Webhook Secret')
enable_alerts = input.bool(true, 'Enable Automated Webhook Alerts')
// ---- SUPPORT & RESISTANCE INPUTS -------------------------------------------
srMaxBreaks  = input.int(3, 'S&R Max Breaks', minval = 2, group = 'Support & Resistance')
srMaxDistPct = input.float(2.0, 'S&R Max Distance %', minval = 0.1, group = 'Support & Resistance')
srLookback   = input.int(100, 'Reversal-Candle Lookback (bars)', minval = 20, group = 'Support & Resistance')

// ---- REVERSAL SYSTEM INPUTS (AUTHENTIC MASTER RULES) -----------------------
pivotlbar       = input.int(10, 'Length to Highest/Lowest (Reversals)', group='Reversal Systems')
wick_multiplier = input.float(3.25, 'Wick Multiplier', step=0.5, maxval=20, group='Reversal Systems')
body_percentage = input.float(0.35, 'Body Percentage', step=0.1, maxval=1, group='Reversal Systems')
WBarMultiplier  = input.float(1.1, 'Body & Candle Range Multiplier', step=0.1, maxval=5, group='Reversal Systems')
Wbarsback       = input.int(50, 'Average Candle and Body Lookback', group='Reversal Systems')
ext_bodysize    = input.float(0.75, 'Extreme Reversal Body Size Ratio', step=0.05, maxval=1, group='Reversal Systems')
ext_bodymult    = input.float(2.0, 'Extreme Reversal Candle Multiplier', step=0.25, maxval=5, group='Reversal Systems')
out_barmult     = input.float(1.25, 'Outside Reversal Multiplier', step=0.05, maxval=3.5, group='Reversal Systems')
doji_barmult    = input.float(0.65, 'Doji Reversal Multiplier', step=0.05, maxval=3.5, group='Reversal Systems')
doji_pct        = input.float(0.10, 'Doji Body Percentage', step=0.05, minval=0.05, group='Reversal Systems')

f_calc_sigs() =>
    fPivot = (high + low + close) / 3
    fFastEMA1 = 5
    fSlowEMA1 = 13
    fPivotEMAF1 = ta.ema(fPivot, fFastEMA1)
    fPivotEMAF2 = ta.ema(fPivotEMAF1, fFastEMA1)
    fPivotEMAS1 = ta.ema(fPivot, fSlowEMA1)
    fPivotEMAS2 = ta.ema(fPivotEMAS1, fSlowEMA1)
    PDEMAF = fPivotEMAF1 * 2 - fPivotEMAF2
    PDEMAS = fPivotEMAS1 * 2 - fPivotEMAS2
    fPivotPDEMAF = ta.ema(PDEMAF, fFastEMA1)
    fPivotPDEMAS = ta.ema(PDEMAS, fSlowEMA1)
    fShortEMA = ta.ema(fPivot, 13)
    fMedEMA = ta.ema(fPivot, 32)
    upper = ta.highest(92)
    lower = ta.lowest(92)
    out = 100 * (close - upper) / (upper - lower)
    m0 = ta.ema(out, 21)
    m10 = ta.sma(out, 96)
    len14 = 14
    up14 = ta.change(high)
    down14 = -ta.change(low)
    plusDM = na(up14) ? na : (up14 > down14 and up14 > 0 ? up14 : 0)
    minusDM = na(down14) ? na : (down14 > up14 and down14 > 0 ? down14 : 0)
    trur = ta.rma(ta.tr, len14)
    plus = fixnan(100 * ta.rma(plusDM, len14) / trur)
    minus = fixnan(100 * ta.rma(minusDM, len14) / trur)

    GREEN = (plus > minus) and (m0 > m10)
    RED   = (minus > plus) and (m0 < m10)
    GREENZONE = GREEN
    REDZONE   = RED

    // Missile S&R Bounce Detection
    bullpower = open[1] > close[1] ? close > open ? close >= open[1] ? close[1] >= open ? close - open > open[1] - close[1] ? 1 : na : na : na : na : na
    bearpower = close[1] > open[1] ? open > close ? open >= close[1] ? open[1] >= close ? open - close > close[1] - open[1] ? 1 : na : na : na : na : na
    intraMid = (high + low) / 2

    bool bouncedUpAnyLevel   = false
    bool bouncedDownAnyLevel = false
    
    for i = 1 to srLookback
        if not na(bearpower[i])
            rv = intraMid[i]
            if math.abs(rv - close) / close * 100 < srMaxDistPct
                int breaks = 0
                for j = i - 1 to 0
                    if (open[j] < rv and close[j] > rv) or (open[j] > rv and close[j] < rv)
                        breaks += 1
                if breaks < srMaxBreaks
                    if high >= rv and open <= rv and low < rv and close < rv and close < open
                        bouncedDownAnyLevel := true
        
        if not na(bullpower[i])
            sv = intraMid[i]
            if math.abs(sv - close) / close * 100 < srMaxDistPct
                int breaks = 0
                for j = i - 1 to 0
                    if (open[j] < sv and close[j] > sv) or (open[j] > sv and close[j] < sv)
                        breaks += 1
                if breaks < srMaxBreaks
                    if low <= sv and open >= sv and high > sv and close > sv and close > open
                        bouncedUpAnyLevel := true

    bool GrS = GREEN and bouncedUpAnyLevel
    bool ReS = RED and bouncedDownAnyLevel

    _mb = GrS
    _ms = ReS
    _sb = false
    _ss = false
    _lb = false
    _ls = false

    // Pivot High / Low for Reversals (Strict 10-bar pivot)
    highleftempty = ta.pivothigh(pivotlbar, 0)
    lowleftempty  = ta.pivotlow(pivotlbar, 0)

    // 1. Wick Reversal System
    Wmybodysize    = math.abs(close - open)
    WAverageBody   = ta.sma(Wmybodysize, Wbarsback)
    Wmycandlesize  = high - low
    WAverageCandle = ta.sma(Wmycandlesize, Wbarsback)

    Wlong = close > open and open - low >= (close - open) * wick_multiplier and high - close <= (high - low) * body_percentage or 
       close < open and close - low >= (open - close) * wick_multiplier and high - close <= (high - low) * body_percentage or 
       close == open and close != high and high - low >= (high - close) * wick_multiplier and high - close <= (high - low) * body_percentage or 
       open == high and close == high and high - low >= ta.sma(high - low, 50)

    Wshort = close < open and high - open >= (open - close) * wick_multiplier and close - low <= (high - low) * body_percentage or 
       close > open and high - close >= (close - open) * wick_multiplier and close - low <= (high - low) * body_percentage or 
       close == open and close != low and high - low >= (close - low) * wick_multiplier and close - low <= (high - low) * body_percentage or 
       open == low and close == low and high - low >= ta.sma(high - low, 50)

    _wls = GREENZONE and not na(lowleftempty) and Wlong and (high - low >= WAverageCandle * WBarMultiplier)
    _wss = REDZONE and not na(highleftempty) and Wshort and (high - low >= WAverageCandle * WBarMultiplier)

    // 2. Extreme Reversal System
    AverageCandle = ta.sma(high - low, 50)
    AverageBody   = ta.sma(math.abs(open - close), 50)

    _els = GREENZONE and (open[1] - close[1] >= ext_bodysize * (high[1] - low[1])) and (high[1] - low[1] > AverageCandle * ext_bodymult) and (open[1] - close[1] > AverageBody) and (close > open)
    _ess = REDZONE and (close[1] - open[1] >= ext_bodysize * (high[1] - low[1])) and (high[1] - low[1] > AverageCandle * ext_bodymult) and (close[1] - open[1] > AverageBody) and (open > close)

    // 3. Outside Reversal System
    AverageCandle1 = ta.sma(high - low, 50)
    _ols = GREENZONE and (low < low[1]) and (close > high[1]) and (high - low >= AverageCandle1 * out_barmult)
    _oss = REDZONE and (high > high[1]) and (close < low[1]) and (high - low >= AverageCandle1 * out_barmult)

    // 4. Doji Reversal System
    frangehl = high[1] - low[1]
    frangeco = math.abs(close[1] - open[1])
    sma10 = ta.sma(close, 10)

    Dshort = (frangeco <= frangehl * doji_pct and close < low[1] and low[1] > sma10 and close < open) or 
       (close < low[2] and close[1] >= low[2] and frangeco <= frangeco * doji_pct and close < open and low[2] > sma10)

    Dlong = (frangeco <= frangehl * doji_pct and close > high[1] and high[1] < sma10 and close > open) or 
       (close > high[2] and close[1] <= high[2] and frangeco <= frangeco * doji_pct and close > open and high[2] < sma10)

    _dls = GREENZONE and not na(lowleftempty) and Dlong and (high - low >= WAverageCandle * doji_barmult)
    _dss = REDZONE and not na(highleftempty) and Dshort and (high - low >= WAverageCandle * doji_barmult)

    // 5. Divergences
    rsi14 = ta.rsi(close, 14)
    _bDiv   = not na(ta.pivotlow(rsi14, 5, 5)[1])  and low[1]  <= ta.lowest(low, 20)[2]   and rsi14[1] >  ta.lowest(rsi14, 20)[2]
    _brDiv  = not na(ta.pivothigh(rsi14, 5, 5)[1]) and high[1] >= ta.highest(high, 20)[2] and rsi14[1] <  ta.highest(rsi14, 20)[2]
    _bhDiv  = not na(ta.pivotlow(rsi14, 5, 5)[1])  and low[1]  >  ta.lowest(low, 20)[2]   and rsi14[1] <= ta.lowest(rsi14, 20)[2]
    _brhDiv = not na(ta.pivothigh(rsi14, 5, 5)[1]) and high[1] <  ta.highest(high, 20)[2] and rsi14[1] >= ta.highest(rsi14, 20)[2]

    packSignals18(_mb, _ms, _sb, _ss, _lb, _ls, _wls, _wss, _els, _ess, _ols, _oss, _dls, _dss, _bDiv, _brDiv, _bhDiv, _brhDiv)

// ---- DAY TYPE BLUEPRINTS & SEQUENCES ENGINE --------------------------------
adrLen = input.int(10, "ATR Lookback (bars)", minval=2, group="Blueprints Settings")
accLen = input.int(20, "Accumulation Lookback", minval=5, group="Blueprints Settings")
accMaxRangeMult = input.float(3.0, "Max Range vs ATR (x)", step=0.1, group="Blueprints Settings")
adrMultMin = input.float(1.25, "Min Range vs ATR (x)", step=0.05, group="Blueprints Settings")
tailBodyMult = input.float(2.5, "Min Tail / Body Ratio", step=0.1, group="Blueprints Settings")
closeZonePct = input.float(35, "Close within top/bottom X% of range", minval=1, maxval=50, group="Blueprints Settings") / 100
useStructure = input.bool(true, "Require near prior swing extreme", group="Blueprints Settings")
structLen    = input.int(20, "Lookback for prior swing high/low", minval=2, group="Blueprints Settings")
structTolPct = input.float(1.0, "Tolerance around prior extreme (%)", step=0.1, group="Blueprints Settings") / 100
odAdrMultMin = input.float(1.05, "Min Range vs ATR (x)", step=0.05, group="Blueprints Settings")
adrMinPct = input.float(75, "Min Range vs ATR (%)", step=5, group="Blueprints Settings") / 100
fnlMaxPct = input.float(100, "Max Range vs ATR (%) (FNL/FNH upper bound)", step=5, group="Blueprints Settings") / 100
sweepLookback = input.int(1, "Sweep Lookback (bars)", minval=1, maxval=20, group="Blueprints Settings")
requireAboveYMid = input.bool(true, "Require close above yMID (FNL) / below yMID (FNH)", group="Blueprints Settings")
absAdrMaxMult = input.float(0.75, "Max Range vs ATR (x)", step=0.05, group="Blueprints Settings")
absMidTolPct = input.float(1.0, "Tolerance: Low/High near yMID (%)", step=0.1, group="Blueprints Settings") / 100
requireBodyConfirm = input.bool(true, "Require body confirmation (Close vs Open)", group="Blueprints Settings")
srdAdrMultMin = input.float(2.0, "Min Range vs ATR (x)", step=0.1, group="Blueprints Settings")
srdCloseZonePct = input.float(15, "Close within top/bottom X% of range", minval=1, maxval=50, group="Blueprints Settings") / 100
srdStructLen = input.int(5, "Lookback for prior swing high/low for MID check (bars)", minval=1, group="Blueprints Settings")
maxActiveDays = input.int(20, "Max Days a Rejection/Stop Run/Failed Absorption Sequence Stays Active", minval=1, group="Blueprints Settings")
accMaxActiveDays = input.int(60, "Max Days an Accumulation Sequence Stays Active", minval=1, group="Blueprints Settings")

f_calc() =>
    rng    = high - low
    body   = math.abs(close - open)
    upWick = high - math.max(open, close)
    dnWick = math.min(open, close) - low
    mid    = (high + low) / 2
    avgRange = ta.sma(ta.tr(true), adrLen)[1]
    closePos = rng != 0 ? (close - low) / rng : 0.5
    accHigh = ta.highest(high, accLen)
    accLow  = ta.lowest(low, accLen)
    accRange = accHigh - accLow
    isCompressing = avgRange > 0 and accRange <= accMaxRangeMult * avgRange
    bullAcc = isCompressing and close >= (accHigh + accLow) / 2
    bearDist = isCompressing and close < (accHigh + accLow) / 2

    var int   accActiveStartBar = na
    var float accActiveMid  = na
    var bool  bullAccActive = false
    var bool  bearAccActive = false
    if bullAcc
        accActiveMid     := (accHigh + accLow) / 2
        accActiveStartBar := bar_index
        bullAccActive    := true
        bearAccActive    := false
    else if bearDist
        accActiveMid     := (accHigh + accLow) / 2
        accActiveStartBar := bar_index
        bearAccActive    := true
        bullAccActive    := false

    rejRangeOK  = avgRange > 0 and rng > adrMultMin * avgRange
    bullTailOK  = body > 0 ? dnWick > tailBodyMult * body : dnWick > 0
    bearTailOK  = body > 0 ? upWick > tailBodyMult * body : upWick > 0
    bullCloseOK = closePos >= (1 - closeZonePct)
    bearCloseOK = closePos <= closeZonePct
    priorLowStruct  = ta.lowest(low, structLen)[1]
    priorHighStruct = ta.highest(high, structLen)[1]
    nearPriorLow  = low  <= priorLowStruct  * (1 + structTolPct)
    nearPriorHigh = high >= priorHighStruct * (1 - structTolPct)
    structBullOK = not useStructure or nearPriorLow
    structBearOK = not useStructure or nearPriorHigh
    bullRej = rejRangeOK and bullTailOK and bullCloseOK and structBullOK
    bearRej = rejRangeOK and bearTailOK and bearCloseOK and structBearOK
    srdRangeOK = avgRange > 0 and rng > srdAdrMultMin * avgRange
    bullSrdClosePosOK = closePos >= (1 - srdCloseZonePct)
    bullSrdCloseExt   = close > high[1]
    bullSrdMidExt     = mid >= ta.highest(high, srdStructLen)[1]
    bullSrdSignal     = srdRangeOK and bullSrdClosePosOK and bullSrdCloseExt and bullSrdMidExt
    bearSrdClosePosOK = closePos <= srdCloseZonePct
    bearSrdCloseExt   = close < low[1]
    bearSrdMidExt     = mid <= ta.lowest(low, srdStructLen)[1]
    bearSrdSignal     = srdRangeOK and bearSrdClosePosOK and bearSrdCloseExt and bearSrdMidExt

    if bullAccActive and bullSrdSignal
        accActiveMid := mid
    if bearAccActive and bearSrdSignal
        accActiveMid := mid
    if bullAccActive and close < accActiveMid
        bullAccActive := false
    if bearAccActive and close > accActiveMid
        bearAccActive := false
    if bullAccActive and not na(accActiveStartBar) and (bar_index - accActiveStartBar) > accMaxActiveDays
        bullAccActive := false
    if bearAccActive and not na(accActiveStartBar) and (bar_index - accActiveStartBar) > accMaxActiveDays
        bearAccActive := false

    var int   rejActiveStartBar = na
    var float rejActiveMid   = na
    var float rejActiveHigh  = na
    var float rejActiveLow   = na
    var bool  bullRejActive  = false
    var bool  bearRejActive  = false
    var int   bullFailedAbsStartBar = na
    var int   bearFailedAbsStartBar = na
    var bool  bullFailedAbsActive = false
    var bool  bearFailedAbsActive = false
    int barsSinceRej = ta.barssince(bullRej or bearRej)
    if bullRej
        rejActiveMid  := mid
        rejActiveHigh := high
        rejActiveLow  := low
        rejActiveStartBar := bar_index
        bullRejActive := true
        bearRejActive := false
        bullFailedAbsActive := false
        bearFailedAbsActive := false
    else if bearRej
        rejActiveMid  := mid
        rejActiveHigh := high
        rejActiveLow  := low
        rejActiveStartBar := bar_index
        bearRejActive := true
        bullRejActive := false
        bullFailedAbsActive := false
        bearFailedAbsActive := false
    if bullRejActive and close < rejActiveMid
        bullRejActive := false
        bearFailedAbsActive := true
        bearFailedAbsStartBar := bar_index
    if bearRejActive and close > rejActiveMid
        bearRejActive := false
        bullFailedAbsActive := true
        bullFailedAbsStartBar := bar_index
    if bearFailedAbsActive and close > rejActiveHigh
        bearFailedAbsActive := false
    if bullFailedAbsActive and close < rejActiveLow
        bullFailedAbsActive := false
    if bullRejActive and not na(rejActiveStartBar) and (bar_index - rejActiveStartBar) > maxActiveDays
        bullRejActive := false
    if bearRejActive and not na(rejActiveStartBar) and (bar_index - rejActiveStartBar) > maxActiveDays
        bearRejActive := false
    if bullFailedAbsActive and not na(bullFailedAbsStartBar) and (bar_index - bullFailedAbsStartBar) > maxActiveDays
        bullFailedAbsActive := false
    if bearFailedAbsActive and not na(bearFailedAbsStartBar) and (bar_index - bearFailedAbsStartBar) > maxActiveDays
        bearFailedAbsActive := false

    var int   srdActiveStartBar = na
    var float srdActiveMid   = na
    var float srdActiveExt   = na
    var bool  bullSrdActive  = false
    var bool  bearSrdActive  = false
    int barsSinceSrd = ta.barssince(bullSrdSignal or bearSrdSignal)
    if bullSrdSignal
        srdActiveMid  := mid
        srdActiveExt  := high
        srdActiveStartBar := bar_index
        bullSrdActive := true
        bearSrdActive := false
    else if bearSrdSignal
        srdActiveMid  := mid
        srdActiveExt  := low
        srdActiveStartBar := bar_index
        bearSrdActive := true
        bullSrdActive := false
    if bullSrdActive and close < srdActiveMid
        bullSrdActive := false
    if bearSrdActive and close > srdActiveMid
        bearSrdActive := false
    if bullSrdActive and not na(srdActiveStartBar) and (bar_index - srdActiveStartBar) > maxActiveDays
        bullSrdActive := false
    if bearSrdActive and not na(srdActiveStartBar) and (bar_index - srdActiveStartBar) > maxActiveDays
        bearSrdActive := false

    bullFade = bullSrdActive and not na(barsSinceSrd) and barsSinceSrd > 0 and high >= srdActiveExt * 0.995 and close < open
    bearFade = bearSrdActive and not na(barsSinceSrd) and barsSinceSrd > 0 and low <= srdActiveExt * 1.005 and close > open
    absRangeOK = avgRange > 0 and rng < absAdrMaxMult * avgRange
    bullAbs_Rej = bullRejActive and not na(barsSinceRej) and barsSinceRej > 0 and absRangeOK and close > rejActiveMid and (not requireBodyConfirm or close > open) and math.abs(low - rejActiveMid) <= rejActiveMid * absMidTolPct
    bearAbs_Rej = bearRejActive and not na(barsSinceRej) and barsSinceRej > 0 and absRangeOK and close < rejActiveMid and (not requireBodyConfirm or close < open) and math.abs(high - rejActiveMid) <= rejActiveMid * absMidTolPct
    bullAbs_Srd = bullSrdActive and not na(barsSinceSrd) and barsSinceSrd > 0 and absRangeOK and close > srdActiveMid and (not requireBodyConfirm or close > open) and math.abs(low - srdActiveMid) <= srdActiveMid * absMidTolPct
    bearAbs_Srd = bearSrdActive and not na(barsSinceSrd) and barsSinceSrd > 0 and absRangeOK and close < srdActiveMid and (not requireBodyConfirm or close < open) and math.abs(high - srdActiveMid) <= srdActiveMid * absMidTolPct
    odRangeOK = avgRange > 0 and rng > odAdrMultMin * avgRange
    odBull = odRangeOK and low < low[1] and close > high[1]
    odBear = odRangeOK and high > high[1] and close < low[1]
    fnlRangeOK = avgRange > 0 and rng >= adrMinPct * avgRange and rng <= fnlMaxPct * avgRange
    priorLowSweep  = ta.lowest(low, sweepLookback)[1]
    priorHighSweep = ta.highest(high, sweepLookback)[1]
    yMidFnl = (high[1] + low[1]) / 2.0
    fnlSweep  = low < priorLowSweep
    fnlClose  = close > priorLowSweep and (requireAboveYMid ? close > yMidFnl : true)
    fnlSignal = fnlRangeOK and fnlSweep and fnlClose
    fnhSweep  = high > priorHighSweep
    fnhClose  = close < priorHighSweep and (requireAboveYMid ? close < yMidFnl : true)
    fnhSignal = fnlRangeOK and fnhSweep and fnhClose
    bullFnl_Rej = bullRejActive and not na(barsSinceRej) and barsSinceRej > 0 and fnlSignal
    bearFnh_Rej = bearRejActive and not na(barsSinceRej) and barsSinceRej > 0 and fnhSignal
    bullFnl_Srd = bullSrdActive and not na(barsSinceSrd) and barsSinceSrd > 0 and fnlSignal
    bearFnh_Srd = bearSrdActive and not na(barsSinceSrd) and barsSinceSrd > 0 and fnhSignal
    int barsSinceFa = ta.barssince(bullFailedAbsActive or bearFailedAbsActive)
    bullFailedBreakout = bullFailedAbsActive and not na(barsSinceFa) and barsSinceFa > 0 and low <= low[1] and close > open
    bearFailedBreakout = bearFailedAbsActive and not na(barsSinceFa) and barsSinceFa > 0 and high >= high[1] and close < open
    bullRetestAfterSrd = bullFailedAbsActive and (bullFade or bullAbs_Srd)
    bearRetestAfterSrd = bearFailedAbsActive and (bearFade or bearAbs_Srd)
    bullFade_final = bullFade and not bullRetestAfterSrd
    bearFade_final = bearFade and not bearRetestAfterSrd
    unifiedBullAbs = bullAbs_Rej or (bullAbs_Srd and not bullRetestAfterSrd)
    unifiedBearAbs = bearAbs_Rej or (bearAbs_Srd and not bearRetestAfterSrd)
    var bool prevActiveDayBull = false
    var bool prevActiveDayBear = false
    bullCont = prevActiveDayBull and close > close[1]
    bearCont = prevActiveDayBear and close < close[1]
    prevActiveDayBull := bullRej or bullSrdSignal or unifiedBullAbs or fnlSignal or bullFailedBreakout or bullRetestAfterSrd
    prevActiveDayBear := bearRej or bearSrdSignal or unifiedBearAbs or fnhSignal or bearFailedBreakout or bearRetestAfterSrd

    // Trade Sequence Multi-Day Stage Hits (PivotBoss Swing Trade Pro 2.0)
    bullRejSeqHit = bullRej or bullAbs_Rej or bullFnl_Rej or bullRetestAfterSrd or bullCont
    bearRejSeqHit = bearRej or bearAbs_Rej or bearFnh_Rej or bearRetestAfterSrd or bearCont
    bullSrdSeqHit = bullSrdSignal or bullFade_final or bullAbs_Srd or bullFnl_Srd or bullCont
    bearSrdSeqHit = bearSrdSignal or bearFade_final or bearAbs_Srd or bearFnh_Srd or bearCont
    bullFailAbsSeqHit = bullFailedBreakout or bullRetestAfterSrd
    bearFailAbsSeqHit = bearFailedBreakout or bearRetestAfterSrd
    bullAccSeqHit = bullAccActive and (bullAcc or bullRej or bullSrdSignal or unifiedBullAbs or bullRetestAfterSrd or bullCont)
    bearAccSeqHit = bearAccActive and (bearDist or bearRej or bearSrdSignal or unifiedBearAbs or bearRetestAfterSrd or bearCont)

    [bullAcc, bearDist, bullRej, bearRej, bullSrdSignal, bearSrdSignal, odBull, odBear, bullFade_final, bearFade_final, unifiedBullAbs, unifiedBearAbs, fnlSignal, fnhSignal, bullFailedBreakout, bearFailedBreakout, bullRetestAfterSrd, bearRetestAfterSrd, bullCont, bearCont, bullRejSeqHit, bearRejSeqHit, bullSrdSeqHit, bearSrdSeqHit, bullFailAbsSeqHit, bearFailAbsSeqHit, bullAccSeqHit, bearAccSeqHit]

f_calc_packed() =>
    [acB, acS, rB, rS, sB, sS, odB, odS, fdB, fdS, aB, aS, fB, fS, fbB, fbS, rtB, rtS, cContB, cContS, rejActB, rejActS, srdActB, srdActS, faActB, faActS, accActB, accActS] = f_calc()
    packSignals28(acB, acS, rB, rS, sB, sS, odB, odS, fdB, fdS, aB, aS, fB, fS, fbB, fbS, rtB, rtS, cContB, cContS, rejActB, rejActS, srdActB, srdActS, faActB, faActS, accActB, accActS)

// ---- SYMBOL INPUT CONFIGURATION -----------------------------------------
gNymex = "Commodities (NYMEX & COMEX)"
u1 = input.symbol("NYMEX:CL1!", "Futures 1 (Crude)", group=gNymex)
u2 = input.symbol("NYMEX:NG1!", "Futures 2 (NatGas)", group=gNymex)
u3 = input.symbol("COMEX:GC1!", "Futures 3 (Gold)", group=gNymex)
u4 = input.symbol("COMEX:SI1!", "Futures 4 (Silver)", group=gNymex)

gDisplay = "Dashboard Display"
tableTheme   = input.string("Original TLCS", "Color Theme", options=["Original TLCS", "Light Theme", "Dark Theme"], group=gDisplay)
tablePosStr  = input.string("Bottom Right", "Table Position", options=["Middle Right", "Middle Left", "Top Right", "Top Center", "Top Left", "Bottom Right", "Bottom Center", "Bottom Left"], group=gDisplay)
tableTextSz  = input.string("Small", "Table Text Size", options=["Tiny", "Small", "Normal"], group=gDisplay)
showAllRows  = input.bool(true, "Always Show All Rows (Even if 0 signals)", group=gDisplay)

// Lookback Input (Look back up to 7 daily bars)
lookback_days = input.int(7, "Lookback Period (Days)", minval=1, maxval=7, group=gDisplay)

f_get_7d_sigs() =>
    s = f_calc_sigs()
    [s[0], s[1], s[2], s[3], s[4], s[5], s[6]]

f_get_7d_dt() =>
    d = f_calc_packed()
    [d[0], d[1], d[2], d[3], d[4], d[5], d[6]]

[u1_s0, u1_s1, u1_s2, u1_s3, u1_s4, u1_s5, u1_s6] = request.security(u1, "D", f_get_7d_sigs(), lookahead=barmerge.lookahead_on)
[u2_s0, u2_s1, u2_s2, u2_s3, u2_s4, u2_s5, u2_s6] = request.security(u2, "D", f_get_7d_sigs(), lookahead=barmerge.lookahead_on)
[u3_s0, u3_s1, u3_s2, u3_s3, u3_s4, u3_s5, u3_s6] = request.security(u3, "D", f_get_7d_sigs(), lookahead=barmerge.lookahead_on)
[u4_s0, u4_s1, u4_s2, u4_s3, u4_s4, u4_s5, u4_s6] = request.security(u4, "D", f_get_7d_sigs(), lookahead=barmerge.lookahead_on)

[u1_d0, u1_d1, u1_d2, u1_d3, u1_d4, u1_d5, u1_d6] = request.security(u1, "D", f_get_7d_dt(), lookahead=barmerge.lookahead_on)
[u2_d0, u2_d1, u2_d2, u2_d3, u2_d4, u2_d5, u2_d6] = request.security(u2, "D", f_get_7d_dt(), lookahead=barmerge.lookahead_on)
[u3_d0, u3_d1, u3_d2, u3_d3, u3_d4, u3_d5, u3_d6] = request.security(u3, "D", f_get_7d_dt(), lookahead=barmerge.lookahead_on)
[u4_d0, u4_d1, u4_d2, u4_d3, u4_d4, u4_d5, u4_d6] = request.security(u4, "D", f_get_7d_dt(), lookahead=barmerge.lookahead_on)

// 7-Day Matrix Arrays (Column 0 = Today, Column 1 = 1d, ... Column 6 = 6d)
var bullMissile = matrix.new<string>(7, 0, "")
var bearMissile = matrix.new<string>(7, 0, "")
var bullScalp   = matrix.new<string>(7, 0, "")
var bearScalp   = matrix.new<string>(7, 0, "")
var bullLight   = matrix.new<string>(7, 0, "")
var bearLight   = matrix.new<string>(7, 0, "")
var bullWick    = matrix.new<string>(7, 0, "")
var bearWick    = matrix.new<string>(7, 0, "")
var bullExt     = matrix.new<string>(7, 0, "")
var bearExt     = matrix.new<string>(7, 0, "")
var bullOut     = matrix.new<string>(7, 0, "")
var bearOut     = matrix.new<string>(7, 0, "")
var bullDoji    = matrix.new<string>(7, 0, "")
var bearDoji    = matrix.new<string>(7, 0, "")
var bullDiv     = matrix.new<string>(7, 0, "")
var bearDiv     = matrix.new<string>(7, 0, "")
var bullHDiv    = matrix.new<string>(7, 0, "")
var bearHDiv    = matrix.new<string>(7, 0, "")

var bullAcc     = matrix.new<string>(7, 0, "")
var bearAcc     = matrix.new<string>(7, 0, "")
var bullRej     = matrix.new<string>(7, 0, "")
var bearRej     = matrix.new<string>(7, 0, "")
var bullSrd     = matrix.new<string>(7, 0, "")
var bearSrd     = matrix.new<string>(7, 0, "")
var bullOd      = matrix.new<string>(7, 0, "")
var bearOd      = matrix.new<string>(7, 0, "")
var bullFade    = matrix.new<string>(7, 0, "")
var bearFade    = matrix.new<string>(7, 0, "")
var bullAbs     = matrix.new<string>(7, 0, "")
var bearAbs     = matrix.new<string>(7, 0, "")
var bullFnl     = matrix.new<string>(7, 0, "")
var bearFnh     = matrix.new<string>(7, 0, "")
var bullFb      = matrix.new<string>(7, 0, "")
var bearFb      = matrix.new<string>(7, 0, "")
var bullCont    = matrix.new<string>(7, 0, "")
var bearCont    = matrix.new<string>(7, 0, "")

// Trade Sequence active-state matrices (multi-day)
var bullRejActiveM     = matrix.new<string>(7, 0, "")
var bearRejActiveM     = matrix.new<string>(7, 0, "")
var bullSrdActiveM     = matrix.new<string>(7, 0, "")
var bearSrdActiveM     = matrix.new<string>(7, 0, "")
var bullFailAbsActiveM = matrix.new<string>(7, 0, "")
var bearFailAbsActiveM = matrix.new<string>(7, 0, "")
var bullAccActiveM     = matrix.new<string>(7, 0, "")
var bearAccActiveM     = matrix.new<string>(7, 0, "")

f_get_pos(posStr) =>
    switch posStr
        "Bottom Right"  => position.bottom_right
        "Bottom Center" => position.bottom_center
        "Bottom Left"   => position.bottom_left
        "Top Right"     => position.top_right
        "Top Center"    => position.top_center
        "Top Left"      => position.top_left
        "Middle Left"   => position.middle_left
        => position.middle_right

tablePos = f_get_pos(tablePosStr)

f_simplifySym(sym) =>
    parts = str.split(sym, ":")
    base  = array.size(parts) > 1 ? array.get(parts, array.size(parts) - 1) : array.get(parts, 0)
    base := str.replace(base, "1!", "")
    base

f_mat_push(m, dayIdx, val) =>
    currentVal = matrix.get(m, dayIdx, 0)
    newVal = currentVal == "" ? val : currentVal + "\n" + val
    matrix.set(m, dayIdx, 0, newVal)

f_add_day(sym, dayIdx, sigPack, dtPack) =>
    cleanSym = f_simplifySym(sym)
    if unpackBit(sigPack, 1)
        f_mat_push(bullMissile, dayIdx, cleanSym)
    if unpackBit(sigPack, 2)
        f_mat_push(bearMissile, dayIdx, cleanSym)
    if unpackBit(sigPack, 4)
        f_mat_push(bullScalp, dayIdx, cleanSym)
    if unpackBit(sigPack, 8)
        f_mat_push(bearScalp, dayIdx, cleanSym)
    if unpackBit(sigPack, 16)
        f_mat_push(bullLight, dayIdx, cleanSym)
    if unpackBit(sigPack, 32)
        f_mat_push(bearLight, dayIdx, cleanSym)
    if unpackBit(sigPack, 64)
        f_mat_push(bullWick, dayIdx, cleanSym)
    if unpackBit(sigPack, 128)
        f_mat_push(bearWick, dayIdx, cleanSym)
    if unpackBit(sigPack, 256)
        f_mat_push(bullExt, dayIdx, cleanSym)
    if unpackBit(sigPack, 512)
        f_mat_push(bearExt, dayIdx, cleanSym)
    if unpackBit(sigPack, 1024)
        f_mat_push(bullOut, dayIdx, cleanSym)
    if unpackBit(sigPack, 2048)
        f_mat_push(bearOut, dayIdx, cleanSym)
    if unpackBit(sigPack, 4096)
        f_mat_push(bullDoji, dayIdx, cleanSym)
    if unpackBit(sigPack, 8192)
        f_mat_push(bearDoji, dayIdx, cleanSym)
    if unpackBit(sigPack, 16384)
        f_mat_push(bullDiv, dayIdx, cleanSym)
    if unpackBit(sigPack, 32768)
        f_mat_push(bearDiv, dayIdx, cleanSym)
    if unpackBit(sigPack, 65536)
        f_mat_push(bullHDiv, dayIdx, cleanSym)
    if unpackBit(sigPack, 131072)
        f_mat_push(bearHDiv, dayIdx, cleanSym)

    if unpackBit(dtPack, 1)
        f_mat_push(bullAcc, dayIdx, cleanSym)
    if unpackBit(dtPack, 2)
        f_mat_push(bearAcc, dayIdx, cleanSym)
    if unpackBit(dtPack, 4)
        f_mat_push(bullRej, dayIdx, cleanSym)
    if unpackBit(dtPack, 8)
        f_mat_push(bearRej, dayIdx, cleanSym)
    if unpackBit(dtPack, 16)
        f_mat_push(bullSrd, dayIdx, cleanSym)
    if unpackBit(dtPack, 32)
        f_mat_push(bearSrd, dayIdx, cleanSym)
    if unpackBit(dtPack, 64)
        f_mat_push(bullOd, dayIdx, cleanSym)
    if unpackBit(dtPack, 128)
        f_mat_push(bearOd, dayIdx, cleanSym)
    if unpackBit(dtPack, 256)
        f_mat_push(bullFade, dayIdx, cleanSym)
    if unpackBit(dtPack, 512)
        f_mat_push(bearFade, dayIdx, cleanSym)
    if unpackBit(dtPack, 1024)
        f_mat_push(bullAbs, dayIdx, cleanSym)
    if unpackBit(dtPack, 2048)
        f_mat_push(bearAbs, dayIdx, cleanSym)
    if unpackBit(dtPack, 4096)
        f_mat_push(bullFnl, dayIdx, cleanSym)
    if unpackBit(dtPack, 8192)
        f_mat_push(bearFnh, dayIdx, cleanSym)
    if unpackBit(dtPack, 16384) or unpackBit(dtPack, 65536)
        f_mat_push(bullFb, dayIdx, cleanSym)
    if unpackBit(dtPack, 32768) or unpackBit(dtPack, 131072)
        f_mat_push(bearFb, dayIdx, cleanSym)
    if unpackBit(dtPack, 262144)
        f_mat_push(bullCont, dayIdx, cleanSym)
    if unpackBit(dtPack, 524288)
        f_mat_push(bearCont, dayIdx, cleanSym)
    if unpackBit(dtPack, 1048576)
        f_mat_push(bullRejActiveM, dayIdx, cleanSym)
    if unpackBit(dtPack, 2097152)
        f_mat_push(bearRejActiveM, dayIdx, cleanSym)
    if unpackBit(dtPack, 4194304)
        f_mat_push(bullSrdActiveM, dayIdx, cleanSym)
    if unpackBit(dtPack, 8388608)
        f_mat_push(bearSrdActiveM, dayIdx, cleanSym)
    if unpackBit(dtPack, 16777216)
        f_mat_push(bullFailAbsActiveM, dayIdx, cleanSym)
    if unpackBit(dtPack, 33554432)
        f_mat_push(bearFailAbsActiveM, dayIdx, cleanSym)
    if unpackBit(dtPack, 67108864)
        f_mat_push(bullAccActiveM, dayIdx, cleanSym)
    if unpackBit(dtPack, 134217728)
        f_mat_push(bearAccActiveM, dayIdx, cleanSym)

f_add_sym_all(sym, s0, s1, s2, s3, s4, s5, s6, d0, d1, d2, d3, d4, d5, d6) =>
    if sym != ""
        for i = 0 to lookback_days - 1
            sigPack = i == 0 ? s0 : i == 1 ? s1 : i == 2 ? s2 : i == 3 ? s3 : i == 4 ? s4 : i == 5 ? s5 : s6
            dtPack  = i == 0 ? d0 : i == 1 ? d1 : i == 2 ? d2 : i == 3 ? d3 : i == 4 ? d4 : i == 5 ? d5 : d6
            f_add_day(sym, i, sigPack, dtPack)

// ---- THEME COLOR DEFINITIONS -------------------------------------------
isOriginal = tableTheme == "Original TLCS"
isDark     = tableTheme == "Dark Theme"

c_frame     = isOriginal ? color.rgb(12, 246, 250) : isDark ? color.rgb(51, 65, 85) : color.rgb(203, 213, 225)
c_border    = isOriginal ? color.rgb(12, 246, 250) : isDark ? color.rgb(51, 65, 85) : color.rgb(226, 232, 240)

c_header_bg = isOriginal ? color.new(#116ac2, 0) : isDark ? color.rgb(15, 23, 42) : color.rgb(30, 58, 138)
c_header_fg = isOriginal ? color.rgb(12, 246, 250) : isDark ? color.rgb(56, 189, 248) : color.white

c_colhdr_bg = isOriginal ? color.rgb(17, 106, 194) : isDark ? color.rgb(30, 41, 59) : color.rgb(241, 245, 249)
c_colhdr_fg = isOriginal ? color.white : isDark ? color.white : color.rgb(15, 23, 42)

c_label_bg  = isOriginal ? color.rgb(249, 226, 23, 87) : isDark ? color.rgb(30, 41, 59) : color.rgb(248, 250, 252)
c_label_fg  = isOriginal ? color.rgb(10, 65, 230) : isDark ? color.rgb(226, 232, 240) : color.rgb(15, 23, 42)

c_bull_bg   = isOriginal ? color.new(color.lime, 80) : isDark ? color.rgb(6, 78, 59, 40) : color.rgb(220, 252, 231)
c_bull_fg   = isOriginal ? color.green : isDark ? color.rgb(74, 222, 128) : color.rgb(22, 101, 52)

c_bear_bg   = isOriginal ? color.new(color.red, 80) : isDark ? color.rgb(127, 29, 29, 40) : color.rgb(254, 226, 226)
c_bear_fg   = isOriginal ? color.red : isDark ? color.rgb(248, 113, 113) : color.rgb(153, 27, 27)

c_mixed_bg  = isOriginal ? color.new(color.orange, 80) : isDark ? color.rgb(120, 53, 15, 40) : color.rgb(254, 243, 199)
c_mixed_fg  = isOriginal ? color.orange : isDark ? color.rgb(251, 191, 36) : color.rgb(180, 83, 9)

c_empty_bg  = isOriginal ? color.new(color.gray, 85) : isDark ? color.rgb(15, 23, 42, 60) : color.rgb(255, 255, 255)
c_empty_fg  = isOriginal ? color.gray : isDark ? color.rgb(100, 116, 139) : color.rgb(203, 213, 225)

f_render_matrix_row(t, r, labelText, bullMat, bearMat, tSize) =>
    hasAny = false
    for d = 0 to lookback_days - 1
        if matrix.get(bullMat, d, 0) != "" or matrix.get(bearMat, d, 0) != ""
            hasAny := true

    if hasAny or showAllRows
        table.cell(t, 0, r, labelText, bgcolor=c_label_bg, text_color=c_label_fg, text_size=tSize, text_halign=text.align_right)
        for colIdx = 1 to lookback_days
            d = lookback_days - colIdx
            bTxt = matrix.get(bullMat, d, 0)
            brTxt = matrix.get(bearMat, d, 0)
            
            cellTxt = ""
            if bTxt != "" and brTxt != ""
                cellTxt := "▲ " + bTxt + "\n▼ " + brTxt
            else if bTxt != ""
                cellTxt := "▲ " + bTxt
            else if brTxt != ""
                cellTxt := "▼ " + brTxt
            else
                cellTxt := "-"

            cellBg = (bTxt != "" and brTxt != "") ? c_mixed_bg : bTxt != "" ? c_bull_bg : brTxt != "" ? c_bear_bg : c_empty_bg
            cellFg = (bTxt != "" and brTxt != "") ? c_mixed_fg : bTxt != "" ? c_bull_fg : brTxt != "" ? c_bear_fg : c_empty_fg

            table.cell(t, colIdx, r, cellTxt, bgcolor=cellBg, text_color=cellFg, text_size=tSize, text_halign=text.align_center)
        true
    else
        false

var table dash1 = na
if barstate.islast
    bullMissile := matrix.new<string>(7, 1, "")
    bearMissile := matrix.new<string>(7, 1, "")
    bullScalp   := matrix.new<string>(7, 1, "")
    bearScalp   := matrix.new<string>(7, 1, "")
    bullLight   := matrix.new<string>(7, 1, "")
    bearLight   := matrix.new<string>(7, 1, "")
    bullWick    := matrix.new<string>(7, 1, "")
    bearWick    := matrix.new<string>(7, 1, "")
    bullExt     := matrix.new<string>(7, 1, "")
    bearExt     := matrix.new<string>(7, 1, "")
    bullOut     := matrix.new<string>(7, 1, "")
    bearOut     := matrix.new<string>(7, 1, "")
    bullDoji    := matrix.new<string>(7, 1, "")
    bearDoji    := matrix.new<string>(7, 1, "")
    bullDiv     := matrix.new<string>(7, 1, "")
    bearDiv     := matrix.new<string>(7, 1, "")
    bullHDiv    := matrix.new<string>(7, 1, "")
    bearHDiv    := matrix.new<string>(7, 1, "")

    bullAcc     := matrix.new<string>(7, 1, "")
    bearAcc     := matrix.new<string>(7, 1, "")
    bullRej     := matrix.new<string>(7, 1, "")
    bearRej     := matrix.new<string>(7, 1, "")
    bullSrd     := matrix.new<string>(7, 1, "")
    bearSrd     := matrix.new<string>(7, 1, "")
    bullOd      := matrix.new<string>(7, 1, "")
    bearOd      := matrix.new<string>(7, 1, "")
    bullFade    := matrix.new<string>(7, 1, "")
    bearFade    := matrix.new<string>(7, 1, "")
    bullAbs     := matrix.new<string>(7, 1, "")
    bearAbs     := matrix.new<string>(7, 1, "")
    bullFnl     := matrix.new<string>(7, 1, "")
    bearFnh     := matrix.new<string>(7, 1, "")
    bullFb      := matrix.new<string>(7, 1, "")
    bearFb      := matrix.new<string>(7, 1, "")
    bullCont    := matrix.new<string>(7, 1, "")
    bearCont    := matrix.new<string>(7, 1, "")
    bullRejActiveM     := matrix.new<string>(7, 1, "")
    bearRejActiveM     := matrix.new<string>(7, 1, "")
    bullSrdActiveM     := matrix.new<string>(7, 1, "")
    bearSrdActiveM     := matrix.new<string>(7, 1, "")
    bullFailAbsActiveM := matrix.new<string>(7, 1, "")
    bearFailAbsActiveM := matrix.new<string>(7, 1, "")
    bullAccActiveM     := matrix.new<string>(7, 1, "")
    bearAccActiveM     := matrix.new<string>(7, 1, "")

    f_add_sym_all(u1, u1_s0, u1_s1, u1_s2, u1_s3, u1_s4, u1_s5, u1_s6, u1_d0, u1_d1, u1_d2, u1_d3, u1_d4, u1_d5, u1_d6)
    f_add_sym_all(u2, u2_s0, u2_s1, u2_s2, u2_s3, u2_s4, u2_s5, u2_s6, u2_d0, u2_d1, u2_d2, u2_d3, u2_d4, u2_d5, u2_d6)
    f_add_sym_all(u3, u3_s0, u3_s1, u3_s2, u3_s3, u3_s4, u3_s5, u3_s6, u3_d0, u3_d1, u3_d2, u3_d3, u3_d4, u3_d5, u3_d6)
    f_add_sym_all(u4, u4_s0, u4_s1, u4_s2, u4_s3, u4_s4, u4_s5, u4_s6, u4_d0, u4_d1, u4_d2, u4_d3, u4_d4, u4_d5, u4_d6)

    txtSize = tableTextSz == "Tiny" ? size.tiny : tableTextSz == "Normal" ? size.normal : size.small

    dash1 := table.new(tablePos, lookback_days + 1, 26, border_width=1, frame_width=1, frame_color=c_frame, border_color=c_border)
    
    int currentRow = 0

    // Header 1: SIGNALS
    table.merge_cells(dash1, 0, currentRow, lookback_days, currentRow)
    table.cell(dash1, 0, currentRow, "TLCS SIGNALS", bgcolor=c_header_bg, text_color=c_header_fg, text_size=txtSize, text_halign=text.align_center)
    currentRow += 1

    table.cell(dash1, 0, currentRow, "FILTER TYPE", bgcolor=c_colhdr_bg, text_color=c_colhdr_fg, text_size=txtSize, text_halign=text.align_right)
    for colIdx = 1 to lookback_days
        dayOffset = lookback_days - colIdx
        colName = dayOffset == 0 ? "1" : str.tostring(dayOffset + 1)
        table.cell(dash1, colIdx, currentRow, colName, bgcolor=c_colhdr_bg, text_color=c_colhdr_fg, text_size=txtSize, text_halign=text.align_center)
    currentRow += 1

    if f_render_matrix_row(dash1, currentRow, "Missile", bullMissile, bearMissile, txtSize)
        currentRow += 1
    if f_render_matrix_row(dash1, currentRow, "Wick Reversal", bullWick, bearWick, txtSize)
        currentRow += 1
    if f_render_matrix_row(dash1, currentRow, "Extreme Reversal", bullExt, bearExt, txtSize)
        currentRow += 1
    if f_render_matrix_row(dash1, currentRow, "Outside Reversal", bullOut, bearOut, txtSize)
        currentRow += 1
    if f_render_matrix_row(dash1, currentRow, "Doji Reversal", bullDoji, bearDoji, txtSize)
        currentRow += 1
    if f_render_matrix_row(dash1, currentRow, "Price Divergences", bullDiv, bearDiv, txtSize)
        currentRow += 1
    if f_render_matrix_row(dash1, currentRow, "Hidden Divergences", bullHDiv, bearHDiv, txtSize)
        currentRow += 1

    // Header 2: BLUEPRINTS
    table.merge_cells(dash1, 0, currentRow, lookback_days, currentRow)
    table.cell(dash1, 0, currentRow, "DAY TYPE BLUEPRINTS", bgcolor=c_header_bg, text_color=c_header_fg, text_size=txtSize, text_halign=text.align_center)
    currentRow += 1

    if f_render_matrix_row(dash1, currentRow, "Rejection Day Blueprint", bullRej, bearRej, txtSize)
        currentRow += 1
    if f_render_matrix_row(dash1, currentRow, "Absorption Day Blueprint", bullAbs, bearAbs, txtSize)
        currentRow += 1
    if f_render_matrix_row(dash1, currentRow, "Failed New Low Blueprint", bullFnl, matrix.new<string>(7, 1, ""), txtSize)
        currentRow += 1
    if f_render_matrix_row(dash1, currentRow, "Failed New High Blueprint", matrix.new<string>(7, 1, ""), bearFnh, txtSize)
        currentRow += 1
    if f_render_matrix_row(dash1, currentRow, "Outside Day Blueprint", bullOd, bearOd, txtSize)
        currentRow += 1
    if f_render_matrix_row(dash1, currentRow, "Stop Run Day Blueprint", bullSrd, bearSrd, txtSize)
        currentRow += 1

    // Header 3: SEQUENCES
    table.merge_cells(dash1, 0, currentRow, lookback_days, currentRow)
    table.cell(dash1, 0, currentRow, "TRADE SEQUENCES", bgcolor=c_header_bg, text_color=c_header_fg, text_size=txtSize, text_halign=text.align_center)
    currentRow += 1

    if f_render_matrix_row(dash1, currentRow, "Rejection Day Sequence", bullRejActiveM, bearRejActiveM, txtSize)
        currentRow += 1
    if f_render_matrix_row(dash1, currentRow, "Stop Run Sequence", bullSrdActiveM, bearSrdActiveM, txtSize)
        currentRow += 1
    if f_render_matrix_row(dash1, currentRow, "Failed Absorption Sequence", bullFailAbsActiveM, bearFailAbsActiveM, txtSize)
        currentRow += 1
    if f_render_matrix_row(dash1, currentRow, "Accumulation / Distribution Sequence", bullAccActiveM, bearAccActiveM, txtSize)
        currentRow += 1

    // Universal 7-Day Session Matrix Alert Engine (Strict Daily Candle Close)
    bool isDailyClose = false
    if timeframe.isdaily
        isDailyClose := barstate.isconfirmed
    else if timeframe.isintraday
        isDailyClose := (session.islastbar_regular and barstate.isconfirmed) or (ta.change(time("D")) != 0 and barstate.isconfirmed)
    else
        isDailyClose := barstate.isconfirmed

    if (isDailyClose or barstate.islast) and enable_alerts
        string daysJson = "["
        for col = 0 to 6
            bM = str.replace_all(matrix.get(bullMissile, col, 0), "\n", ",")
            sM = str.replace_all(matrix.get(bearMissile, col, 0), "\n", ",")
            bSc = str.replace_all(matrix.get(bullScalp, col, 0), "\n", ",")
            sSc = str.replace_all(matrix.get(bearScalp, col, 0), "\n", ",")
            bL = str.replace_all(matrix.get(bullLight, col, 0), "\n", ",")
            sL = str.replace_all(matrix.get(bearLight, col, 0), "\n", ",")
            bD = str.replace_all(matrix.get(bullDiv, col, 0), "\n", ",")
            sD = str.replace_all(matrix.get(bearDiv, col, 0), "\n", ",")
            bR = str.replace_all(matrix.get(bullRej, col, 0), "\n", ",")
            sR = str.replace_all(matrix.get(bearRej, col, 0), "\n", ",")
            bAb = str.replace_all(matrix.get(bullAbs, col, 0), "\n", ",")
            sAb = str.replace_all(matrix.get(bearAbs, col, 0), "\n", ",")
            bFn = str.replace_all(matrix.get(bullFnl, col, 0), "\n", ",")
            sFn = str.replace_all(matrix.get(bearFnh, col, 0), "\n", ",")
            bOd = str.replace_all(matrix.get(bullOd, col, 0), "\n", ",")
            sOd = str.replace_all(matrix.get(bearOd, col, 0), "\n", ",")
            bSr = str.replace_all(matrix.get(bullSrdActiveM, col, 0), "\n", ",")
            sSr = str.replace_all(matrix.get(bearSrdActiveM, col, 0), "\n", ",")
            bFb = str.replace_all(matrix.get(bullFailAbsActiveM, col, 0), "\n", ",")
            sFb = str.replace_all(matrix.get(bearFailAbsActiveM, col, 0), "\n", ",")
            bAc = str.replace_all(matrix.get(bullAccActiveM, col, 0), "\n", ",")
            sAc = str.replace_all(matrix.get(bearAccActiveM, col, 0), "\n", ",")

            daysJson += '{"col":' + str.tostring(col) + ',"bM":"' + bM + '","sM":"' + sM + '","bSc":"' + bSc + '","sSc":"' + sSc + '","bL":"' + bL + '","sL":"' + sL + '","bD":"' + bD + '","sD":"' + sD + '","bR":"' + bR + '","sR":"' + sR + '","bAb":"' + bAb + '","sAb":"' + sAb + '","bFn":"' + bFn + '","sFn":"' + sFn + '","bOd":"' + bOd + '","sOd":"' + sOd + '","bSr":"' + bSr + '","sSr":"' + sSr + '","bFb":"' + bFb + '","sFb":"' + sFb + '","bAc":"' + bAc + '","sAc":"' + sAc + '"}' + (col < 6 ? ',' : '')
        daysJson += "]"

        string alertPayload = '{"ticker":"' + syminfo.ticker + '","trigger":"SessionOpenMatrix","secret":"' + webhook_secret + '","matrix_days":' + daysJson + ',"signals":{"bullMissile":"' + matrix.get(bullMissile, 0, 0) + '","bearMissile":"' + matrix.get(bearMissile, 0, 0) + '","bullDiv":"' + matrix.get(bullDiv, 0, 0) + '","bearDiv":"' + matrix.get(bearDiv, 0, 0) + '","bullRej":"' + matrix.get(bullRejActiveM, 0, 0) + '","bearRej":"' + matrix.get(bearRejActiveM, 0, 0) + '","bullAbs":"' + matrix.get(bullAbs, 0, 0) + '","bearAbs":"' + matrix.get(bearAbs, 0, 0) + '","bullFnl":"' + matrix.get(bullFnl, 0, 0) + '","bearFnh":"' + matrix.get(bearFnh, 0, 0) + '","bullOd":"' + matrix.get(bullOd, 0, 0) + '","bearOd":"' + matrix.get(bearOd, 0, 0) + '","bullSrd":"' + matrix.get(bullSrdActiveM, 0, 0) + '","bearSrd":"' + matrix.get(bearSrdActiveM, 0, 0) + '","bullFb":"' + matrix.get(bullFailAbsActiveM, 0, 0) + '","bearFb":"' + matrix.get(bearFailAbsActiveM, 0, 0) + '","bullAcc":"' + matrix.get(bullAccActiveM, 0, 0) + '","bearAcc":"' + matrix.get(bearAccActiveM, 0, 0) + '"},"timestamp":"' + str.tostring(time) + '"}'

        alert(alertPayload, alert.freq_once_per_bar_close)
